/* Pending take fixture: what the engine would report while recording. */
static int take_n, take_track;
static uint8_t take_p[8], take_s[8], take_v[8];
int seq_engine_record_preview(int track,uint8_t *pitch,uint8_t *step,uint8_t *velocity,int max) {
    if(!ui_recording || track!=take_track) return 0;
    int n=take_n<max?take_n:max;
    for(int i=0;i<n;i++) {pitch[i]=take_p[i];step[i]=take_s[i];velocity[i]=take_v[i];}
    return n;
}
// DRUM lane fixture: [step][slot]
static struct track_event lane_ev[64][SEQ_TRACK_POLY];
int song_get_step_event(int scene,int track,int step,int slot,struct track_event *e) {
    *e=lane_ev[step][slot];return e->type ? 0 : -1;
}
int song_get_ratchet_mode(int scene,int track,int step) {return 1;}
void gfx_fill_rect(int x,int y,int w,int h,uint32_t color) {
    assert(x>=0 && y>=0 && w>0 && h>0);
    if(gstate.clock_help==GUI_OVERVIEW_LANES || gstate.clock_help==GUI_OVERVIEW_TRACKER ||
            gstate.clock_help==GUI_OVERVIEW_SONG || (gstate.lane_edit && !gstate.clock_help)) {
        assert(x>=gstate.GUI_GRID_X && x+w<=gstate.GUI_GRID_X+gstate.GUI_GRID_W);
        assert(y>=gstate.GUI_GRID_Y && y+h<=gstate.GUI_GRID_Y+gstate.GUI_GRID_H);
        lane_fills++;
    }
}
void gfx_draw_string(struct gfx_label *label) {
    assert(label->x>=gstate.GUI_GRID_X && label->y>=gstate.GUI_GRID_Y);
    assert(label->x+label->w<=gstate.GUI_GRID_X+gstate.GUI_GRID_W);
    assert(label->y+label->h<=gstate.GUI_GRID_Y+gstate.GUI_GRID_H);
    assert(strlen(label->text)<=29);
    assert(label->text[0]!='=');
    assert(!strstr(label->text,"Start:row Length:value"));
    if(gstate.clock_help==GUI_OVERVIEW_LANES || gstate.clock_help==GUI_OVERVIEW_TRACKER ||
            gstate.clock_help==GUI_OVERVIEW_SONG || (gstate.lane_edit && !gstate.clock_help)) {help_draws++;return;}
    assert(label->fg_color==(gui_overview_read_only()?GUI_FONT_COLOR_GREY:GUI_FONT_COLOR_NORMAL));
    if(!gui_overview_read_only()) {
        assert(label->h==10 && (label->y-gstate.GUI_GRID_Y)%13==0);
        int row=(label->y-gstate.GUI_GRID_Y)/13;
        if(row==0 || row==14) assert(!label->text[0]);
        assert(row<18);
    }
    if(label->text[0]=='>') {
        int action=gstate.clock_help==PANEL_MENU_CLOCK &&
            (gstate.clock_help_selected==PANEL_MENU_CLOCK_CAPTURE || gstate.clock_help_selected==PANEL_MENU_CLOCK_RECALL);
        action |= gstate.clock_help==PANEL_MENU_SYS && gstate.clock_help_selected==PANEL_MENU_SYS_VERSION;
        assert(label->highlight[15]==(action?GFX_HIGHLIGHT_NORMAL:GFX_HIGHLIGHT_INVERT));
    }
    if(gui_overview_read_only()) {
        assert(label->highlight[15]==GFX_HIGHLIGHT_NORMAL);
        assert(label->highlight[0]==(label->text[0]=='*'?GFX_HIGHLIGHT_INVERT:GFX_HIGHLIGHT_NORMAL));
    }
    help_draws++;
}
int seq_engine_get_current_scene(void) {return ui_scene;}
static int clock_override=-1;
int seq_engine_get_internal_cc(int track,int cc,int fallback) {return clock_override>=0?clock_override:fallback;}
static void test_clock_help(void) {
    for(int lcd=0;lcd<2;lcd++) {
        gstate.GUI_GRID_X=lcd?25:40;gstate.GUI_GRID_Y=lcd?80:90;
        gstate.GUI_GRID_W=gstate.GUI_GRID_H=238;
        gui_clock_help_set(1);assert(gui_clock_help_active());
        for(int item=0;item<PANEL_MENU_CLOCK_NUM_SUBMODES;item++) {
            gstate.clock_help_selected=item;
            struct clock_menu_row entry;panel_menu_clock_row(item,&entry);
            assert(*entry.name && strlen(entry.value)<=13);
            for(int line=0;line<2;line++) assert(strlen(panel_menu_clock_help(item,line))<=29);
            pmstate.menu_submode=item;panel_menu_display_clock();
            assert(!strncmp(gstate.status_lines[3]+14,entry.value,strlen(entry.value)));
            gui_draw_clock_help();int before=help_draws;
            assert(!gui_draw_clock_help() && help_draws==before);
        }
        gui_clock_help_scroll(999);assert(gstate.clock_help_selected==20);
        gui_clock_help_scroll(-999);assert(!gstate.clock_help_selected);
        timing_wait=1;timing_choice=4;clock_override=1;
        assert(gui_draw_clock_help());assert(strstr(gstate.clock_help_rows[2],">bar*"));
        timing_wait=0;assert(gui_draw_clock_help());assert(strstr(gstate.clock_help_rows[2],"CCi"));
        assert(!strncmp(gstate.clock_help_rows[17],"Edit:",5));
        clock_override=-1;gui_draw_clock_help();
        assert(!gstate.clock_help_rows[14][0]);
        assert(!strcmp(gstate.clock_help_rows[15],panel_menu_overview_help(PANEL_MENU_CLOCK,0,0)));
        assert(!gstate.clock_help_rows[17][0]);
        assert(!gstate.clock_help_rows[17][0]);
        clock_override=-1;
        gstate.clock_help_selected=PANEL_MENU_CLOCK_CAPTURE;
        for(snapshot_status=0;snapshot_status<3;snapshot_status++) {
            gui_draw_clock_help();
            assert(strstr(gstate.clock_help_rows[13],snapshot_status?"Ready":"Empty"));
        }
        snapshot_status=0;
        gstate.grid_overlay_enable=1;gstate.grid_overlay[7]=1234;
        gui_clock_help_set(0);assert(!gui_clock_help_active());
        assert(gui_clock_help_restore());assert(!gui_clock_help_restore());
        assert(gstate.grid_overlay_enable && gstate.grid_overlay[7]==1234);
        for(int i=0;i<64;i++) assert(!gstate.grid_state[i]);
    }
}
static void test_overview_editors(void) {
    const int modes[]={PANEL_MENU_CLOCK,PANEL_MENU_ARP,PANEL_MENU_MIDI,PANEL_MENU_TONALITY,PANEL_MENU_SYS};
    for(int lcd=0;lcd<2;lcd++) for(unsigned m=0;m<5;m++) {
        gstate.GUI_GRID_X=lcd?25:40;gstate.GUI_GRID_Y=lcd?80:90;
        gui_overview_open(modes[m]);assert(gui_overview_mode()==modes[m]);
        for(int item=0;item<panel_menu_overview_count(modes[m]);item++) {
            gstate.clock_help_selected=item;
            gui_draw_clock_help();
            int top=item<12?0:item-11;
            assert(!gstate.clock_help_rows[0][0]);
            assert(gstate.clock_help_rows[1][0]);
            for(int r=2;r<=13;r++) {
                if(top+r-2<panel_menu_overview_count(modes[m])) {
                    assert(gstate.clock_help_rows[r][0]==(top+r-2==item?'>':' '));
                    assert(gstate.clock_help_rows[r][1]);
                } else assert(!gstate.clock_help_rows[r][0]);
            }
            assert(!gstate.clock_help_rows[14][0]);
            assert(!strcmp(gstate.clock_help_rows[15],panel_menu_overview_help(modes[m],item,0)));
            assert(!strcmp(gstate.clock_help_rows[16],panel_menu_overview_help(modes[m],item,1)));
            struct clock_menu_row row;panel_menu_overview_row(modes[m],item,&row);
            assert(*row.name);
            for(int line=0;line<2;line++) assert(strlen(panel_menu_overview_help(modes[m],item,line))<=29);
            gui_draw_clock_help();int before=help_draws;
            assert(!gui_draw_clock_help() && help_draws==before);
            pmstate.menu_mode=PANEL_MENU_NONE;pmstate.menu_submode=2;
            pmstate.menu_timeout_count=1234;
            gui_overview_edit(1);
            assert(pmstate.menu_mode==PANEL_MENU_NONE && pmstate.menu_submode==2);
            assert(pmstate.menu_timeout_count==1234);
        }
        gui_clock_help_scroll(999);assert(gstate.clock_help_selected==panel_menu_overview_count(modes[m])-1);
        gui_clock_help_scroll(-999);assert(!gstate.clock_help_selected);
        gui_clock_help_set(0);gui_clock_help_restore();
    }
    edit_calls=0;panel_menu_overview_edit(PANEL_MENU_ARP,1,-2);
    assert(edit_calls==1 && edit_kind==7 && edit_change==-2);
    panel_menu_overview_edit(PANEL_MENU_MIDI,21,3);
    assert(edit_kind==17 && edit_item==11 && edit_change==3);
    panel_menu_overview_edit(PANEL_MENU_MIDI,2,1);assert(edit_kind==16 && edit_item==0);
    panel_menu_overview_edit(PANEL_MENU_CLOCK,0,1);assert(edit_kind==1);
    panel_menu_overview_edit(PANEL_MENU_CLOCK,14,1);
    assert(ui_humanize[0].value[0] && ui_humanize[2].value[0] && !ui_humanize[1].value[0]);
    memset(ui_humanize,0,sizeof(ui_humanize));ui_songroot=-1;ui_swing=50;
    for(int i=0;i<6;i++) roots[i]=-2;
}
static void test_track_overview(void) {
    for(int lcd=0;lcd<2;lcd++) {
        gstate.GUI_GRID_X=lcd?25:40;gstate.GUI_GRID_Y=lcd?80:90;
        gstate.GUI_GRID_W=240;gstate.GUI_GRID_H=238;
        gstate.clock_help_drawn=0;
        for(int track=0;track<6;track++) {
            scene_values_ui=1;
            track_type_ui=track&1;bias_ui=track;ui_scene=track;
            gui_track_overview_open(track);
            /* DRUM opens on lanes, VOICE on the tracker; past page 4 is Settings. */
            assert(gui_overview_mode()==(track&1?GUI_OVERVIEW_LANES:GUI_OVERVIEW_TRACKER));
            gui_overview_page(9);
            assert(gui_clock_help_active() && gui_overview_mode()==GUI_OVERVIEW_TRACK);
            assert(gstate.overview_track==track);
            int edits=edit_calls;unsigned cursor=gstate.clock_help_selected;
            gui_overview_edit(100);gui_clock_help_scroll(100);
            assert(edits==edit_calls && gstate.clock_help_selected==cursor);
            assert(gui_draw_clock_help());int draws=help_draws;
            assert(!gui_draw_clock_help() && draws==help_draws);
            for(int scene=0;scene<6;scene++) {
                char range[16],rate[16];
                snprintf(range,sizeof(range),"%02d-%02d",scene*8+track+1,scene*8+track+scene+track+1);
                panel_utils_step_len_to_str(rate,scene+track);
                assert(strstr(gstate.clock_help_rows[2+2*scene],range));
                assert(strstr(gstate.clock_help_rows[2+2*scene],rate));
                assert(gstate.clock_help_rows[2+2*scene][1]=='1'+scene);
                assert(gstate.clock_help_rows[2+2*scene][0]==(scene==track?'*':' '));
                assert(strstr(gstate.clock_help_rows[2+2*scene],scene&1?"On":"Off"));
            }
        }
        scene_values_ui=0;
        char text[30],expected[32];
        for(int start=0;start<64;start++) for(int len=1;len<=64;len++) {
            motion_start_ui=start;motion_length_ui=len;
            gui_track_overview_row(0,2,text);
            snprintf(expected,sizeof(expected),"%02d%c%02d",start+1,start+len>64?'~':'-',(start+len-1)%64+1);
            assert(strstr(text,expected) && strlen(text)<=29);
        }
        for(int scale=0;scale<SCALE_NUM_TONALITIES;scale++)
            for(int root=-2;root<12;root++) for(int songroot=-1;songroot<12;songroot++) {
                ui_scale=scale;roots[0]=root;ui_songroot=songroot;
                gui_track_overview_row(0,3,text);
                char scale_name[32];scale_type_to_name(scale_name,scale);
                assert(strstr(text,scale_name) && strlen(text)<=29);
                if(root==-2) {
                    snprintf(expected,sizeof(expected),"Song(%s)",scale_root_name(songroot));
                    assert(strstr(text,expected));
                } else assert(strstr(text,root==-1?"Root Off":scale_root_name(root)));
            }
        for(int rate=0;rate<=SEQ_UTILS_STEP_BAR_DIV_13;rate++) {
            rate_ui=rate;gui_track_overview_row(0,2,text);
            panel_utils_step_len_to_str(expected,rate);assert(strstr(text,expected));
        }
        // Stored values remain independent of current overrides and queued rates.
        rate_ui=SEQ_UTILS_STEP_HALF;timing_wait=1;clock_override=SEQ_UTILS_STEP_32ND;
        gui_track_overview_row(0,2,text);assert(strstr(text,"1/2"));
        timing_wait=0;clock_override=-1;
        gstate.grid_overlay_enable=1;gstate.grid_overlay[7]=GUI_OVERLAY_COLOR_HIGH;
        gui_draw_clock_help();ui_scene=(ui_scene+1)%6;
        int before=help_draws;assert(gui_draw_clock_help() && help_draws==before+2);
        gui_clock_help_set(0);assert(gui_clock_help_restore());
        assert(!gui_clock_help_restore() && gstate.grid_overlay[7]==GUI_OVERLAY_COLOR_HIGH);
    }
    track_type_ui=0;bias_ui=-1;motion_start_ui=0;motion_length_ui=16;rate_ui=SEQ_UTILS_STEP_16TH;
    ui_scene=ui_scale=0;ui_songroot=-1;for(int s=0;s<6;s++) roots[s]=-2;
}
static void test_scene_overview(void) {
    for(int lcd=0;lcd<2;lcd++) {
        gstate.GUI_GRID_X=lcd?25:40;gstate.GUI_GRID_Y=lcd?80:90;
        gstate.GUI_GRID_W=240;gstate.GUI_GRID_H=238;gstate.clock_help_drawn=0;
        scene_values_ui=1;
        for(int scene=0;scene<6;scene++) {
            ui_scene=(scene+1)%6; // engine/panel still elsewhere: target must remain pinned
            gui_scene_overview_open(scene);
            assert(gui_overview_mode()==GUI_OVERVIEW_SONG && gstate.overview_track==scene);
            gui_overview_page(9);
            assert(gui_overview_mode()==GUI_OVERVIEW_SCENE && gstate.overview_track==scene);
            int edits=edit_calls;unsigned cursor=gstate.clock_help_selected;
            gui_overview_edit(100);gui_clock_help_scroll(-100);
            assert(edits==edit_calls && cursor==gstate.clock_help_selected);
            assert(gui_draw_clock_help());int draws=help_draws;
            assert(!gui_draw_clock_help() && draws==help_draws);
            for(int track=0;track<6;track++) {
                char range[16],rate[16];
                snprintf(range,sizeof(range),"%02d-%02d",scene*8+track+1,scene*8+track+scene+track+1);
                panel_utils_step_len_to_str(rate,scene+track);
                char *row=gstate.clock_help_rows[2+2*track];
                assert(strstr(row,range) && strstr(row,rate));
                assert(row[1]=='1'+track && row[0]==(seq_ctrl_get_track_select(track)?'*':' '));
                assert(strstr(row,scene&1?"On":"Off"));
            }
            ui_scene=(ui_scene+1)%6;assert(!gui_draw_clock_help());
        }
        char text[30],expected[32];
        for(int root=-2;root<12;root++) for(int songroot=-1;songroot<12;songroot++) {
            roots[5]=root;ui_songroot=songroot;
            gui_scene_overview_row(5,0,text);
            assert(strlen(text)<=29 && strstr(text,"SCENE 6"));
            if(root==-2) {
                snprintf(expected,sizeof(expected),"Song(%s)",scale_root_name(songroot));
                assert(strstr(text,expected));
            } else assert(strstr(text,root==-1?"Root Off":scale_root_name(root)));
        }
        for(int type=0;type<2;type++) for(int scale=0;scale<SCALE_NUM_TONALITIES;scale++) {
            track_type_ui=type;ui_scale=scale;
            gui_scene_overview_row(5,13,text);
            scale_type_to_name(expected,scale);assert(strstr(text,expected) && strlen(text)<=29);
            assert(strstr(text,type==SONG_TRACK_TYPE_DRUM?"DRUM":"VOICE"));
        }
        gui_draw_clock_help();ui_scale=(ui_scale+1)%SCALE_NUM_TONALITIES;
        int before=help_draws;assert(gui_draw_clock_help() && help_draws==before+6);
        gstate.grid_overlay_enable=1;gstate.grid_overlay[7]=GUI_OVERLAY_COLOR_HIGH;
        gui_clock_help_set(0);assert(gui_clock_help_restore());
        assert(!gui_clock_help_restore() && gstate.grid_overlay[7]==GUI_OVERLAY_COLOR_HIGH);
    }
    scene_values_ui=track_type_ui=ui_scene=ui_scale=0;ui_songroot=-1;
    for(int s=0;s<6;s++) roots[s]=-2;
}
static void test_sys_edit_dispatch(void) {
    for(int lcd=0;lcd<2;lcd++) {
        gstate.screen_type=lcd;
        for(int item=0;item<20;item++) {
            struct clock_menu_row row;panel_menu_sys_row(item,&row);
            pmstate.menu_submode=item;panel_menu_display_sys();
            assert(!strncmp(gstate.status_lines[3]+14,row.value,strlen(row.value)));
            pmstate.menu_submode=2;pmstate.menu_mode=PANEL_MENU_NONE;
            int before=edit_calls;
            panel_menu_overview_edit(PANEL_MENU_SYS,item,1);
            assert(pmstate.menu_submode==2 && pmstate.menu_mode==PANEL_MENU_NONE);
            if(item==0 || item==19) assert(edit_calls==before);
            else {
                assert(edit_calls==before+1 && edit_change==1);
                if(item>=3) assert(edit_item==(item-3)%4);
            }
        }
    }
}
static void gui_refresh_task_lane_test(void) {
    int rows[10]={36,42,-1,-1,-1,-1,-1,-1,-1,-1};
    ui_running=0;gstate.lane_edit_drawn=0;
    gui_lane_edit_set(1,0,rows,1,20);
    assert(gstate.lane_edit && gstate.lane_edit_step==20 && gstate.lane_edit_cursor==1);
    lane_fills=0;gstate.clock_help=0;
    /* draw as the refresh task would (lanes over the grid) */
    assert(gui_draw_lane_edit());
    assert(!strcmp(gstate.clock_help_rows[2+9],"BD") && !strcmp(gstate.clock_help_rows[2+8],"CHH"));
    assert(!strcmp(gstate.clock_help_rows[2+7],"--") && strstr(gstate.clock_help_rows[0],"EDIT"));
    assert(gstate.lane_cursor_drawn_row==8 && gstate.lane_cursor_drawn_col==4);
    assert(!gui_draw_lane_edit());                                  /* nothing changed */
    gui_lane_edit_set(1,0,rows,0,21);assert(gui_draw_lane_edit()); /* cursor moved */
    assert(gstate.lane_cursor_drawn_row==9 && gstate.lane_cursor_drawn_col==5);
    gui_lane_edit_set(0,0,0,0,0);assert(gui_lane_edit_restore() && !gstate.lane_edit_drawn);
}
static struct track_event LN(int p,int v) {
    return (struct track_event){.type=SONG_EVENT_NOTE,.data0=p,.data1=v,.length=12,.delay=SEQ_START_DELAY_INHERIT};
}
// DRUM lane overview: kick bottom row and kept, +N other, paging, follow.
static void test_drum_lanes(void) {
    memset(lane_ev,0,sizeof(lane_ev));
    for(int s=0;s<64;s++) {
        int n=0;
        if(s%16==0) lane_ev[s][n++]=LN(36,110);  /* kick: 4 hits, fewer than all others */
        lane_ev[s][n++]=LN(42,s&1?30:90);        /* hats; odd steps ghost */
        if(s%8==4) lane_ev[s][n++]=LN(38,100);
    }
    /* 11 more pitches, each hit more than the kick, so the kick is the one at risk. */
    for(int p=0;p<11;p++) {
        int placed=0;
        for(int s=0;s<64 && placed<8;s++) {
            int slot=0; while(slot<SEQ_TRACK_POLY-1 && lane_ev[s][slot].type) slot++;
            if(slot<SEQ_TRACK_POLY-1 && s!=5) {lane_ev[s][slot]=LN(60+p,80);placed++;}
        }
        assert(placed==8);
    }
    lane_ev[5][5]=(struct track_event){.type=SONG_EVENT_PROBABILITY,.data0=50};
    lane_ev[2][0].delay=10;                                     /* step 3 slot 0 is 42 */
    for(int lcd=0;lcd<2;lcd++) {
        gstate.screen_type=lcd;
        gstate.GUI_GRID_X=lcd?25:40;gstate.GUI_GRID_Y=lcd?80:90;
        gstate.GUI_GRID_W=240;gstate.GUI_GRID_H=238;
        scene_values_ui=0;motion_start_ui=16;motion_length_ui=16;ui_running=0;
        track_type_ui=SONG_TRACK_TYPE_DRUM;gstate.clock_help_drawn=0;
        gui_track_overview_open(0);
        assert(gui_overview_mode()==GUI_OVERVIEW_LANES && gstate.lane_page==1);
        lane_fills=0;assert(gui_draw_clock_help() && lane_fills>0);
        int lanes[10],count;int hidden=gui_lanes_pick(0,lanes,&count);
        assert(count==10 && lanes[0]==36 && hidden>0);              /* kick kept, bottom */
        assert(!strcmp(gstate.clock_help_rows[2+9],"BD"));           /* bottom row label */
        assert(strstr(gstate.clock_help_rows[0],"17-32") && strstr(gstate.clock_help_rows[0],"other"));
        /* cell codes */
        assert((gui_lane_cell(0,0,36,1)&7)==4 && !(gui_lane_cell(0,0,36,1)&0x08));
        assert(gui_lane_cell(0,2,42,1)&0x20);                        /* own delay */
        assert(gui_lane_cell(0,1,42,1)&0x08);                        /* ghost */
        assert(gui_lane_cell(0,5,42,1)&0x10);                        /* condition */
        assert(!(gui_lane_cell(0,1,36,1)&7));                        /* no hit */
        /* unchanged: no redraw */
        assert(!gui_draw_clock_help());
        /* Pattern/Euclid mask: black column, hits kept at the lowest level. */
        ui_mask_step=16;assert(gui_draw_clock_help());
        { uint16_t c=gstate.lane_cells[9][0];  /* step 17 is masked; bottom row */
          assert(c&0x100); assert(!(c&7) || (c&7)==1); }
        assert(!(gstate.lane_cells[9][1]&0x100));
        assert(!gui_draw_clock_help());
        /* As recorded at 100%: an empty step is not masked (a hit would play);
           with a Euclidean mask (density < 100) it is. */
        ui_pattern=PATTERN_AS_RECORDED;assert(gui_draw_clock_help());
        assert(!(gstate.lane_cells[9][0]&0x100));
        ui_density=75;assert(gui_draw_clock_help());
        assert(gstate.lane_cells[9][0]&0x100);
        ui_density=100;ui_pattern=0;
        ui_mask_step=-1;assert(gui_draw_clock_help());
        assert(!(gstate.lane_cells[9][0]&0x100));
        /* paging: lanes 1-4, then Settings; stops at ends */
        gui_overview_page(-5);assert(gstate.lane_page==0 && !gstate.lane_follow);
        gui_overview_page(3);assert(gstate.lane_page==3 && gui_overview_mode()==GUI_OVERVIEW_LANES);
        gui_overview_page(1);assert(gui_overview_mode()==GUI_OVERVIEW_TRACK);
        assert(gui_draw_clock_help());
        gui_overview_page(5);assert(gui_overview_mode()==GUI_OVERVIEW_TRACK);
        gui_overview_page(-1);assert(gui_overview_mode()==GUI_OVERVIEW_LANES && gstate.lane_page==3);
        assert(gui_draw_clock_help());
        /* follow: running opens on playhead page and follows */
        ui_running=1;gstate.active_step[0]=40;gui_track_overview_open(0);
        assert(gstate.lane_page==2 && gstate.lane_follow);
        gui_draw_clock_help();gstate.active_step[0]=50;gui_draw_clock_help();
        assert(gstate.lane_page==3);
        gui_overview_page(-1);gstate.active_step[0]=5;gui_draw_clock_help();
        assert(gstate.lane_page==2);                                 /* turn stops following */
        /* Recording: pending take shows white; played lane dims stored hits;
           a new pitch gets a lane at once (kick still kept). */
        ui_running=1;ui_recording=1;take_track=0;gstate.active_step[0]=0;
        gui_track_overview_open(0);
        take_n=2;take_p[0]=42;take_s[0]=3;take_v[0]=100;take_p[1]=81;take_s[1]=7;take_v[1]=90;
        assert(gui_draw_clock_help());
        assert(strstr(gstate.clock_help_rows[0],"REC"));
        { int l[10],c;gui_lanes_pick(0,l,&c);int has81=0;for(int i=0;i<c;i++) has81|=l[i]==81;
          assert(has81 && l[0]==36 && c==10); }
        assert(gui_lane_cell(0,3,42,1)&0x80);                        /* take hit */
        assert((gui_lane_cell(0,0,42,1)&7)==1 && !(gui_lane_cell(0,0,42,1)&0x80)); /* dimmed */
        assert((gui_lane_cell(0,0,36,1)&7)==4);                      /* unplayed lane unchanged */
        take_track=1;assert(gui_draw_clock_help());                  /* other track: no take */
        assert(!(gui_lane_cell(0,3,42,1)&0x80) && (gui_lane_cell(0,0,42,1)&7)>1);
        ui_recording=0;take_n=0;take_track=0;
        /* Step Edit lane view: fixed rows incl. empty ones, cursor frame. */
        gui_clock_help_set(0);gui_refresh_task_lane_test();
        ui_running=0;
        /* VOICE opens the tracker (slots); last page is Settings */
        track_type_ui=SONG_TRACK_TYPE_VOICE;gui_track_overview_open(0);
        assert(gui_overview_mode()==GUI_OVERVIEW_TRACKER && gstate.lane_page==1);
        assert(gui_draw_clock_help());
        assert(!strncmp(gstate.trk_rows[0],"T1 17-32 p2/4",13));
        assert(!strncmp(gstate.trk_rows[1]," #  s1  s2",10));
        assert(!gui_draw_clock_help());                             /* cached */
        gui_overview_page(-1);assert(gstate.lane_page==0);
        assert(gui_draw_clock_help());
        /* step 1 slot 0: BD at 120 is note 36 -> C2 on a VOICE track */
        assert(!strncmp(gstate.trk_rows[2],"01 C2  ",7) && (gstate.trk_attr[2][0]&7)==4);
        assert(strstr(gstate.trk_rows[2+5],"%50"));               /* Prb slot */
        assert(strstr(gstate.trk_rows[2+2],"F#2'"));              /* own delay */
        /* enabled steps: region 17-32 only; step 17 masked by the pattern */
        assert(!(gstate.trk_attr[2][0]&0x80));
        gui_overview_page(1);ui_mask_step=16;assert(gui_draw_clock_help());
        assert(!(gstate.trk_attr[2][0]&0x80) && (gstate.trk_attr[3][0]&0x80));
        ui_mask_step=-1;gui_overview_page(-1);gui_draw_clock_help();
        gui_overview_page(9);assert(gui_overview_mode()==GUI_OVERVIEW_TRACK);
        gui_overview_page(-1);assert(gui_overview_mode()==GUI_OVERVIEW_TRACKER && gstate.lane_page==3);
        /* track select follows: page/follow kept; Settings stays Settings */
        gui_overview_follow_track(2);
        assert(gstate.overview_track==2 && gui_overview_mode()==GUI_OVERVIEW_TRACKER && gstate.lane_page==3);
        gui_overview_page(9);gui_overview_follow_track(0);
        assert(gstate.overview_track==0 && gui_overview_mode()==GUI_OVERVIEW_TRACK);
        gui_overview_page(-1);
        /* Scene: song tracker, first notes per track; drum names on DRUM tracks */
        gui_scene_overview_open(0);assert(gui_overview_mode()==GUI_OVERVIEW_SONG);
        gui_overview_page(-9);assert(gui_draw_clock_help());
        assert(!strncmp(gstate.trk_rows[1]," #  T1  T2",10));
        assert(strstr(gstate.trk_rows[0],"SCENE 1 01-16"));
        assert(!strncmp(gstate.trk_rows[2],"01 C2 +C2 +",11));   /* several notes */
        gui_draw_clock_help();
        gui_clock_help_set(0);
    }
    track_type_ui=0;motion_start_ui=0;motion_length_ui=0;
}
int main(void) {
    test_drum_lanes();
    test_sys_edit_dispatch();
    test_scene_overview();
    test_track_overview();
    test_clock_help();
    test_overview_editors();
    char expected[64];
    memset(gstate.status_lines, ' ', sizeof(gstate.status_lines));
    timing_wait=1; panel_menu_display_timing_value(0);
    assert(strstr(gstate.status_lines[3],"next bar"));
    timing_wait=0; panel_menu_display_timing_value(0);
    assert(!strstr(gstate.status_lines[3],"next bar"));
    timing_choice=SEQ_UTILS_ARP_CHORD;panel_menu_display_timing_value(1);
    assert(!strncmp(gstate.status_lines[3]+14,"Chord",5));
    timing_wait=1;panel_menu_display_timing_value(1);assert(strstr(gstate.status_lines[3],"Chord >bar"));
    panel_menu_display_timing_value(0);assert(!strncmp(gstate.status_lines[3]+14,"1/3",3));
    timing_wait=0;timing_choice=4;
    for(int lcd = 0; lcd < GUI_DISP_NUM_TYPES; lcd++) {
        gstate.screen_type = lcd;
        for(int p=0;p<HUMANIZE_PARAMS;p++) {
            pmstate.menu_submode=PANEL_MENU_CLOCK_HUMANIZE+p;
            assert(panel_menu_edit_humanize_item(pmstate.menu_submode,999));
            assert(ui_humanize[0].value[p]==ui_humanize[2].value[p]);
            assert(!ui_humanize[1].value[p]);
            assert(panel_menu_display_humanize());
            assert(strlen(gstate.status_lines[3])==28);
            // Fixed parameter/value fields must have a visible gap, even at maxima.
            assert(!strncmp(gstate.status_lines[3]+11, "   ", 3));
            assert(!strncmp(gstate.status_lines[1], "Humanize T1 / session only", strlen("Humanize T1 / session only")));
            if(p==HUMANIZE_VELOCITY_CHANCE) {
                assert(!strncmp(gstate.status_lines[3], "Vel Chance    100%", strlen("Vel Chance    100%")));
                seq_engine_humanize_set(0,p,66);panel_menu_display_humanize();
                assert(!strncmp(gstate.status_lines[3], "Vel Chance    66%", strlen("Vel Chance    66%")));
            }
            gstate.glabels[GUI_LABEL_STATUS_L4].dirty=0;
            assert(panel_menu_display_humanize());
            assert(!gstate.glabels[GUI_LABEL_STATUS_L4].dirty);
        }
        pmstate.menu_submode=PANEL_MENU_CLOCK_HUMANIZE+HUMANIZE_LATE_MAX;
        panel_menu_edit_humanize_item(pmstate.menu_submode,-999);
        assert(!ui_humanize[0].value[HUMANIZE_LATE_MAX] && !ui_humanize[2].value[HUMANIZE_LATE_MAX]);
        for(ui_scale = 0; ui_scale < SCALE_NUM_TONALITIES; ui_scale++)
            for(ui_songroot = -1; ui_songroot < 12; ui_songroot++) {
                memset(gstate.status_lines, ' ', sizeof(gstate.status_lines));
                pmstate.menu_submode = PANEL_MENU_TONALITY_SCALE;
                panel_menu_display_tonality();
                scale_name_with_root(expected, ui_scale, ui_songroot);
                assert(strlen(expected) <= 27);
                assert(!strncmp(gstate.status_lines[3], expected, strlen(expected)));
                gstate.glabels[GUI_LABEL_STATUS_L4].dirty = 0;
                panel_menu_display_tonality();
                assert(!gstate.glabels[GUI_LABEL_STATUS_L4].dirty);
                gui_update_tonality(ui_scene, 0, ui_scale);
                assert(strlen(gstate.status_lines[3]) == 28);
            }
        for(int i = PANEL_MENU_TONALITY_SWING; i < PANEL_MENU_TONALITY_NUM_SUBMODES; i++) {
            pmstate.menu_submode = i; panel_menu_display_tonality();
            assert(strlen(gstate.status_lines[3]) == 28);
            if(i == PANEL_MENU_TONALITY_SONG_ROOT) assert(!strncmp(gstate.status_lines[3], "Song Root", 9));
            if(i >= PANEL_MENU_TONALITY_SCENE_ROOT1) {
                snprintf(expected, sizeof(expected), "Scene %d Root", i - PANEL_MENU_TONALITY_SCENE_ROOT1 + 1);
                assert(!strncmp(gstate.status_lines[3], expected, strlen(expected)));
                assert(!strncmp(gstate.status_lines[3] + 14, "Song", 4));
            }
        }
        // Actual Shift+Tonality enters SWING; roots follow Swing here too.
        for(int i = 1; i < PANEL_MENU_SWING_NUM_SUBMODES; i++) {
            pmstate.menu_submode = i; panel_menu_display_swing();
            assert(strlen(gstate.status_lines[3]) == 28);
            if(i == 1) assert(!strncmp(gstate.status_lines[3], "Song Root", 9));
            else {
                snprintf(expected, sizeof(expected), "Scene %d Root", i - 1);
                assert(!strncmp(gstate.status_lines[3], expected, strlen(expected)));
            }
        }
        ui_songroot = 6; roots[0] = 2; ui_scale = SCALE_MAJOR;
        pmstate.menu_submode = PANEL_MENU_TONALITY_SCALE; panel_menu_display_tonality();
        assert(!strncmp(gstate.status_lines[3], "D Major", 7));
        roots[0] = -1; panel_menu_display_tonality();
        assert(!strncmp(gstate.status_lines[3], "Major (Root Off)", 16));
        roots[0] = -2;
    }
    ui_songroot = -1; panel_menu_edit_root(0, -100); assert(ui_songroot == -1);
    panel_menu_edit_root(0, 1); assert(ui_songroot == 0);
    panel_menu_edit_root(0, 100); assert(ui_songroot == 11);
    for(int scene = 0; scene < 6; scene++) {
        panel_menu_edit_root(scene + 1, -100); assert(roots[scene] == -2);
        panel_menu_edit_root(scene + 1, 1); assert(roots[scene] == -1);
        panel_menu_edit_root(scene + 1, 1); assert(roots[scene] == 0);
        panel_menu_edit_root(scene + 1, 100); assert(roots[scene] == 11);
    }
    puts("root UI tests passed"); return 0;
}
