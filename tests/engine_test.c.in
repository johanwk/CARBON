/* Use the production MIDI CC conversion helpers and MIDI message utilities
 * via separate compilation; only external song/hardware services are fixtures.
 */
static int snapshot_test_valid, snapshot_test_busy;
static struct track_event snapshot_events[6][6];
int song_snapshot_available(void) {return snapshot_test_valid;}
int song_snapshot_idle(void) {return !snapshot_test_busy;}
void song_snapshot_clear(void) {snapshot_test_valid=0;}
int song_snapshot_capture(void) {
    if(snapshot_test_busy) return -1;
    memcpy(snapshot_events,fixture,sizeof(snapshot_events));snapshot_test_valid=1;return 0;
}
int song_snapshot_restore(void) {
    if(snapshot_test_busy || !snapshot_test_valid) return -1;
    memcpy(fixture,snapshot_events,sizeof(snapshot_events));return 0;
}
void seq_ctrl_refresh_snapshot_modules(void) {}
void seq_ctrl_restore_snapshot_modes(int live, int songmode) {}
static void setup(void) {
    int t;
    test_record_mode=SEQ_CTRL_RECORD_IDLE;
    snapshot_test_valid=snapshot_test_busy=snapshot_queued=0;
    memset(timing_step,0,sizeof(timing_step)); memset(timing_arp,0,sizeof(timing_arp));
    memset(&sestate, 0, sizeof(sestate));
    memset(fixture, 0, sizeof(fixture));
    memset(reads, 0, sizeof(reads));
    memset(enabled, 0, sizeof(enabled));
    output_count = 0;
    test_delay = 0; test_ratchet = 1;
    running = 1;
    test_root = SONG_ROOT_OFF;
    live_mode = SEQ_CTRL_LIVE_OFF;
    selected = -1;
    seq_engine_clear_internal_cc();
    for(t = 0; t < SEQ_NUM_TRACKS; t ++) {
        conditional_init(&sestate.conditions[t], t);
        sestate.bias_track_map[t] = SONG_TRACK_BIAS_NULL;
        sestate.motion_len[t] = 8;
        sestate.step_size[t] = 24;
        sestate.gate_time[t] = 128;
        sestate.clock_div_count[t] = 1;
    }
}
static void put(int track, int slot, int type, int a, int b) {
    fixture[track][slot] = (struct track_event){
        .type = type, .data0 = a, .data1 = b, .length = 1};
}
static void test_mixed_and_cleanup(void) {
    struct seq_engine_step_visit visits[SEQ_NUM_TRACKS] = {0};
    uint32_t expected;
    struct conditional_state reference;
    setup();
    enabled[0] = 1;
    sestate.clock_div_count[0] = 0;
    sestate.bias_track_map[1] = 0;
    put(0, 0, SONG_EVENT_NOTE, 60, 100);
    put(0, 1, SONG_EVENT_CC, 7, 90);
    put(0, 2, SONG_EVENT_PROGCHG, 12, 0);
    put(0, 3, SONG_EVENT_PROBABILITY, 0, 0);
    put(0, 4, SONG_EVENT_INTERNAL_CC, MIDI_CTRL_CC_TRACK_MUTE, 127);
    put(0, 5, SONG_EVENT_NOTE, 72, 100);
    reference = sestate.conditions[0];
    conditional_probability(&reference, 0);
    expected = reference.random;
    seq_engine_prepare_visits(visits);
    assert(visits[0].slots == 7 && reads[0] == SEQ_TRACK_POLY);
    assert(sestate.bias_track_output[0] == 0); // first eligible Note
    assert(sestate.internal_cc[1][2] == -1); // blocked CCi
    assert(sestate.conditions[0].random == expected);
    seq_engine_track_play_step(0, 0, &visits[0]);
    assert(output_count == 3);
    assert(output[0].status == MIDI_NOTE_ON && output[0].data0 == 60);
    assert(output[1].status == MIDI_CONTROL_CHANGE && output[1].data0 == 7);
    assert(output[2].status == MIDI_PROGRAM_CHANGE && output[2].data0 == 12);
    assert(sestate.conditions[0].random == expected);
    seq_engine_track_manage_notes(0);
    assert(output_count == 4 && output[3].status == MIDI_NOTE_OFF);
    assert(!sestate.track_active_notes[0][15].note.msg.status);
}
static void test_gated_bias_and_control(void) {
    struct seq_engine_step_visit visits[SEQ_NUM_TRACKS] = {0};
    uint32_t saved;
    setup();
    enabled[0] = 1;
    sestate.clock_div_count[0] = 0;
    sestate.bias_track_map[1] = 0;
    sestate.bias_track_output[0] = -5;
    put(0, 0, SONG_EVENT_PROBABILITY, 0, 0);
    put(0, 1, SONG_EVENT_NOTE, 70, 100);
    put(0, 2, SONG_EVENT_INTERNAL_CC, MIDI_CTRL_CC_TRACK_MUTE, 127);
    put(0, 3, SONG_EVENT_PROBABILITY, 100, 0);
    seq_engine_prepare_visits(visits);
    saved = sestate.conditions[0].random;
    assert(!visits[0].slots && sestate.bias_track_output[0] == -5);
    assert(sestate.internal_cc[1][2] == -1);
    seq_engine_prepare_visits(visits);
    seq_engine_track_play_step(0, 0, &visits[0]);
    assert(!output_count && sestate.conditions[0].random == saved);
}
static void test_cross_track(int source, int target, int masked) {
    struct seq_engine_step_visit visits[SEQ_NUM_TRACKS] = {0};
    struct conditional_state reference;
    setup();
    enabled[source] = 1;
    enabled[target] = !masked;
    sestate.clock_div_count[source] = 0;
    sestate.clock_div_count[target] = masked ? 0 : 3;
    sestate.bias_track_map[target] = source;
    put(source, 0, SONG_EVENT_PROBABILITY, 100, 0);
    put(source, 1, SONG_EVENT_INTERNAL_CC,
        masked ? MIDI_CTRL_CC_PATTERN_TYPE : MIDI_CTRL_CC_STEP_LENGTH, 127);
    put(target, 0, SONG_EVENT_PROBABILITY, 100, 0);
    put(target, 1, SONG_EVENT_NOTE, 64, 100);
    reference = sestate.conditions[target];
    conditional_probability(&reference, 100);
    seq_engine_prepare_visits(visits);
    assert(visits[source].prepared && visits[target].prepared);
    assert(reads[target] == SEQ_TRACK_POLY);
    assert(sestate.conditions[target].random == reference.random);
    assert(visits[target].slots == 2);
    seq_engine_track_play_step(target, 0, &visits[target]);
    assert(output_count == 1 && output[0].data0 == 64);
}
static void test_mask_mute_and_reset(void) {
    struct seq_engine_step_visit visits[SEQ_NUM_TRACKS] = {0};
    uint32_t seed;
    setup();
    sestate.clock_div_count[0] = 0;
    put(0, 0, SONG_EVENT_PROBABILITY, 100, 0);
    put(0, 1, SONG_EVENT_INTERNAL_CC, MIDI_CTRL_CC_TRACK_MUTE, 127);
    sestate.bias_track_map[1] = 0;
    seed = sestate.conditions[0].random;
    seq_engine_prepare_visits(visits);
    assert(!visits[0].prepared && !reads[0]);
    assert(sestate.conditions[0].random == seed);
    enabled[0] = 1;
    sestate.track_mute[0] = 1;
    seq_engine_prepare_visits(visits);
    assert(visits[0].prepared && sestate.track_mute[1]);
    assert(sestate.conditions[0].history);
    seq_engine_reset_all_tracks_pos();
    assert(sestate.conditions[0].history); // scene position helper preserves state
    seed = sestate.conditions[0].random;
    seq_engine_reset_track(0);
    assert(!sestate.conditions[0].history && sestate.conditions[0].random == seed);
}
static void test_cross_track_tick(void) {
    int source, masked;
    for(source = 0; source <= 5; source += 5) {
        int target = 5 - source;
        for(masked = 0; masked <= 1; masked ++) {
            struct conditional_state expected;
            setup();
            enabled[source] = 1;
            enabled[target] = !masked;
            sestate.clock_div_count[source] = 0;
            sestate.clock_div_count[target] = masked ? 0 : 3;
            sestate.bias_track_map[target] = source;
            put(source, 0, SONG_EVENT_PROBABILITY, 100, 0);
            put(source, 1, SONG_EVENT_INTERNAL_CC,
                masked ? MIDI_CTRL_CC_PATTERN_TYPE : MIDI_CTRL_CC_STEP_LENGTH, 127);
            put(target, 0, SONG_EVENT_PROBABILITY, 100, 0);
            put(target, 1, SONG_EVENT_NOTE, 65, 100);
            expected = sestate.conditions[target];
            conditional_probability(&expected, 100);
            seq_engine_run(1);
            assert(output_count == 1 && output[0].data0 == 65);
            assert(reads[target] == SEQ_TRACK_POLY);
            assert(sestate.conditions[target].random == expected.random);
            assert(sestate.step_pos[target] == 1);
        }
    }
}

static void test_tick_loop(void) {
    int mode;
    for(mode = 0; mode < 3; mode ++) {
        uint32_t evaluated;
        setup();
        enabled[0] = 1;
        sestate.clock_div_count[0] = 0;
        sestate.bias_track_map[1] = 0;
        put(0, 0, SONG_EVENT_PROBABILITY, 100, 0);
        put(0, 1, SONG_EVENT_INTERNAL_CC, MIDI_CTRL_CC_TRACK_MUTE, 127);
        put(0, 2, SONG_EVENT_NOTE, 67, 100);
        if(mode == 1) sestate.track_mute[0] = 1;
        if(mode == 2) { live_mode = SEQ_CTRL_LIVE_ON; selected = 0; }
        seq_engine_run(1);
        assert(sestate.track_mute[1] && sestate.conditions[0].history);
        assert(reads[0] == SEQ_TRACK_POLY);
        assert(output_count == (mode == 0 ? 1 : 0));
        assert(sestate.step_pos[0] == 1);
        evaluated = sestate.conditions[0].random;
        running = 0;
        seq_engine_run(2);
        assert(sestate.conditions[0].random == evaluated);
        running = 1;
        seq_engine_run(3);
        assert(sestate.conditions[0].random == evaluated);
        // Reset while stopped clears state, without evaluating a step.
        running = 0;
        seq_engine_run(0);
        assert(!sestate.conditions[0].history);
        assert(sestate.conditions[0].random == evaluated);
    }
    // A masked visit advances motion but performs no reads or random draws.
    setup();
    sestate.clock_div_count[0] = 0;
    put(0, 0, SONG_EVENT_PROBABILITY, 100, 0);
    {
        uint32_t seed = sestate.conditions[0].random;
        seq_engine_run(1);
        assert(!reads[0] && !output_count && sestate.step_pos[0] == 1);
        assert(sestate.conditions[0].random == seed);
    }
}
static void test_cycles_and_history(void) {
    int length, reverse, n;
    for(length = 1; length <= 64; length ++) {
        for(reverse = 0; reverse <= 1; reverse ++) {
            setup();
            sestate.motion_start[0] = 60;
            sestate.motion_len[0] = length;
            sestate.dir_reverse[0] = reverse;
            sestate.step_pos[0] = reverse ? (60 + length - 1) % 64 : 60;
            for(n = 0; n < length; n ++) {
                assert(sestate.conditions[0].cycle == 0);
                seq_engine_move_to_next_step(0);
            }
            assert(sestate.conditions[0].cycle == 1);
        }
    }
    setup();
    seq_engine_set_direction(0, 1);
    assert(sestate.conditions[0].cycle == 1);
    seq_engine_set_direction(0, 1);
    assert(sestate.conditions[0].cycle == 1);
    sestate.internal_cc[0][MIDI_CTRL_CC_MOTION_DIR - 16] = 0;
    seq_engine_refresh_internal_cc_target(0, MIDI_CTRL_CC_MOTION_DIR);
    assert(sestate.conditions[0].cycle == 2);
    seq_engine_recalc_params();
    assert(sestate.conditions[0].cycle == 2);
    // Correction of an out-of-window position is not a completed loop.
    sestate.step_pos[0] = 30;
    seq_engine_move_to_next_step(0);
    assert(sestate.conditions[0].cycle == 2);
    // Reset must win over restoring a stored direction from a CCi override.
    seq_engine_set_direction(0, 1);
    running = 0;
    seq_engine_run(0);
    assert(sestate.conditions[0].cycle == 0);
    // One-step Euclidean first visit sees zero; increment happens afterwards.
    setup();
    enabled[0] = 1;
    sestate.clock_div_count[0] = 0;
    sestate.motion_len[0] = 1;
    put(0, 0, SONG_EVENT_EUCLIDEAN, 0, 0);
    put(0, 1, SONG_EVENT_NOTE, 60, 100);
    seq_engine_run(1);
    assert(output_count == 1 && sestate.conditions[0].cycle == 1);
    sestate.clock_div_count[0] = 0;
    seq_engine_run(2);
    assert(output_count == 2); // note-off only; second 1:2 visit fails
    assert(output[1].status == MIDI_NOTE_OFF && sestate.conditions[0].cycle == 2);
    // Snapshot: probability passes but later Pre still reads prior false.
    setup();
    enabled[0] = 1;
    sestate.clock_div_count[0] = 0;
    put(0, 0, SONG_EVENT_PROBABILITY, 100, 0);
    put(0, 1, SONG_EVENT_PRE, 0, 0);
    put(0, 2, SONG_EVENT_NOTE, 60, 100);
    seq_engine_run(1);
    assert(!output_count && sestate.conditions[0].history);
    sestate.clock_div_count[0] = 0;
    seq_engine_run(2);
    assert(output_count == 1 && sestate.conditions[0].history);
    // Non-Pre-only failure cannot change prior history.
    memset(fixture[0], 0, sizeof(fixture[0]));
    put(0, 0, SONG_EVENT_NON_PRE, 0, 0);
    put(0, 1, SONG_EVENT_NOTE, 70, 100);
    sestate.clock_div_count[0] = 0;
    seq_engine_run(3);
    assert(output_count == 2 && output[1].status == MIDI_NOTE_OFF);
    assert(sestate.conditions[0].history);
}

static void test_scene_activation(void) {
    uint32_t random;
    setup();
    scene_reverse = 1;
    sestate.conditions[0].cycle = 10;
    sestate.conditions[0].history = 1;
    random = sestate.conditions[0].random;
    sestate.scene_next = 1;
    assert(!seq_engine_change_scene_synced());
    assert(sestate.conditions[0].cycle == 11);
    assert(sestate.conditions[0].history && sestate.conditions[0].random == random);
    seq_engine_recalc_params();
    assert(sestate.conditions[0].cycle == 11);
    // Same-direction scene change alone does not count a loop.
    sestate.scene_next = 2;
    assert(!seq_engine_change_scene_synced());
    assert(sestate.conditions[0].cycle == 12); // reverse -> forward
    sestate.scene_next = 3;
    assert(!seq_engine_change_scene_synced());
    assert(sestate.conditions[0].cycle == 12);
    assert(sestate.conditions[0].history && sestate.conditions[0].random == random);
}

static void test_control_cycles(void) {
    struct seq_engine_step_visit visits[SEQ_NUM_TRACKS] = {0};
    int t;
    setup();
    // Chain 5 -> 3 -> 1; backward eligibility propagation requires rescans.
    for(t = 1; t <= 5; t += 2) {
        enabled[t] = 1;
        put(t, 0, SONG_EVENT_PROBABILITY, 100, 0);
        put(t, 1, SONG_EVENT_INTERNAL_CC, MIDI_CTRL_CC_STEP_LENGTH, 127);
    }
    sestate.bias_track_map[3] = 5;
    sestate.bias_track_map[1] = 3;
    sestate.clock_div_count[5] = 0;
    seq_engine_prepare_visits(visits);
    for(t = 1; t <= 5; t += 2) assert(reads[t] == SEQ_TRACK_POLY);
    // Cyclic CCi mappings cannot re-evaluate either visit.
    setup(); memset(visits, 0, sizeof(visits));
    enabled[0] = enabled[1] = 1;
    sestate.clock_div_count[0] = 0;
    sestate.bias_track_map[0] = 1; sestate.bias_track_map[1] = 0;
    put(0, 0, SONG_EVENT_INTERNAL_CC, MIDI_CTRL_CC_STEP_LENGTH, 127);
    put(1, 0, SONG_EVENT_INTERNAL_CC, MIDI_CTRL_CC_STEP_LENGTH, 127);
    seq_engine_prepare_visits(visits);
    assert(reads[0] == SEQ_TRACK_POLY && reads[1] == SEQ_TRACK_POLY);
    // Later CCi reverses an already prepared Euclidean source: its result
    // stays frozen; phase changes immediately for its next visit.
    setup(); memset(visits, 0, sizeof(visits));
    enabled[0] = enabled[5] = 1;
    sestate.clock_div_count[0] = sestate.clock_div_count[5] = 0;
    sestate.bias_track_map[0] = 5;
    put(0, 0, SONG_EVENT_EUCLIDEAN, 0, 0);
    put(0, 1, SONG_EVENT_NOTE, 60, 100);
    put(5, 0, SONG_EVENT_INTERNAL_CC, MIDI_CTRL_CC_MOTION_DIR, 127);
    seq_engine_prepare_visits(visits);
    assert(visits[0].slots == 2 && sestate.conditions[0].cycle == 1);
    seq_engine_track_play_step(0, 0, &visits[0]);
    assert(output_count == 1);
    memset(visits, 0, sizeof(visits));
    seq_engine_prepare_visits(visits);
    assert(!visits[0].slots && sestate.conditions[0].cycle == 1);
}

static void test_root_offsets(void) {
    struct seq_engine_step_visit visit = {0};
    setup(); test_root = 0;
    sestate.kbtrans = -12;
    sestate.bias_track_map[1] = 0;
    sestate.bias_track_output[0] = -12;
    sestate.internal_cc[1][1] = 12; // CCi17 belongs at output in root mode
    visit.slots = 1; visit.events[0] = (struct track_event){
        .type = SONG_EVENT_NOTE, .data0 = 22, .data1 = 100, .length = 1};
    seq_engine_track_play_step(1, 0, &visit);
    assert(output_count == 1 && output[0].data0 == -2);
    seq_engine_track_manage_notes(1);
    assert(output_count == 2 && output[1].data0 == -2 && output[1].status == MIDI_NOTE_OFF);
    setup(); test_root = 0;
    sestate.internal_cc[0][1] = 12;
    seq_engine_arp_start_note(0, &(struct midi_msg){.status = MIDI_NOTE_ON, .data0 = 64});
    assert(output_count == 1 && output[0].data0 == 64); // no offset twice
}

static void test_harmony(void) {
    // Root priority for every pair of tracks, regardless of resolution order.
    for(int low = 0; low < SEQ_NUM_TRACKS; low++)
        for(int high = low + 1; high < SEQ_NUM_TRACKS; high++) {
            struct seq_engine_step_visit pair[SEQ_NUM_TRACKS] = {0};
            setup();
            pair[high].slots = pair[low].slots = 1;
            pair[high].events[0] = (struct track_event){.type = SONG_EVENT_HARMONY,
                .data0 = SCALE_MAJOR + 1, .data1 = SONG_HARMONY_ROOT_C + 7};
            pair[low].events[0] = (struct track_event){.type = SONG_EVENT_HARMONY,
                .data0 = SCALE_NAT_MINOR + 1, .data1 = SONG_HARMONY_ROOT_C + 2};
            seq_engine_resolve_harmony(pair);
            assert(seq_engine_get_effective_root(0) == 2);
            pair[low].events[0].data1 = SONG_HARMONY_ROOT_KEEP;
            seq_engine_resolve_harmony(pair);
            assert(seq_engine_get_effective_root(0) == 7);
        }
    struct seq_engine_step_visit visits[SEQ_NUM_TRACKS] = {0};
    setup(); enabled[0] = enabled[5] = 1;
    sestate.clock_div_count[0] = 3; sestate.clock_div_count[5] = 0;
    sestate.bias_track_map[0] = 5; sestate.bias_track_map[2] = 0;
    put(5, 0, SONG_EVENT_INTERNAL_CC, MIDI_CTRL_CC_STEP_LENGTH, 127);
    put(5, 1, SONG_EVENT_HARMONY, SCALE_MAJOR + 1, SONG_HARMONY_ROOT_C + 7);
    put(0, 0, SONG_EVENT_HARMONY, SCALE_NAT_MINOR + 1, SONG_HARMONY_ROOT_C + 2);
    put(0, 1, SONG_EVENT_HARMONY, SCALE_DORIAN + 1, SONG_HARMONY_ROOT_OFF);
    put(0, 2, SONG_EVENT_HARMONY, SCALE_BLUES + 1, SONG_HARMONY_ROOT_KEEP);
    seq_engine_prepare_visits(visits);
    assert(visits[0].prepared && visits[5].prepared);
    assert(seq_engine_get_effective_root(0) == SONG_ROOT_OFF); // last explicit Track1 request
    assert(seq_engine_get_effective_tonality(0, 2) == SCALE_BLUES); // Keep still sets scale
    assert(seq_engine_get_effective_tonality(0, 5) == SCALE_MAJOR); // losing root still sets scale
    assert(seq_engine_get_effective_tonality(0, 0) == SCALE_MAJOR); // later source targets T1
    memset(visits, 0, sizeof(visits)); memset(fixture, 0, sizeof(fixture));
    put(0, 0, SONG_EVENT_PROBABILITY, 0, 0);
    put(0, 1, SONG_EVENT_HARMONY, SCALE_MAJOR + 1, SONG_HARMONY_ROOT_C);
    put(5, 0, SONG_EVENT_HARMONY, SCALE_MAJOR + 1, SONG_HARMONY_ROOT_C + 9);
    seq_engine_prepare_visits(visits);
    assert(seq_engine_get_effective_root(0) == 9); // blocked lower track cannot win
    memset(visits, 0, sizeof(visits)); memset(fixture, 0, sizeof(fixture));
    put(0, 0, SONG_EVENT_HARMONY, SCALE_MAJOR + 1, 0);
    fixture[0][0].data0 = 255; fixture[0][0].data1 = 255;
    seq_engine_prepare_visits(visits); assert(seq_engine_get_effective_root(0) == 9);
    memset(visits, 0, sizeof(visits));
    visits[0].slots = 1; visits[0].events[0] = (struct track_event){
        .type = SONG_EVENT_HARMONY, .data0 = SONG_HARMONY_SCALE_KEEP,
        .data1 = SONG_HARMONY_ROOT_C + 4};
    int old_scale = seq_engine_get_effective_tonality(0, 2);
    seq_engine_resolve_harmony(visits);
    assert(seq_engine_get_effective_root(0) == 4);
    assert(seq_engine_get_effective_tonality(0, 2) == old_scale);
    visits[0].events[0].data0 = SCALE_CHROMATIC + 1;
    visits[0].events[0].data1 = SONG_HARMONY_ROOT_KEEP;
    seq_engine_resolve_harmony(visits);
    assert(seq_engine_get_effective_root(0) == 4);
    assert(seq_engine_get_effective_tonality(0, 0) == SCALE_CHROMATIC);
    assert(seq_engine_get_effective_tonality(0, 2) == SCALE_CHROMATIC);
    seq_engine_clear_internal_cc(); assert(seq_engine_get_effective_root(0) == SONG_ROOT_OFF);
    assert(!sestate.harmony_active);
}

static void test_note_delays(void) {
    struct seq_engine_step_visit visit={0};
    setup(); sestate.step_size[0]=96; visit.slots=7;
    for(int i=0;i<3;i++) visit.events[i]=(struct track_event){
        .type=SONG_EVENT_NOTE,.data0=60+i,.data1=100,.length=32,
        .delay=i==0?0:i==1?99:101};
    seq_engine_track_play_step(0,0,&visit);
    assert(output_count==1 && output[0].data0==60);
    for(int tick=1;tick<=96;tick++) {
        int before=output_count; seq_engine_track_manage_notes(0);
        if(tick==32) assert(output_count==before+2 && ((output[before].data0==61 && output[before].status==MIDI_NOTE_ON)||(output[before+1].data0==61 && output[before+1].status==MIDI_NOTE_ON)));
        else if(tick==64) assert(output_count==before+2 && ((output[before].data0==62 && output[before].status==MIDI_NOTE_ON)||(output[before+1].data0==62 && output[before+1].status==MIDI_NOTE_ON)));
        else if(tick==96) assert(output_count==before+1 && output[before].status==MIDI_NOTE_OFF);
        else assert(output_count==before);
    }
    for(int size=1;size<=384;size++) {
        assert(seq_utils_delay_ticks(99,size)==(size+1)/3);
        assert(seq_utils_delay_ticks(101,size)==(size*2+1)/3);
        assert(seq_utils_delay_ticks(96,size)==96);
    }
    setup(); visit.slots=1; visit.events[0].delay=99;
    sestate.step_size[0]=48;seq_engine_track_play_step(0,0,&visit);
    assert(!output_count && sestate.track_active_notes[0][15].start_delay_countdown==16);
    // Stealing an attack that has not sounded must not release another voice.
    for(int i=0;i<SEQ_ENGINE_MAX_NOTES;i++) seq_engine_track_play_step(0,0,&visit);
    assert(!output_count);
    seq_engine_track_stop_all_notes(0); assert(!output_count);
    for(int i=0;i<SEQ_ENGINE_MAX_NOTES;i++)
        assert(!sestate.track_active_notes[0][i].note.msg.status);
    // Shared relative delay is replaced, not added, by explicit Off.
    setup(); test_delay=99; sestate.step_size[0]=96; visit.slots=3;
    visit.events[0].delay=255; visit.events[1]=visit.events[0];
    visit.events[1].data0=72; visit.events[1].delay=0;
    seq_engine_track_play_step(0,0,&visit);
    assert(output_count==1 && output[0].data0==72);
    for(int tick=1;tick<=32;tick++) seq_engine_track_manage_notes(0);
    assert(output_count>=2);
    test_delay=0;
    // Inversion spans all onsets but keeps each slot's timing and velocity.
    setup(); sestate.step_size[0]=96; sestate.inversion[0]=1; visit.slots=7;
    for(int i=0;i<3;i++) visit.events[i]=(struct track_event){
        .type=SONG_EVENT_NOTE,.data0=60+4*i,.data1=80+i,.length=10+i,
        .delay=i==0?0:i==1?99:101};
    seq_engine_track_play_step(0,0,&visit);
    assert(output_count==1 && output[0].data0==72 && output[0].data1==80);
    for(int tick=1;tick<=32;tick++) seq_engine_track_manage_notes(0);
    assert(output[output_count-1].data0==64 && output[output_count-1].data1==81);
    for(int tick=33;tick<=64;tick++) seq_engine_track_manage_notes(0);
    assert(output[output_count-1].data0==68 && output[output_count-1].data1==82);
}
static void test_delayed_ratchets(void) {
    struct seq_engine_step_visit visit={.slots=1};
    setup(); test_ratchet=2; sestate.step_size[0]=96;
    visit.events[0]=(struct track_event){.type=SONG_EVENT_NOTE,.data0=60,
        .data1=100,.length=8,.delay=99};
    seq_engine_track_play_step(0,0,&visit); assert(!output_count);
    for(int tick=1;tick<=40;tick++) {
        int before=output_count; seq_engine_track_manage_notes(0);
        if(tick==32 || tick==36)
            assert(output_count==before+1 && output[before].status==MIDI_NOTE_ON);
        else if(tick==34 || tick==38)
            assert(output_count==before+1 && output[before].status==MIDI_NOTE_OFF);
        else assert(output_count==before);
    }
    // Zero/short stored lengths still produce balanced one-tick attacks.
    for(int len=0;len<=2;len++) {
        setup(); test_ratchet=8; sestate.gate_time[0]=0;
        visit.events[0].length=len; visit.events[0].delay=1;
        seq_engine_track_play_step(0,0,&visit);
        for(int tick=1;tick<=9;tick++) seq_engine_track_manage_notes(0);
        assert(output_count==16);
        for(int i=0;i<16;i++) assert(output[i].status==(i%2?MIDI_NOTE_OFF:MIDI_NOTE_ON));
    }
    // Muting or resetting cancels unheard attacks without releases.
    setup(); visit.events[0].delay=96;
    seq_engine_track_play_step(0,0,&visit);
    seq_engine_mute_select_changed(0,0,1);
    for(int i=0;i<100;i++) seq_engine_track_manage_notes(0);
    assert(!output_count);
    setup(); seq_engine_track_play_step(0,0,&visit);
    seq_engine_reset_all_tracks_pos();
    for(int i=0;i<100;i++) seq_engine_track_manage_notes(0);
    assert(!output_count);
}
static void test_pitch_ladder(void) {
    for(int mode=1;mode<=2;mode++) for(int ref=-24;ref<=24;ref++)
        for(int cur=-24;cur<=24;cur++) for(int dir=-1;dir<=1;dir+=2) {
            int v=seq_engine_pitch_choice(cur,ref,mode,dir);
            assert(v>=-24 && v<=24);
            if(v!=cur) {int d=((v-ref)%12+12)%12;assert(d==0 || (mode==2 && d==7));assert((v-cur)*dir>0);}
        }
    assert(seq_engine_pitch_choice(0,0,2,1)==7);
    assert(seq_engine_pitch_choice(0,0,2,-1)==-5);
    assert(seq_engine_pitch_choice(0,0,2,2)==12);
    assert(seq_engine_pitch_choice(5,5,1,1)==17);
    assert(seq_engine_pitch_choice(17,5,1,1)==17);
    assert(seq_engine_pitch_choice(5,5,1,-1)==-7);
    setup();transpose_writes=0;running=1;seq_engine_set_pitch_mode(2);
    seq_engine_adjust_pitch(0,1);assert(seq_engine_pitch_value(0,0)==7);
    seq_engine_adjust_pitch(0,1);assert(seq_engine_pitch_value(0,0)==12);
    seq_engine_apply_pitch(383);assert(!transpose_writes);
    seq_engine_apply_pitch(384);assert(transpose_writes==1 && written_transpose==12);
    assert(!seq_engine_pitch_pending(0));
    seq_engine_adjust_pitch(0,1);seq_engine_set_straight(0);assert(seq_engine_pitch_pending(0));
    seq_engine_set_pitch_mode(0);assert(!seq_engine_pitch_pending(0));
    seq_engine_set_pitch_mode(2);seq_engine_adjust_pitch(0,-1);
    seq_engine_clear_internal_cc();assert(!seq_engine_pitch_pending(0) && seq_engine_pitch_mode()==2);
    running=0;transpose_writes=0;seq_engine_adjust_pitch(0,1);
    assert(transpose_writes==1 && written_transpose==7);
    seq_engine_set_pitch_mode(0);
}
static void test_straight_timing(void) {
    test_pitch_ladder();
    static const int allowed[]={1,4,7,10,13,16};
    for(int current=0;current<23;current++) {
        for(int dir=-1;dir<=1;dir+=2) {
            int result=seq_engine_straight_choice(current,dir),found=0;
            for(int i=0;i<6;i++) found |= allowed[i]==result;
            assert(found);
        }
        assert(seq_engine_straight_choice(current,0)==current);
    }
    assert(seq_engine_straight_choice(17,1)==13); // 1/3 bar -> half note
    assert(seq_engine_straight_choice(17,-1)==10);
    assert(seq_engine_straight_choice(18,1)==10); // 1/5 bar -> quarter
    assert(seq_engine_straight_choice(18,-1)==7);
    assert(seq_engine_straight_choice(5,1)==7);
    assert(seq_engine_straight_choice(5,-1)==4);
    assert(seq_engine_straight_choice(4,3)==13);
    assert(seq_engine_straight_choice(4,1000)==16);
    setup(); timing_step[0]=timing_arp[0]=4; running=1;
    seq_engine_set_straight(1);
    seq_engine_adjust_timing(0,0,7); seq_engine_adjust_timing(0,1,10);
    assert(timing_step[0]==4 && timing_arp[0]==4);
    assert(seq_engine_timing_value(0,0,0)==7 && seq_engine_timing_pending(0,1));
    seq_engine_adjust_timing(0,0,10);
    seq_engine_adjust_timing(1,0,7); // multi-track batch
    for(int tick=1;tick<384;tick++) seq_engine_run(tick);
    assert(timing_step[0]==4 && timing_arp[0]==4);
    int position=sestate.step_pos[0];
    seq_engine_run(384);
    assert(timing_step[0]==10 && timing_step[1]==7 && timing_arp[0]==10);
    assert(sestate.step_size[0]==96 && sestate.clock_div_count[0]==1);
    assert(!seq_engine_timing_pending(0,0) && !seq_engine_timing_pending(0,1));
    assert(sestate.step_pos[0]!=position); // next step, not motion-start reset
    seq_engine_adjust_timing(0,0,13); seq_engine_adjust_timing(0,0,10);
    assert(!seq_engine_timing_pending(0,0)); // turn back cancels
    seq_engine_adjust_timing(0,0,13); seq_engine_set_straight(0);
    assert(!seq_engine_timing_pending(0,0) && timing_step[0]==10);
    seq_engine_set_straight(1); seq_engine_adjust_timing(0,0,7);
    seq_engine_run(0); assert(!seq_engine_timing_pending(0,0) && timing_step[0]==10);
    seq_engine_adjust_timing(0,0,7); sestate.scene_next=1; seq_engine_change_scene_synced();
    assert(!seq_engine_timing_pending(0,0) && seq_engine_straight_enabled());
    running=0; seq_engine_adjust_timing(0,0,7); assert(timing_step[0]==7);
    // Effective automated values retain priority over the committed stored edit.
    setup();running=1;seq_engine_set_straight(1);
    sestate.internal_cc[0][0]=5; sestate.internal_cc[0][10]=2;
    seq_engine_adjust_timing(0,0,7); seq_engine_adjust_timing(0,1,10);
    seq_engine_run(384); assert(timing_step[0]==7 && timing_arp[0]==10);
    assert(sestate.internal_cc[0][0]==5 && sestate.internal_cc[0][10]==2);
    assert(sestate.step_size[0]==seq_utils_step_len_to_ticks(5));
}
static void test_scene_gates(void) {
    for(int mask=0;mask<64;mask++) for(int scene=0;scene<6;scene++) {
        setup(); enabled[0]=1; sestate.clock_div_count[0]=0;
        sestate.scene_current=scene; sestate.scene_next=(scene+1)%6;
        sestate.bias_track_map[1]=0; sestate.conditions[0].history=1;
        uint32_t random=sestate.conditions[0].random;
        put(0,0,SONG_EVENT_CC,7,100);
        put(0,1,SONG_EVENT_SCENE,mask,0);
        put(0,2,SONG_EVENT_INTERNAL_CC,MIDI_CTRL_CC_TRACK_MUTE,127);
        put(0,3,SONG_EVENT_NOTE,64,100);
        put(0,4,SONG_EVENT_HARMONY,2,SONG_HARMONY_ROOT_C);
        struct seq_engine_step_visit visits[SEQ_NUM_TRACKS]={0};
        seq_engine_prepare_visits(visits);
        int pass=!!(mask&(1<<scene));
        assert(visits[0].slots==(pass?29:1));
        assert(sestate.internal_cc[1][2]==(pass?1:-1));
        assert(sestate.conditions[0].random==random && sestate.conditions[0].history==1);
        seq_engine_track_play_step(0,0,&visits[0]);
        assert(output_count==(pass?2:1)); // CC before gate always executes
        seq_engine_track_manage_notes(0);
        assert(output_count==(pass?3:1)); // Note Off remains independent
    }
}
int main(void) {
    test_scene_gates();
    test_straight_timing();
    test_delayed_ratchets();
    test_note_delays();
    test_harmony();
    test_root_offsets();
    test_mixed_and_cleanup();
    test_cycles_and_history();
    test_scene_activation();
    test_control_cycles();
    test_tick_loop();
    test_cross_track_tick();
    test_gated_bias_and_control();
    test_cross_track(5, 0, 0);
    test_cross_track(0, 5, 0);
    test_cross_track(5, 0, 1);
    test_cross_track(0, 5, 1);
    test_mask_mute_and_reset();
    puts("engine tests passed");
    return 0;
}
