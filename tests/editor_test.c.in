#include <assert.h>
#include <stdio.h>
#include <string.h>
#include "../src/gui/step_edit.c"
static struct track_event events[SEQ_TRACK_POLY];
static struct midi_msg output[32];
static int count, running, undo_captures, undo_busy, undo_cancelled;
static struct track_event undo_events[SEQ_TRACK_POLY];
int seq_engine_undo_capture(void) {if(undo_busy)return -1;undo_captures++;memcpy(undo_events,events,sizeof(events));return 0;}
void seq_engine_undo_cancel(void) {undo_cancelled++;}
int seq_ctrl_get_record_mode(void) {return SEQ_CTRL_RECORD_IDLE;}
int song_snapshot_idle(void) {return !undo_busy;}
static int bias_targets[SEQ_NUM_TRACKS] = {-1,-1,-1,-1,-1,-1};
static int target_lengths[SEQ_NUM_TRACKS] = {64,64,64,64,64,64};
static int current_scene;
int song_get_bias_track(int scene, int track) { return bias_targets[track]; }
/* Region tests use a 64-step store; other tests use the single 'events' step. */
static int region_mode, region_start=0, region_len=64, overlay[SEQ_NUM_STEPS], notices;
static struct track_event store[SEQ_NUM_STEPS][SEQ_TRACK_POLY];
static int store_delay[SEQ_NUM_STEPS];
int song_get_motion_length(int scene, int track) { return region_mode ? region_len : 64; }
int song_get_motion_start(int scene, int track) { return region_start; }
void gui_notice(const char *text) { notices++; }
int seq_engine_get_current_scene(void) { return current_scene; }
int seq_engine_get_effective_motion_length(int track) { return target_lengths[track]; }
static char rows[7][64];
static int details_visible;
void gui_step_details_set(int enable) {details_visible=enable;}
int seq_ctrl_get_run_state(void) { return running; }
int seq_ctrl_get_scene(void) { return 0; }
int seq_ctrl_get_first_track(void) { return 0; }
void panel_menu_set_mode(int mode) {}
void gui_grid_clear_overlay(void) {}
void gui_grid_set_overlay_enable(int enable) {}
void gui_grid_set_overlay_color(int step, int color) {overlay[step]=color;}
void gui_set_status_override(int enable) {}
int panel_menu_get_timeout(void) { return 100; }
int song_get_step_length(int scene, int track) { return 0; }
static int ratchet=1;
int song_get_ratchet_mode(int scene, int track, int step) { return ratchet; }
void song_set_ratchet_mode(int scene,int track,int step,int mode) {ratchet=mode;}
static int shared_delay, delay_writes;
int song_get_start_delay(int scene, int track, int step) { return region_mode ? store_delay[step] : shared_delay; }
void song_set_start_delay(int scene, int track, int step, int delay) {
    if(region_mode) store_delay[step]=delay; else shared_delay=delay; delay_writes++; }
int song_get_num_step_events(int scene, int track, int step) {
    int i, n = 0; for(i = 0; i < SEQ_TRACK_POLY; i ++) n += !!events[i].type;
    return n;
}
int song_get_step_event(int scene, int track, int step, int slot, struct track_event *e) {
    *e = region_mode ? store[step][slot] : events[slot]; return e->type ? 0 : -1;
}
int song_set_step_event(int scene, int track, int step, int slot, struct track_event *e) {
    if(region_mode) store[step][slot] = *e; else events[slot] = *e; return 0;
}
int song_add_step_event(int scene, int track, int step, struct track_event *e) {
    for(int i=0;i<SEQ_TRACK_POLY;i++) if(!events[i].type) {events[i]=*e; return 0;}
    return -1;
}
void song_clear_step(int scene,int track,int step) {memset(events,0,sizeof(events));}
void song_clear_step_event(int scene, int track, int step, int slot) {events[slot].type=0;}
int song_get_track_type(int track) {return SONG_TRACK_TYPE_VOICE;}
void gui_clear_status_text_all(void) { memset(rows, ' ', sizeof(rows)); }
void gui_set_status_text(int row, char *s) {
    assert(strlen(s) <= 28); snprintf(rows[row], sizeof(rows[row]), "%s", s);
}
void gui_set_status_text_part(int row, int pos, int width, char *s) {
    int len = strlen(s); assert(len <= width);
    memset(rows[row] + pos, ' ', width); memcpy(rows[row] + pos, s, len);
}
void gui_set_status_highlight_part(int row, int pos, int width, int mode) {}
void outproc_deliver_msg(int scene, int track, struct midi_msg *msg, int deliver, int mode) {
    assert(count < 32); output[count ++] = *msg;
}
void log_error(char *fmt, ...) { assert(!"unexpected error"); }
void log_warn(char *fmt, ...) { assert(!"unexpected warning"); }
static void setup(void) {
    int i; memset(&sedits, 0, sizeof(sedits));
    step_details_preference=details_visible=0;ratchet=1;
    memset(events, 0, sizeof(events)); count = running = undo_captures = undo_busy = 0;
    for(i = 0; i < SEQ_TRACK_POLY; i ++) sedits.playing_notes[i] = -1;
}
static void test_glide_editor(void) {
    setup();
    events[0]=(struct track_event){.type=SONG_EVENT_INTERNAL_CC,.data0=34,.data1=8};
    step_edit_adjust_note(1,0);
    assert(events[0].data0==35 && !strcmp(rows[0],"CCi 35: Glide Curve"));
    for(int c=0;c<128;c++) {
        events[0].data1=c; step_edit_adjust_velocity(0,0);
        char expected[64]; snprintf(expected,sizeof(expected),"CCi 35: Curve %d %s",c,
            c==64?"Linear":c<64?"Slow Start":"Fast Start");
        assert(!strcmp(rows[0],expected));
        assert(step_edit_adjust_cci_value(35,c,1)==(c==127?127:c+1));
        assert(step_edit_adjust_cci_value(35,c,-1)==(c==0?0:c-1));
        assert(midi_ctrl_internal_cc_to_value(35,c,64)==c);
    }
    assert(midi_ctrl_internal_cc_to_value(35,128,64)==-1);
    assert(midi_ctrl_internal_cc_to_value(35,-1,64)==-1);
    step_edit_adjust_note(1,0); assert(events[0].data0==35);
    step_edit_adjust_note(-1,0); assert(events[0].data0==34 && events[0].data1==8);
    assert(!count);
    setup(); events[0]=(struct track_event){.type=SONG_EVENT_INVERSION};
    step_edit_adjust_note(1,1);
    assert(events[0].type==SONG_EVENT_GLIDE && events[0].data0==4 && events[0].data1==64);
    for(int d=0;d<=8;d++) {
        events[0].data0=d; step_edit_adjust_note(0,0);
        char expected[64]; snprintf(expected,sizeof(expected),"Gli: Duration %s",glide_label(d));
        assert(!strcmp(rows[0],expected));
        for(int c=0;c<128;c++) {
            events[0].data1=c; step_edit_adjust_velocity(0,0);
            snprintf(expected,sizeof(expected),"Gli: Curve %d %s",c,
                c==64?"Linear":c<64?"Slow Start":"Fast Start");
            assert(!strcmp(rows[0],expected));
        }
    }
    step_edit_adjust_velocity(1,0); assert(events[0].data1==127);
    step_edit_adjust_velocity(-200,0); assert(events[0].data1==0);
    step_edit_adjust_note(-100,0); assert(events[0].data0==0);
    step_edit_adjust_note(100,0); assert(events[0].data0==8);
    assert(!count); step_edit_play_step(); assert(!count);
    events[0]=(struct track_event){.type=SONG_EVENT_INTERNAL_CC,.data0=29,.data1=100};
    step_edit_adjust_note(1,0); assert(events[0].data0==34 && events[0].data1==8);
    assert(!strcmp(rows[0],"CCi 34: Glide Duration"));
    for(int d=0;d<=8;d++) {
        events[0].data1=d; step_edit_adjust_velocity(0,0);
        char expected[64]; snprintf(expected,sizeof(expected),"CCi 34: Glide %s",glide_label(d));
        assert(!strcmp(rows[0],expected));
    }
    step_edit_adjust_velocity(-100,0); assert(events[0].data1==0);
    step_edit_adjust_velocity(100,0); assert(events[0].data1==8);
    step_edit_adjust_note(-1,0); assert(events[0].data0==29);
    assert(!count);
}
static void test_step_visit_undo(void) {
    setup(); running=1;
    events[0]=(struct track_event){.type=SONG_EVENT_NOTE,.data0=69,.data1=100,.length=24,.delay=255};
    events[1]=(struct track_event){.type=SONG_EVENT_SCENE,.data0=63};
    step_edit_set_enable(1);assert(undo_captures==1 && undo_events[0].data0==69);
    for(int i=0;i<4;i++) step_edit_adjust_note(-1,0);
    assert(events[0].data0==65 && undo_events[0].data0==69 && undo_captures==1);
    step_edit_adjust_velocity(-1,0);step_edit_adjust_gate_time(1,0);
    step_edit_adjust_start_delay(1,0);step_edit_adjust_ratchet_mode(1,0);
    step_edit_adjust_cursor(1,1); // select another slot, same transaction
    step_edit_toggle_scene(2);step_edit_adjust_note(1,1);step_edit_clear_step();
    assert(undo_captures==1 && undo_events[1].type==SONG_EVENT_SCENE && undo_events[1].data0==63);
    step_edit_adjust_cursor(0,0);step_edit_set_enable(1);assert(undo_captures==1); // audition not entry
    step_edit_adjust_cursor(1,0);assert(undo_captures==2 && sedits.step_pos==1);
    step_edit_adjust_cursor(-1,0);assert(undo_captures==3 && sedits.step_pos==0);
    step_edit_set_enable(0);step_edit_set_enable(1);assert(undo_captures==4);
    undo_busy=1;step_edit_adjust_cursor(1,0);assert(sedits.step_pos==0 && undo_captures==4);
    step_edit_clear_step();assert(undo_captures==4);
    undo_busy=0;sedits.edit_timeout=1;step_edit_timer_task();assert(!sedits.enable);
    step_edit_set_enable(1);assert(undo_captures==5);
    int data[1]={1};step_edit_handle_state_change(SCE_CTRL_FIRST_TRACK,data,1);assert(undo_captures==6);
    step_edit_handle_state_change(SCE_ENG_CURRENT_SCENE,data,1);assert(undo_captures==7);
    step_edit_set_enable(0);undo_busy=1;step_edit_set_enable(1);assert(!sedits.enable && undo_captures==7);
    // Undo the complete A-to-F edit through the captured fixture, not the last semitone.
    setup();running=1;events[0]=(struct track_event){.type=SONG_EVENT_NOTE,.data0=69,.data1=100};
    step_edit_set_enable(1);for(int i=0;i<4;i++) step_edit_adjust_note(-1,0);
    assert(events[0].data0==65);memcpy(events,undo_events,sizeof(events));assert(events[0].data0==69);
}
static void test_undo_preserves_editor(void) {
    setup(); running=1;
    events[0]=(struct track_event){.type=SONG_EVENT_NOTE,.data0=69,.data1=100};
    step_edit_set_enable(1);
    sedits.track=2;sedits.step_pos=7;sedits.event_pos=3;
    int captures=undo_captures;
    assert(step_edit_suspend_for_undo() && !sedits.enable);
    // The real engine delivers scene notifications while the editor is closed.
    int scene[1]={0};step_edit_handle_state_change(SCE_ENG_CURRENT_SCENE,scene,1);
    assert(!sedits.enable && undo_captures==captures);
    running=0;step_edit_resume_after_undo();
    assert(sedits.enable && sedits.track==2 && sedits.step_pos==7 && sedits.event_pos==3);
    assert(sedits.undo_captured && !count && undo_captures==captures);
    // Empty selected slot can be edited after undo; same entry checkpoint.
    running=1;step_edit_adjust_note(1,0);assert(undo_captures==captures);
    assert(step_edit_suspend_for_undo());step_edit_resume_after_undo();assert(undo_captures==captures);
    step_edit_set_enable(0);assert(!step_edit_suspend_for_undo());
}
static void test_group_transpose_notes_only(void) {
    const uint8_t controls[]={SONG_EVENT_PROBABILITY,SONG_EVENT_EUCLIDEAN,
        SONG_EVENT_CC,SONG_EVENT_INTERNAL_CC,SONG_EVENT_PROGCHG,SONG_EVENT_SCENE,
        SONG_EVENT_PRE,SONG_EVENT_NON_PRE,SONG_EVENT_HARMONY,SONG_EVENT_INVERSION,SONG_EVENT_GLIDE};
    for(unsigned type=0;type<sizeof(controls);type++) for(int shift=0;shift<2;shift++) {
        setup();running=1;sedits.event_pos=STEP_EDIT_EVENT_POS_ALL;
        events[0]=(struct track_event){.type=SONG_EVENT_NOTE,.data0=60,.data1=100,.length=24,.delay=99};
        events[1]=(struct track_event){.type=controls[type],.data0=2,.data1=1,.length=7,.delay=255};
        if(controls[type]==SONG_EVENT_PROBABILITY) events[1].data0=66;
        events[2]=events[0];events[2].data0=72;
        struct track_event saved[SEQ_TRACK_POLY];memcpy(saved,events,sizeof(saved));
        step_edit_adjust_note(1,shift);
        assert(events[0].data0==61 && events[2].data0==73);
        assert(!memcmp(&events[1],&saved[1],sizeof(events[1])));
        step_edit_adjust_note(-1,shift);
        assert(!memcmp(events,saved,sizeof(saved)));
        assert(!count);
        // A control-only step must also be untouched by group transpose.
        events[0].type=events[2].type=SONG_EVENT_NULL;memcpy(saved,events,sizeof(saved));
        step_edit_adjust_note(1,0);assert(!memcmp(events,saved,sizeof(saved)));
    }
    setup();running=1;sedits.event_pos=1;
    events[0]=(struct track_event){.type=SONG_EVENT_NOTE,.data0=60,.data1=100,.length=24};
    events[1]=(struct track_event){.type=SONG_EVENT_PROBABILITY,.data0=66};
    step_edit_adjust_note(1,0);assert(events[1].data0==67 && events[0].data0==60);
    step_edit_adjust_note(-1,0);assert(events[1].data0==66);
}
static void test_expanded_details(void) {
    setup(); sedits.enable=1; sedits.event_pos=-1;
    shared_delay=12;
    events[0]=(struct track_event){.type=SONG_EVENT_NOTE,.data0=60,.data1=96,.length=24,.delay=SEQ_START_DELAY_INHERIT};
    events[1]=(struct track_event){.type=SONG_EVENT_PROBABILITY,.data0=75};
    events[5]=(struct track_event){.type=SONG_EVENT_NOTE,.data0=67,.data1=88,.length=48,.delay=0};
    struct track_event saved[SEQ_TRACK_POLY];memcpy(saved,events,sizeof(saved));
    int captures=undo_captures;
    step_edit_toggle_details();
    assert(details_visible && step_details_preference && !count);
    assert(!strncmp(rows[2],"Note ",5) && !strncmp(rows[3],"Vel  ",5));
    assert(!strncmp(rows[4],"Gate ",5) && !strncmp(rows[5],"Dly  ",5));
    assert(undo_captures==captures && !memcmp(saved,events,sizeof(saved)));
    assert(!strncmp(rows[1]+9,"Prb",3) && !strncmp(rows[2]+9,"75%",3));
    assert(!strncmp(rows[3]+5,"96",2) && !strncmp(rows[3]+25,"88",2));
    assert(!strncmp(rows[5]+5,"Step",4) && !strncmp(rows[5]+25,"OFF",3));
    assert(!strncmp(rows[4]+9,"---",3) && !strncmp(rows[5]+9,"---",3));
    assert(strstr(rows[6],"Ratchet:1 Step delay:"));
    for(int adjustment=0;adjustment<4;adjustment++) {
        sedits.last_adjust_type=adjustment;step_edit_update_display();
        assert(!strncmp(rows[3]+5,"96",2));
        assert(!strncmp(rows[5]+5,"Step",4));
    }
    sedits.event_pos=5;step_edit_update_display();
    assert(!strncmp(rows[5]+25,"OFF",3));
    step_edit_set_enable(0);assert(!details_visible && step_details_preference);
    sedits.enable=1;step_edit_update_display();assert(details_visible);
    step_edit_toggle_details();assert(!details_visible && !step_details_preference);
    assert(!memcmp(saved,events,sizeof(saved)));
}

static void test_silent_ratchet_edit(void) {
    for(int expanded=0;expanded<2;expanded++) {
        setup();sedits.enable=1;sedits.event_pos=-1;
        step_details_preference=expanded;
        events[0]=(struct track_event){.type=SONG_EVENT_NOTE,.data0=60,.data1=96,.length=24};
        for(int mode=SEQ_RATCHET_MIN;mode<=SEQ_RATCHET_MAX;mode++) {
            ratchet=mode;
            step_edit_adjust_ratchet_mode(1,0);
            assert(ratchet==(mode==SEQ_RATCHET_MAX?mode:mode+1));
            assert(!count);
            if(expanded) {
                char expected[32];snprintf(expected,sizeof(expected),"Ratchet:%d Step delay:",ratchet);
                assert(strstr(rows[6],expected) && strlen(rows[6])<=28);
            }
            step_edit_adjust_ratchet_mode(-1,1);assert(!count);
            step_edit_adjust_ratchet_mode(0,0);assert(!count);
        }
        assert(undo_captures==1 && events[0].data0==60 && events[0].data1==96);
    }
}
static struct track_event N(int pitch,int vel,int len) {
    return (struct track_event){.type=SONG_EVENT_NOTE,.data0=pitch,.data1=vel,.delay=SEQ_START_DELAY_INHERIT,.length=len};
}
static void test_region_edit(void) {
    setup(); region_mode=1; memset(store,0,sizeof(store)); memset(store_delay,0,sizeof(store_delay));
    memset(overlay,0,sizeof(overlay)); notices=0;
    region_start=56; region_len=16;               /* wraps: steps 57..64, 1..8 */
    store[56][0]=N(60,100,24); store[56][1]=N(64,90,48);   /* chord, in region */
    store[3][0]=N(48,20,12);                               /* in region (wrapped) */
    store[3][1]=(struct track_event){.type=SONG_EVENT_CC,.data0=7,.data1=50};
    store[20][0]=N(72,100,24);                             /* outside region */
    store[60][0]=(struct track_event){.type=SONG_EVENT_PROBABILITY,.data0=50}; /* no notes */
    sedits.enable=1; sedits.event_pos=STEP_EDIT_EVENT_POS_ALL; sedits.step_pos=10;
    step_edit_adjust_cursor(-1,1);                 /* Shift + left: All -> Region */
    assert(sedits.event_pos==STEP_EDIT_EVENT_POS_REGION);
    step_edit_adjust_cursor(-1,1); assert(sedits.event_pos==STEP_EDIT_EVENT_POS_REGION); /* stops */
    assert(overlay[56]==GUI_OVERLAY_MED && overlay[7]==GUI_OVERLAY_MED && overlay[20]==0 && overlay[8]==0);
    assert(strstr(rows[0],"Region") && strstr(rows[0],"57~08"));
    assert(strstr(rows[1],"3 notes on 2 of 16 steps"));
    int before=undo_captures;
    step_edit_adjust_note(2,0);
    assert(store[56][0].data0==62 && store[56][1].data0==66 && store[3][0].data0==50);
    assert(store[20][0].data0==72 && store[3][1].data0==7 && store[60][0].data0==50);
    step_edit_adjust_velocity(-15,0);              /* single-step rule: 2 per detent, clamped */
    assert(store[56][0].data1==70 && store[56][1].data1==60 && store[3][0].data1==0);
    step_edit_adjust_gate_time(1,0);               /* single-step warp rule per note */
    assert(store[56][0].length==27 && store[56][1].length==53 && store[3][0].length==14);
    step_edit_adjust_start_delay(1,0);             /* only steps with notes */
    assert(store_delay[56]==seq_utils_delay_adjust(0,1,0) && store_delay[3]==store_delay[56]);
    assert(store_delay[60]==0 && store_delay[20]==0);
    assert(undo_captures==before+1);               /* one undo point for the region visit */
    /* Limits: values stop there, so a region can be levelled, then moved as one. */
    step_edit_adjust_note(200,0);
    assert(store[56][0].data0==127 && store[56][1].data0==127 && store[3][0].data0==127);
    step_edit_adjust_note(-60,0);
    assert(store[56][0].data0==67 && store[56][1].data0==67 && store[3][0].data0==67);
    step_edit_adjust_note(-200,0);
    assert(store[56][0].data0==0 && store[3][0].data0==0 && store[20][0].data0==72);
    step_edit_adjust_velocity(100,0);
    assert(store[56][0].data1==127 && store[56][1].data1==127 && store[3][0].data1==127);
    step_edit_adjust_velocity(-10,0);
    assert(store[56][0].data1==107 && store[56][1].data1==107 && store[3][0].data1==107);
    for(int k=0;k<200;k++) step_edit_adjust_gate_time(-1,0);
    assert(store[56][0].length==STEP_EDIT_SHORTEST_NOTE && store[56][1].length==STEP_EDIT_SHORTEST_NOTE);
    assert(store[3][0].length==STEP_EDIT_SHORTEST_NOTE);
    for(int k=0;k<400;k++) step_edit_adjust_gate_time(1,0);
    assert(store[56][0].length==STEP_EDIT_LONGEST_NOTE && store[3][0].length==STEP_EDIT_LONGEST_NOTE);
    for(int k=0;k<200;k++) step_edit_adjust_start_delay(1,0);
    assert(store_delay[56]==SEQ_START_DELAY_MAX && store_delay[3]==SEQ_START_DELAY_MAX);
    for(int k=0;k<200;k++) step_edit_adjust_start_delay(-1,0);
    assert(store_delay[56]==0 && store_delay[3]==0 && store_delay[60]==0);
    assert(!notices && undo_captures==before+1);
    int r=ratchet; step_edit_adjust_ratchet_mode(1,0); assert(ratchet==r);
    step_edit_clear_step(); assert(store[56][0].type==SONG_EVENT_NOTE);
    assert(!count);                                /* no audition in region mode */
    step_edit_adjust_cursor(1,1);                  /* Shift + right: back to All */
    assert(sedits.event_pos==STEP_EDIT_EVENT_POS_ALL && overlay[57]==0 && overlay[10]==GUI_OVERLAY_HIGH);
    step_edit_adjust_cursor(-1,1); step_edit_adjust_cursor(1,0); /* stepping leaves region */
    assert(sedits.event_pos==STEP_EDIT_EVENT_POS_ALL && sedits.step_pos==11);
    region_mode=0; region_start=0; region_len=64;
}
int main(void) {
    test_region_edit();
    test_silent_ratchet_edit();
    test_expanded_details();
    test_group_transpose_notes_only();
    test_undo_preserves_editor();
    test_step_visit_undo();
    setup();sedits.enable=1;events[0]=(struct track_event){.type=SONG_EVENT_NOTE,.data0=60,.data1=100};
    undo_busy=1;step_edit_clear_step();assert(events[0].type==SONG_EVENT_NOTE && !undo_captures);
    undo_busy=0;step_edit_clear_step();assert(!events[0].type && undo_captures==1);
    setup();sedits.enable=1;step_edit_clear_recording_notes();
    struct midi_msg chord={.status=MIDI_NOTE_ON,.data0=60,.data1=100};
    step_edit_handle_input(&chord);chord.data0=64;step_edit_handle_input(&chord);
    assert(undo_captures==1); // one whole chord replacement, not per note
    chord.status=MIDI_NOTE_OFF;step_edit_handle_input(&chord);chord.data0=60;step_edit_handle_input(&chord);
    chord.status=MIDI_NOTE_ON;step_edit_handle_input(&chord);assert(undo_captures==1); // same step visit
    setup(); sedits.enable=1; events[0].type=SONG_EVENT_PROGCHG;
    step_edit_adjust_note(1,1);
    assert(events[0].type==SONG_EVENT_SCENE && step_edit_scene_mask()==63);
    for(int mask=0;mask<64;mask++) {
        events[0].data0=mask; step_edit_update_display();
        for(int pair=0;pair<3;pair++) assert(rows[2][3+pair]==1+((mask>>(pair*2))&3));
        assert(strlen(rows[0])<=28 && strstr(rows[0],"Keys toggle"));
        for(int scene=0;scene<6;scene++) {
            step_edit_toggle_scene(scene); assert(step_edit_scene_mask()==(mask^(1<<scene)));
            step_edit_toggle_scene(scene); assert(step_edit_scene_mask()==mask);
        }
    }
    assert(!count); step_edit_adjust_note(1,0); step_edit_adjust_velocity(1,0); assert(!count);
    sedits.event_pos=-1; assert(step_edit_scene_mask()==-1);
    step_edit_toggle_scene(0); assert(events[0].data0==63);
    sedits.event_pos=0; sedits.enable=0; assert(step_edit_scene_mask()==-1);
    test_glide_editor();
    int i;
    static const uint8_t types[] = {SONG_EVENT_NOTE, SONG_EVENT_CC,
        SONG_EVENT_INTERNAL_CC, SONG_EVENT_PROGCHG, SONG_EVENT_SCENE, SONG_EVENT_PROBABILITY,
        SONG_EVENT_EUCLIDEAN, SONG_EVENT_PRE, SONG_EVENT_NON_PRE, SONG_EVENT_HARMONY, SONG_EVENT_INVERSION, SONG_EVENT_GLIDE};
    {
        char label[16];
        assert(SEQ_UTILS_CLOCK_24PPQ == 8);
        assert(seq_utils_clock_pqq_to_divisor(SEQ_UTILS_CLOCK_24PPQ) == 4);
        assert(seq_utils_clock_pqq_to_divisor(SEQ_UTILS_CLOCK_16PPQ) == 6);
        panel_utils_clock_ppq_to_str(label, SEQ_UTILS_CLOCK_16PPQ);
        assert(!strcmp(label, "16 PPQ"));
    }
    setup(); events[0].type = SONG_EVENT_NOTE;
    for(i = 1; i <= 12; i ++) {
        step_edit_adjust_note(1, 1);
        assert(events[0].type == types[i % 12]);
    }
    for(i = 11; i >= 0; i --) {
        step_edit_adjust_note(-1, 1); assert(events[0].type == types[i]);
    }
    events[0] = (struct track_event){.type = SONG_EVENT_PROBABILITY, .data0 = 50};
    step_edit_adjust_note(100, 0); assert(events[0].data0 == 100);
    assert(!memcmp(rows[2] + 3, "100%", 4));
    step_edit_adjust_note(-200, 0); assert(events[0].data0 == 0);
    events[0] = (struct track_event){.type = SONG_EVENT_EUCLIDEAN, .data0 = 27, .data1 = 7};
    step_edit_adjust_note(-27, 0);
    assert(events[0].data0 == 0 && events[0].data1 == 1);
    assert(!memcmp(rows[2] + 3, "1:2", 3));
    step_edit_adjust_velocity(100, 0); assert(events[0].data1 == 1);
    step_edit_adjust_velocity(-100, 0); assert(events[0].data1 == 0);
    events[0].data0 = 27;
    step_edit_adjust_velocity(1, 0); assert(events[0].data1 == 1);
    step_edit_adjust_velocity(1, 0); assert(events[0].data1 == 2);
    step_edit_adjust_velocity(-1, 0); assert(events[0].data1 == 1);
    // Preview deliberately ignores false and true gates, but not normal MIDI.
    setup();
    events[0] = (struct track_event){.type = SONG_EVENT_PROBABILITY, .data0 = 0};
    events[1] = (struct track_event){.type = SONG_EVENT_NOTE, .data0 = 60, .data1 = 100, .length = 1};
    events[2] = (struct track_event){.type = SONG_EVENT_PRE};
    events[3] = (struct track_event){.type = SONG_EVENT_CC, .data0 = 7, .data1 = 99};
    events[4] = (struct track_event){.type = SONG_EVENT_NON_PRE};
    events[5] = (struct track_event){.type = SONG_EVENT_PROGCHG, .data0 = 11};
    step_edit_play_step();
    assert(count == 3 && output[0].status == MIDI_NOTE_ON);
    assert(output[1].status == MIDI_CONTROL_CHANGE && output[2].status == MIDI_PROGRAM_CHANGE);
    step_edit_run(1); assert(count == 4 && output[3].status == MIDI_NOTE_OFF);
    running = 1; step_edit_play_step(); assert(count == 4);
    step_edit_update_display(); assert(count == 4);
    setup(); sedits.enable = 1; sedits.event_pos = -1;
    events[0] = (struct track_event){.type = SONG_EVENT_INTERNAL_CC, .data0 = 16, .data1 = 64};
    step_edit_adjust_cursor(1, 1);
    assert(!strcmp(rows[0], "CCi 16: Step length"));
    for(int cc = 16; cc <= 29; cc++) {
        char expected[64];
        events[0].data0 = cc; step_edit_adjust_note(0, 0);
        snprintf(expected, sizeof(expected), "CCi %d: %s", cc, step_edit_cci_name(cc));
        assert(!strcmp(rows[0], expected));
        assert(sedits.cci_hint_timeout == 2000 && !count);
    }
    sedits.edit_timeout = 10000;
    for(int tick = 0; tick < 1999; tick++) step_edit_timer_task();
    assert(!strcmp(rows[0], "CCi 29: Euclidean rotation"));
    char lower[3][64]; memcpy(lower, rows + 1, sizeof(lower));
    step_edit_timer_task();
    assert(!strcmp(rows[0], "Edit - Track:  1 Step:  1"));
    assert(!memcmp(lower, rows + 1, sizeof(lower)) && !count);
    step_edit_adjust_note(-1, 0); assert(!strcmp(rows[0], "CCi 28: Euclidean density"));
    step_edit_adjust_cursor(1, 1);
    assert(!sedits.cci_hint_timeout && !strcmp(rows[0], "Edit - Track:  1 Step:  1"));
    assert(!step_edit_cci_name(15) && !step_edit_cci_name(30));
    for(int cc = 16; cc <= 29; cc++)
        for(int raw = 0; raw <= 127; raw++) {
            char decoded[64]; step_edit_cci_value_title(decoded, cc, raw);
            assert(strlen(decoded) <= 28);
        }
    { char decoded[64];
      step_edit_cci_value_title(decoded, 17, 64); assert(!strcmp(decoded, "CCi 17: Transpose +0 semis"));
      step_edit_cci_value_title(decoded, 17, 0); assert(!strcmp(decoded, "CCi 17: Transpose -24 semis"));
      step_edit_cci_value_title(decoded, 18, 63); assert(!strcmp(decoded, "CCi 18: Mute Off"));
      step_edit_cci_value_title(decoded, 18, 64); assert(!strcmp(decoded, "CCi 18: Mute On"));
      step_edit_cci_value_title(decoded, 19, 127); assert(!strcmp(decoded, "CCi 19: Start 64"));
      step_edit_cci_value_title(decoded, 22, 64); assert(!strcmp(decoded, "CCi 22: Gate time 101%"));
      step_edit_cci_value_title(decoded, 27, 127); assert(!strcmp(decoded, "CCi 27: Arp gate 384 ticks"));
      step_edit_cci_value_title(decoded, 28, 127); assert(!strcmp(decoded, "CCi 28: 100% No Bias target"));
    }
    sedits.event_pos = 0; events[0] = (struct track_event){.type = SONG_EVENT_INTERNAL_CC, .data0 = 18, .data1 = 62};
    step_edit_adjust_velocity(1, 0);
    assert(events[0].data1 == 64 && !strcmp(rows[0], "CCi 18: Mute On") && !count);
    sedits.edit_timeout = 10000;
    for(int tick = 0; tick < 2000; tick++) step_edit_timer_task();
    assert(!strcmp(rows[0], "Edit - Track:  1 Step:  1"));
    // Every detent crosses exactly one distinct conversion bucket.
    for(int cc = 16; cc <= 28; cc++)
        for(int raw = 0; raw <= 127; raw++)
            for(int dir = -1; dir <= 1; dir += 2) {
                int old = midi_ctrl_internal_cc_to_value(cc, raw, 64);
                int next = step_edit_adjust_cci_value(cc, raw, dir);
                int decoded = midi_ctrl_internal_cc_to_value(cc, next, 64);
                assert(next >= 0 && next <= 127);
                int scan = raw + dir;
                while(scan >= 0 && scan <= 127 && midi_ctrl_internal_cc_to_value(cc, scan, 64) == old) scan += dir;
                if(scan < 0 || scan > 127) assert(next == raw);
                else assert(decoded == midi_ctrl_internal_cc_to_value(cc, scan, 64) && decoded != old);
            }
    assert(step_edit_adjust_cci_value(18, 0, 1) == 64);
    assert(step_edit_adjust_cci_value(18, 127, -1) == 0);
    assert(step_edit_adjust_cci_value(17, 0, 1) == 18); // -24 -> -23
    assert(step_edit_adjust_cci_value(17, 64, 1) == 66);
    assert(step_edit_adjust_cci_value(29, 64, 1) == 66);
    assert(step_edit_adjust_cci_value(29, 0, -1) == 0);
    assert(step_edit_adjust_cci_value(29, 126, 1) == 127);
    assert(step_edit_adjust_cci_value(29, 127, -1) == 125);
    for(int cc = 16; cc <= 28; cc++) {
        int raw = 0, visits = 1;
        while(step_edit_adjust_cci_value(cc, raw, 1) != raw) { raw = step_edit_adjust_cci_value(cc, raw, 1); visits++; assert(visits <= 128); }
        assert(step_edit_adjust_cci_value(cc, 0, 128) == raw);
        while(step_edit_adjust_cci_value(cc, raw, -1) != raw) raw = step_edit_adjust_cci_value(cc, raw, -1);
        assert(raw == 0);
    }
    { char text[64];
      step_edit_cci_value_title(text, 22, 127); assert(!strcmp(text, "CCi 22: Gate time 200%"));
      step_edit_cci_value_title(text, 25, 0); assert(!strcmp(text, "CCi 25: Arp type Up 1"));
      step_edit_cci_value_title(text, 25, 127); assert(!strcmp(text, "CCi 25: Arp type Random 4"));
    }
    events[0] = (struct track_event){.type = SONG_EVENT_CC, .data0 = 18, .data1 = 0};
    step_edit_adjust_velocity(1, 0); assert(events[0].data1 == 2);
    events[0].type = SONG_EVENT_INTERNAL_CC; events[0].data1 = 0;
    step_edit_adjust_velocity(1, 0); assert(events[0].data1 == 64);
    step_edit_adjust_velocity(-1, 0); assert(events[0].data1 == 0);
    { char title[64];
      step_edit_cci_value_title(title, 29, 127);
      assert(!strcmp(title, "CCi 29: No Bias target"));
      bias_targets[0] = 0; // self is not a receiving track
      bias_targets[1] = bias_targets[4] = 0;
      target_lengths[1] = 64; target_lengths[4] = 16;
      step_edit_cci_value_title(title, 29, 127);
      assert(!strcmp(title, "CCi 29: T2 Rot 63/64"));
      for(int len = 1; len <= 64; len++) {
          target_lengths[1] = len;
          for(int raw = 0; raw <= 127; raw++) {
              char expected[64];
              snprintf(expected, sizeof(expected), "CCi 29: T2 Rot %d/%d", (raw * len) / 128, len);
              step_edit_cci_value_title(title, 29, raw);
              assert(!strcmp(title, expected) && strlen(title) <= 28);
          }
      }
      events[0] = (struct track_event){.type = SONG_EVENT_INTERNAL_CC, .data0 = 29, .data1 = 126};
      target_lengths[1] = 64; step_edit_adjust_velocity(1, 0);
      assert(events[0].data1 == 127 && !strcmp(rows[0], "CCi 29: T2 Rot 63/64"));
      char lower[3][64]; memcpy(lower, rows + 1, sizeof(lower));
      target_lengths[1] = 16; sedits.edit_timeout = 10000;
      for(int tick = 0; tick < 100; tick++) step_edit_timer_task();
      assert(!strcmp(rows[0], "CCi 29: T2 Rot 15/16"));
      assert(!memcmp(lower, rows + 1, sizeof(lower)) && !count);
      bias_targets[1] = -1; step_edit_cci_value_title(title, 29, 127);
      assert(!strcmp(title, "CCi 29: T5 Rot 15/16"));
      current_scene = 1; step_edit_cci_value_title(title, 29, 127);
      assert(!strcmp(title, "CCi 29: T5 Rot 63/64"));
    }
    { char title[64];
      current_scene = 0; bias_targets[1] = 0;
      for(int len = 1; len <= 64; len++) {
          target_lengths[1] = len;
          for(int raw = 0; raw < 128; raw++) {
              int percent = midi_ctrl_internal_cc_to_value(28, raw, len);
              char expected[64];
              if(percent == 100) snprintf(expected, sizeof(expected), "CCi 28: T2 100%% Pattern");
              else snprintf(expected, sizeof(expected), "CCi 28: T2 %d%% %d/%d", percent, (percent * len + 50) / 100, len);
              step_edit_cci_value_title(title, 28, raw);
              assert(!strcmp(title, expected) && strlen(title) <= 28);
          }
      }
      events[0] = (struct track_event){.type = SONG_EVENT_INTERNAL_CC, .data0 = 28, .data1 = 64};
      target_lengths[1] = 16; step_edit_adjust_velocity(0, 0);
      assert(!strcmp(rows[0], "CCi 28: T2 50% 8/16"));
      target_lengths[1] = 32; sedits.edit_timeout = 10000;
      for(int tick = 0; tick < 100; tick++) step_edit_timer_task();
      assert(!strcmp(rows[0], "CCi 28: T2 50% 16/32"));
    }
    setup(); sedits.event_pos = 0;
    events[0] = (struct track_event){.type = SONG_EVENT_HARMONY, .data0 = SCALE_MAJOR + 1, .data1 = SONG_HARMONY_ROOT_KEEP};
    step_edit_update_display(); assert(!strcmp(rows[0], "Hrm: Major / Keep"));
    assert(!memcmp(rows[1] + 3, "Hrm", 3));
    step_edit_adjust_velocity(1, 0);
    assert(events[0].data1 == SONG_HARMONY_ROOT_OFF && !strcmp(rows[0], "Hrm: Major / Off"));
    step_edit_adjust_velocity(1, 0);
    assert(events[0].data1 == SONG_HARMONY_ROOT_C && !strcmp(rows[0], "Hrm: Major / C"));
    step_edit_adjust_velocity(100, 0); assert(events[0].data1 == SONG_HARMONY_ROOT_MAX);
    step_edit_adjust_note(100, 0); assert(events[0].data0 == SONG_HARMONY_SCALE_MAX);
    step_edit_adjust_note(-100, 0); assert(events[0].data0 == SONG_HARMONY_SCALE_KEEP);
    assert(!strcmp(rows[0], "Hrm: Keep / B"));
    step_edit_adjust_note(1, 0); assert(events[0].data0 == 1);
    assert(!strcmp(rows[0], "Hrm: Chromatic / B"));
    step_edit_play_step(); assert(!count); // Hrm preview is inert
    for(int scale = 0; scale <= SONG_HARMONY_SCALE_MAX; scale++)
        for(int root = 0; root <= SONG_HARMONY_ROOT_MAX; root++) {
            events[0].data0 = scale; events[0].data1 = root;
            step_edit_update_display(); assert(strlen(rows[0]) <= 28);
        }
    setup(); sedits.event_pos = 0; events[0].type = SONG_EVENT_INVERSION;
    step_edit_adjust_note(100, 0); assert(events[0].data0 == 5);
    step_edit_adjust_velocity(1, 0); assert(events[0].data1 == 1);
    assert(!strcmp(rows[0], "Inv: 5 Compact On"));
    step_edit_adjust_note(-100, 0); step_edit_adjust_velocity(-1, 0);
    assert(!strcmp(rows[0], "Inv: 0 Compact Off"));
    step_edit_play_step(); assert(!count);
    setup(); sedits.event_pos = STEP_EDIT_EVENT_POS_ALL;
    shared_delay = 96; delay_writes = 0;
    for(i=0;i<6;i++) events[i]=(struct track_event){.type=SONG_EVENT_NOTE,.delay=255};
    step_edit_adjust_start_delay(1,0);
    assert(shared_delay==97 && delay_writes==1);
    assert(!memcmp(rows[3]+3,"s1/8",4));
    sedits.event_pos=2; step_edit_adjust_start_delay(1,0);
    assert(events[2].delay==0 && shared_delay==97 && delay_writes==1);
    step_edit_adjust_start_delay(-1,0); assert(events[2].delay==255);
    assert(!memcmp(rows[3]+11,"Step",4));
    events[2].delay=96; step_edit_adjust_start_delay(3,0);
    assert(events[2].delay==99 && events[1].delay==255);
    assert(!memcmp(rows[3]+11,"s1/3",4));
    // All relative labels and inherit fit every four-character slot.
    for(int code=97;code<=103;code++) {
        for(i=0;i<6;i++) events[i].delay=code;
        sedits.event_pos=0; step_edit_update_display();
        for(i=0;i<6;i++) assert(!memcmp(rows[3]+3+4*i,seq_utils_delay_relative_label(code),4));
    }
    // Deleted-slot payload must not become a new Note override.
    setup(); sedits.event_pos=0; events[0].delay=99;
    step_edit_adjust_note(1,0); assert(events[0].type==SONG_EVENT_NOTE && events[0].delay==255);
    setup(); step_edit_clear_recording_notes(); sedits.enable=1; events[0]=(struct track_event){.type=SONG_EVENT_NOTE,.delay=103};
    struct midi_msg input={.status=MIDI_NOTE_ON,.data0=64,.data1=90};
    step_edit_handle_input(&input); assert(events[0].type==SONG_EVENT_NOTE && events[0].delay==255);
    events[0].type=SONG_EVENT_GLIDE; events[0].delay=99; sedits.event_pos=0;
    step_edit_adjust_note(1,1); assert(events[0].type==SONG_EVENT_NOTE && events[0].delay==255);
    puts("editor tests passed"); return 0;
}
