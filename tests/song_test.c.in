#include <assert.h>
#include <stdio.h>
#include <string.h>
#include "../src/seq/song.c"
static uint8_t flash[EXT_FLASH_SONG_SIZE];
static int flash_state, loaded;
int ext_flash_get_state_for(uint8_t *owner) { return flash_state; }
int ext_flash_save(int32_t address, int length, uint8_t *data) {
    assert(length == sizeof(flash)); memcpy(flash, data, length);
    flash_state = EXT_FLASH_STATE_SAVE_DONE; return 0;
}
int ext_flash_load(int32_t address, int length, uint8_t *data) {
    assert(length == sizeof(flash)); memcpy(data, flash, length);
    flash_state = EXT_FLASH_STATE_LOAD_DONE; return 0;
}
void state_change_fire0(int event) {}
void state_change_fire1(int event, int value) { if(event == SCE_SONG_LOADED) loaded ++; }
void state_change_fire2(int event, int a, int b) {}
void state_change_fire3(int event, int a, int b, int c) {}
void log_error(char *fmt, ...) { fprintf(stderr, "%s\n", fmt); assert(!"unexpected error"); }
int main(void) {
    struct track_event expected[6], actual;
    int i;
    memset(&song, 0, sizeof(song));
    song.magic_num = SONG_MAGIC_NUM;
    song_set_version_to_current();
    for(i = 0; i < SEQ_NUM_TRACKS; i ++) {
        song.trkscene[0][i].motion_len = 64;
        song.trkscene[0][i].gate_time = 128;
        song.trkscene[0][i].bias_track = SONG_TRACK_BIAS_NULL;
        song.trkscene[0][i].arp_gate_time = 24;
    }
    for(i = 0; i < 6; i ++) {
        expected[i] = (struct track_event){.type = i < 4 ? 2 + i : SONG_EVENT_NOTE,
            .data0 = i == 0 ? 100 : i == 1 ? 27 : i == 4 ? 60 : 70,
            .data1 = i == 1 ? 7 : 100, .length = i < 4 ? 0 : 24};
        assert(!song_set_step_event(0, 0, 0, i, &expected[i]));
    }
    song_init_roots();
    assert(song_get_effective_root(0) == SONG_ROOT_OFF);
    song_set_root(2);
    assert(song_get_effective_root(0) == 2);
    song_set_scene_root(0, 6);
    song_set_scene_root(2, SONG_ROOT_OFF);
    assert(song_get_effective_root(0) == 6 && song_get_effective_root(2) == SONG_ROOT_OFF);
    song_copy_scene(3, 0);
    assert(song_get_scene_root(3) == 6);
    assert(!song_save(0)); song_timer_task();
    memset(&song, 0, sizeof(song));
    assert(!song_load(0)); song_timer_task(); assert(loaded == 1);
    assert(song_get_root() == 2 && song_get_scene_root(0) == 6);
    for(i = 0; i < 6; i ++) {
        assert(!song_get_step_event(0, 0, 0, i, &actual));
        assert(actual.type == expected[i].type && actual.data0 == expected[i].data0);
        assert(actual.data1 == expected[i].data1 && actual.length == expected[i].length);
        // Production get/set is the slot-copy primitive.
        assert(!song_set_step_event(0, 1, 5, i, &actual));
        assert(!song_get_step_event(0, 1, 5, i, &actual));
        assert(actual.type == expected[i].type && actual.data0 == expected[i].data0);
    }
    song_copy_scene(1, 0);
    assert(!song_get_step_event(1, 0, 0, 0, &actual));
    assert(actual.type == SONG_EVENT_PROBABILITY); // notes shared per song
    // Old songs migrate added parameters, without altering existing event codes.
    song.song_version = 0x0001001e;
    for(int t=0;t<6;t++) for(int s=0;s<64;s++) for(int p=0;p<6;p++)
        song.trkevents[t][s][p].delay=(t+s+p)%255;
    song.root = 11; memset(song.scene_root, 11, sizeof(song.scene_root));
    song_init_scene_midi_programs(); song_init_euclidean();
    assert(!song_save(0)); song_timer_task();
    memset(&song, 0, sizeof(song));
    assert(!song_load(0)); song_timer_task();
    assert(song.song_version == CARBON_VERSION_MAJMIN && loaded == 2);
    assert(song_get_root() == SONG_ROOT_OFF);
    for(i = 0; i < SEQ_NUM_SCENES; i ++) assert(song_get_scene_root(i) == SONG_ROOT_INHERIT);
    assert(!song_get_step_event(0, 0, 0, 4, &actual));
    assert(actual.type == SONG_EVENT_NOTE && actual.data0 == 60);
    assert(actual.delay==SEQ_START_DELAY_INHERIT);
    for(int t=0;t<6;t++) for(int s=0;s<64;s++) for(int p=0;p<6;p++)
        assert(song.trkevents[t][s][p].delay==SEQ_START_DELAY_INHERIT);
    actual.delay=104; assert(song_set_step_event(0,0,0,4,&actual)==-1);
    assert(song_add_step_event(0,0,0,&actual)==-1);
    assert(song.trkevents[0][0][4].delay==SEQ_START_DELAY_INHERIT);
    actual.delay=99; assert(!song_set_step_event(0,0,0,4,&actual));
    assert(!song_save(0));song_timer_task();assert(!song_load(0));song_timer_task();
    assert(!song_get_step_event(0,0,0,4,&actual) && actual.delay==99);
    assert(!song_set_step_event(0,2,10,1,&actual));
    assert(!song_get_step_event(5,2,10,1,&actual) && actual.delay==99);
    actual.type=SONG_EVENT_CC; actual.delay=42;
    assert(!song_set_step_event(0,2,10,1,&actual));
    assert(!song_get_step_event(0,2,10,1,&actual) && actual.delay==255);
    for(int version = 27; version <= 30; version++) {
        song.song_version = (1u << 16) | version;
        song.root = 11; memset(song.scene_root, 11, sizeof(song.scene_root));
        assert(!song_save(0)); song_timer_task();
        assert(!song_load(0)); song_timer_task();
        assert(song_get_root() == SONG_ROOT_OFF);
        for(i = 0; i < 6; i++) assert(song_get_scene_root(i) == SONG_ROOT_INHERIT);
    }
    song_set_root(6); song_set_scene_root(0, 2); song_clear();
    assert(song_get_root() == SONG_ROOT_OFF);
    for(i = 0; i < 6; i++) assert(song_get_scene_root(i) == SONG_ROOT_INHERIT);
    expected[0] = (struct track_event){.type = SONG_EVENT_HARMONY,
        .data0 = 15, .data1 = SONG_HARMONY_ROOT_MAX};
    song_set_step_event(0, 0, 0, 0, &expected[0]);
    assert(!song_save(0)); song_timer_task();
    memset(&song, 0, sizeof(song));
    assert(!song_load(0)); song_timer_task();
    assert(!song_get_step_event(0, 0, 0, 0, &actual));
    assert(actual.type == SONG_EVENT_HARMONY && actual.data0 == 15 && actual.data1 == 13);
    song_copy_scene(1, 0);
    assert(!song_get_step_event(1, 0, 0, 0, &actual) && actual.type == SONG_EVENT_HARMONY);
    actual = (struct track_event){.type = SONG_EVENT_INVERSION, .data0 = 5, .data1 = 1};
    song_set_step_event(0, 0, 0, 0, &actual);
    song_save(0); song_timer_task(); memset(&song, 0, sizeof(song));
    song_load(0); song_timer_task(); song_get_step_event(0, 0, 0, 0, &actual);
    assert(actual.type == SONG_EVENT_INVERSION && actual.data0 == 5 && actual.data1 == 1);
    actual=(struct track_event){.type=SONG_EVENT_GLIDE,.data0=8,.data1=127};
    assert(!song_set_step_event(0,0,0,0,&actual));
    actual.data0=9; assert(song_set_step_event(0,0,0,0,&actual)==-1);
    actual.data0=8; actual.data1=128; assert(song_add_step_event(0,0,0,&actual)==-1);
    actual=(struct track_event){.type=SONG_EVENT_INTERNAL_CC,.data0=34,.data1=8};
    assert(!song_set_step_event(0,0,0,1,&actual));
    actual.data1=9; assert(song_set_step_event(0,0,0,1,&actual)==-1);
    assert(!song_save(0)); song_timer_task(); memset(&song,0,sizeof(song));
    assert(!song_load(0)); song_timer_task();
    assert(!song_get_step_event(0,0,0,0,&actual));
    assert(actual.type==SONG_EVENT_GLIDE && actual.data0==8 && actual.data1==127);
    assert(!song_get_step_event(0,0,0,1,&actual));
    assert(actual.type==SONG_EVENT_INTERNAL_CC && actual.data0==34 && actual.data1==8);
    actual=(struct track_event){.type=SONG_EVENT_INTERNAL_CC,.data0=35,.data1=127};
    assert(!song_set_step_event(0,0,0,2,&actual));
    assert(!song_save(0)); song_timer_task(); memset(&song,0,sizeof(song));
    assert(!song_load(0)); song_timer_task();
    assert(!song_get_step_event(0,0,0,2,&actual));
    assert(actual.type==SONG_EVENT_INTERNAL_CC && actual.data0==35 && actual.data1==127);
    for(int mask=0;mask<64;mask++) {
        actual=(struct track_event){.type=SONG_EVENT_SCENE,.data0=mask};
        assert(!song_set_step_event(0,0,0,3,&actual));
        assert(!song_save(0));song_timer_task();memset(&song,0,sizeof(song));
        assert(!song_load(0));song_timer_task();
        assert(!song_get_step_event(5,0,0,3,&actual));
        assert(actual.type==SONG_EVENT_SCENE && actual.data0==mask);
    }
    actual.data0=64;assert(song_set_step_event(0,0,0,3,&actual)==-1);
    assert(song_add_step_event(0,0,0,&actual)==-1);
    actual.data0=63;actual.data1=1;assert(song_set_step_event(0,0,0,3,&actual)==-1);
    assert(!song_snapshot_available());
    assert(!song_snapshot_capture());
    struct song_data expected_snapshot=song;
    song.tempo=200; memset(song.trkevents,0,sizeof(song.trkevents));
    assert(!song_snapshot_restore());assert(!memcmp(&song,&expected_snapshot,sizeof(song)));
    song.tempo=180; assert(!song_snapshot_restore()); assert(song.tempo==expected_snapshot.tempo);
    songs.state=SONG_IO_STATE_SAVE;
    assert(song_snapshot_capture()==-1 && song_snapshot_restore()==-1);
    songs.state=SONG_IO_STATE_IDLE; assert(!song_snapshot_restore());
    song_clear();assert(!song_snapshot_available() && song_snapshot_restore()==-1);
    assert(!song_snapshot_capture()); assert(!song_save(0)); song_timer_task();
    assert(song_snapshot_available()); assert(!song_load(0)); assert(!song_snapshot_available()); song_timer_task();
    puts("song tests passed"); return 0;
}
