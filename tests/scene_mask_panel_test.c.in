#include <assert.h>
#include <stdio.h>
#include <string.h>
#include "../src/gui/panel.c"
static int mask=-1, menu=PANEL_MENU_NONE, toggles, writes;
static int leds[PANEL_LED_NUM_LEDS];
int step_edit_scene_mask(void) {return mask;}
void step_edit_toggle_scene(int scene) {assert(scene>=0 && scene<6); mask^=1<<scene; toggles++;}
int panel_menu_get_mode(void) {return menu;}
void panel_if_set_led(int led,uint8_t value) {leds[led]=value;writes++;}
void panel_if_blink_led(int led,uint8_t off,uint8_t on) {leds[led]=-1;writes++;}
void log_error(char *fmt,...) {assert(0);}
/* Stubs for panel_handle_state_change dependencies (unused by these tests). */
void gui_clear_status_text_all(void) {} void gui_set_status_override(int e) {}
void gui_set_status_text(int line,char *text) {} void panel_if_set_rgb(int side,uint32_t color) {}
int panel_menu_get_timeout(void) {return 0;} int seq_ctrl_get_first_track(void) {return 0;}
int seq_ctrl_get_live_mode(void) {return 0;} int seq_ctrl_get_scene(void) {return 0;}
int seq_ctrl_get_song_mode(void) {return 0;} int song_get_arp_enable(int s,int t) {return 0;}
int song_get_euclidean_density(int s,int t) {return 100;} int song_get_euclidean_rotation(int s,int t) {return 0;}
int song_get_motion_dir(int s,int t) {return 0;} int song_get_motion_length(int s,int t) {return 16;}
static int help_active, help_scroll;
int gui_clock_help_active(void) {return help_active;}
void gui_clock_help_set(int enable) {help_active=enable;}
void gui_clock_help_scroll(int change) {help_scroll+=change;}
static int help_pages;
void gui_overview_page(int change) {help_pages+=change;}
static int help_edits;
void gui_overview_edit(int change) {help_edits+=change;}
static int help_mode=PANEL_MENU_CLOCK;
int gui_overview_mode(void) {return help_active?help_mode:0;}
int seq_utils_enc_val_to_change(int value) {return value;}
static void test_help_input(void) {
    memset(&pstate,0,sizeof(pstate));help_active=1;help_scroll=0;
    assert(panel_handle_clock_help_input(PANEL_ENC_MOTION_START,2));
    assert(help_scroll==2 && help_active);
    for(int enc=PANEL_ENC_SPEED;enc<=PANEL_ENC_TRANSPOSE;enc++)
        if(enc!=PANEL_ENC_MOTION_START) assert(panel_handle_clock_help_input(enc,1));
    assert(help_scroll==2 && help_active && help_edits==1);
    // Release of the opening long press must leave help open.
    snapshot_keys_event(&pstate.snapshot_keys,SNAP_CLOCK,1,0);
    for(int i=0;i<800;i++) snapshot_keys_tick(&pstate.snapshot_keys);
    assert(panel_handle_clock_help_input(PANEL_SW_CLOCK,0) && help_active);
    assert(panel_handle_clock_help_input(PANEL_SW_CLOCK,1) && help_active);
    assert(panel_handle_clock_help_input(PANEL_SW_CLOCK,0) && !help_active);
    help_active=1;
    assert(!panel_handle_clock_help_input(PANEL_SW_1,0) && help_active);
    assert(!panel_handle_clock_help_input(PANEL_SW_RUN_STOP,1) && !help_active);
    const int keys[3]={PANEL_SW_ARP,PANEL_SW_MIDI,PANEL_SW_TONALITY};
    const int modes[3]={PANEL_MENU_ARP,PANEL_MENU_MIDI,PANEL_MENU_TONALITY};
    for(int key=0;key<3;key++) {
        memset(&pstate,0,sizeof(pstate));help_active=0;int val=1;
        assert(panel_overview_button(keys[key],&val)); // no tap action yet
        val=0;assert(!panel_overview_button(keys[key],&val) && val==1);
        val=1;assert(panel_overview_button(keys[key],&val));
        for(int ms=0;ms<800;ms++) overview_keys_tick(&pstate.overview_keys);
        help_active=1;help_mode=modes[key];
        val=0;assert(panel_overview_button(keys[key],&val) && help_active);
        val=1;assert(panel_overview_button(keys[key],&val));
        val=0;assert(panel_overview_button(keys[key],&val) && !help_active);
        pstate.shift_state=1;val=1;assert(!panel_overview_button(keys[key],&val));
        val=0;assert(!panel_overview_button(keys[key],&val));
    }
    help_mode=PANEL_MENU_CLOCK;
}
static int editing=1, recording;
int step_edit_get_enable(void) {return editing;}
int seq_ctrl_get_record_mode(void) {return recording;}
static void test_edit_hold(void) {
    memset(&pstate,0,sizeof(pstate));int val=1;
    assert(panel_step_edit_button(PANEL_SW_EDIT,&val));
    for(int ms=0;ms<799;ms++) assert(overview_keys_tick(&pstate.edit_keys)<0);
    assert(overview_keys_tick(&pstate.edit_keys)==0);
    assert(overview_keys_tick(&pstate.edit_keys)<0);
    val=0;assert(panel_step_edit_button(PANEL_SW_EDIT,&val));
    val=1;assert(panel_step_edit_button(PANEL_SW_EDIT,&val));
    val=0;assert(!panel_step_edit_button(PANEL_SW_EDIT,&val) && val==1);
    val=1;assert(panel_step_edit_button(PANEL_SW_EDIT,&val));
    assert(!panel_step_edit_button(PANEL_ENC_SPEED,&val));
    for(int ms=0;ms<900;ms++) assert(overview_keys_tick(&pstate.edit_keys)<0);
    val=0;assert(panel_step_edit_button(PANEL_SW_EDIT,&val));
    pstate.shift_state=1;val=1;assert(!panel_step_edit_button(PANEL_SW_EDIT,&val));
    val=0;assert(!panel_step_edit_button(PANEL_SW_EDIT,&val));
    pstate.shift_state=0;editing=0;val=1;assert(!panel_step_edit_button(PANEL_SW_EDIT,&val));
    editing=1;recording=1;assert(!panel_step_edit_button(PANEL_SW_EDIT,&val));
    recording=0;
}
static void test_track_holds(void) {
    for(int key=0;key<6;key++) {
        memset(&pstate,0,sizeof(pstate));mask=-1;menu=PANEL_MENU_NONE;
        panel_track_overview_input(PANEL_SW_1+key,1);
        for(int ms=0;ms<799;ms++) assert(track_overview_tick(&pstate.track_keys)<0);
        panel_track_overview_input(PANEL_SW_1+key,1); // repeat
        assert(track_overview_tick(&pstate.track_keys)==key);
        assert(track_overview_tick(&pstate.track_keys)<0);
        panel_track_overview_input(PANEL_SW_1+key,0);
        assert(!pstate.track_keys.down);
        // Every other button and nonzero encoder cancels, including consumed inputs.
        for(int other=0;other<=PANEL_ENC_TRANSPOSE;other++) {
            if(other==PANEL_SW_1+key) continue;
            memset(&pstate,0,sizeof(pstate));
            panel_track_overview_input(PANEL_SW_1+key,1);
            panel_track_overview_input(other,1);
            for(int ms=0;ms<801;ms++) assert(track_overview_tick(&pstate.track_keys)<0);
        }
        // Already-held physical keys prohibit arming, in either chord order.
        for(int other=0;other<PANEL_ENC_SPEED;other++) {
            if(other==PANEL_SW_1+key) continue;
            memset(&pstate,0,sizeof(pstate));
            panel_track_overview_input(other,1);
            panel_track_overview_input(PANEL_SW_1+key,1);
            assert(!pstate.track_keys.candidate);
        }
        for(int guard=0;guard<4;guard++) {
            memset(&pstate,0,sizeof(pstate));mask=-1;
            if(guard==0)pstate.shift_state=1;
            if(guard==1)pstate.scene_state=1;
            if(guard==2)mask=63;
            if(guard==3)pstate.track_hold_state[(key+1)%6]=1;
            panel_track_overview_input(PANEL_SW_1+key,1);
            assert(!pstate.track_keys.candidate);
        }
        mask=-1;memset(&pstate,0,sizeof(pstate));
        panel_track_overview_input(PANEL_SW_1+key,1);
        panel_track_overview_input(PANEL_SW_1+key,0);
        assert(!pstate.track_keys.candidate && !pstate.track_keys.down);
    }
    help_active=1;help_mode=GUI_OVERVIEW_TRACK;int edits=help_edits,scroll=help_scroll;
    int pages=help_pages;
    for(int enc=PANEL_ENC_SPEED;enc<=PANEL_ENC_TRANSPOSE;enc++)
        assert(panel_handle_clock_help_input(enc,1));
    assert(edits==help_edits && scroll==help_scroll);
    assert(help_pages==pages+1);            /* only Motion Start pages (lanes/Settings) */
    help_mode=GUI_OVERVIEW_LANES;
    assert(panel_handle_clock_help_input(PANEL_ENC_MOTION_START,-1) && help_pages==pages);
    assert(panel_handle_clock_help_input(PANEL_ENC_MOTION_LENGTH,3) && help_edits==edits);
    help_mode=GUI_OVERVIEW_TRACK;
    assert(!panel_handle_clock_help_input(PANEL_SW_1,0) && help_active);
    assert(panel_handle_clock_help_input(PANEL_SW_CLOCK,1));
    assert(panel_handle_clock_help_input(PANEL_SW_CLOCK,0) && !help_active);
    help_mode=PANEL_MENU_CLOCK;
}
static void test_scene_holds(void) {
    for(int scene=0;scene<6;scene++) {
        for(int order=0;order<2;order++) {
            memset(&pstate,0,sizeof(pstate));mask=-1;menu=PANEL_MENU_NONE;
            panel_track_overview_input(PANEL_SW_SCENE,1);pstate.scene_state=1;
            panel_track_overview_input(PANEL_SW_1+scene,1);
            for(int ms=0;ms<799;ms++) assert(track_overview_tick(&pstate.track_keys)<0);
            panel_track_overview_input(PANEL_SW_1+scene,1);
            assert(track_overview_tick(&pstate.track_keys)==scene+6);
            assert(track_overview_tick(&pstate.track_keys)<0);
            panel_track_overview_input(order?PANEL_SW_SCENE:PANEL_SW_1+scene,0);
            panel_track_overview_input(order?PANEL_SW_1+scene:PANEL_SW_SCENE,0);
            assert(!pstate.track_keys.down && !pstate.track_keys.candidate);
            // Either release before the threshold cancels.
            memset(&pstate,0,sizeof(pstate));
            panel_track_overview_input(PANEL_SW_SCENE,1);pstate.scene_state=1;
            panel_track_overview_input(PANEL_SW_1+scene,1);
            panel_track_overview_input(order?PANEL_SW_SCENE:PANEL_SW_1+scene,0);
            for(int ms=0;ms<801;ms++) assert(track_overview_tick(&pstate.track_keys)<0);
        }
        for(int other=1;other<=PANEL_ENC_TRANSPOSE;other++) {
            if(other==PANEL_SW_1+scene) continue;
            memset(&pstate,0,sizeof(pstate));
            panel_track_overview_input(PANEL_SW_SCENE,1);pstate.scene_state=1;
            panel_track_overview_input(PANEL_SW_1+scene,1);
            panel_track_overview_input(other,1);
            assert(!pstate.track_keys.candidate);
        }
        for(int guard=0;guard<3;guard++) {
            memset(&pstate,0,sizeof(pstate));mask=-1;
            panel_track_overview_input(PANEL_SW_SCENE,1);pstate.scene_state=1;
            if(guard==0)pstate.shift_state=1; // scene copy remains normal
            if(guard==1)mask=63; // Scn owns numbered buttons
            if(guard==2)pstate.track_hold_state[(scene+1)%6]=1;
            panel_track_overview_input(PANEL_SW_1+scene,1);
            assert(!pstate.track_keys.candidate);
        }
        mask=-1;memset(&pstate,0,sizeof(pstate));
        panel_track_overview_input(PANEL_SW_1+scene,1);
        panel_track_overview_input(PANEL_SW_SCENE,1);pstate.scene_state=1;
        assert(!pstate.track_keys.candidate); // wrong order is not a scene hold
    }
    memset(&pstate,0,sizeof(pstate));help_active=1;help_mode=GUI_OVERVIEW_SCENE;
    int edits=help_edits,scroll=help_scroll;
    int pages=help_pages;
    for(int enc=PANEL_ENC_SPEED;enc<=PANEL_ENC_TRANSPOSE;enc++)
        assert(panel_handle_clock_help_input(enc,1));
    assert(edits==help_edits && scroll==help_scroll);
    assert(help_pages==pages);              /* scene overview never pages */
    assert(!panel_handle_clock_help_input(PANEL_SW_SCENE,0) && help_active);
    assert(!panel_handle_clock_help_input(PANEL_SW_6,0) && help_active);
    assert(panel_handle_clock_help_input(PANEL_SW_CLOCK,1));
    assert(panel_handle_clock_help_input(PANEL_SW_CLOCK,0) && !help_active);
    help_mode=PANEL_MENU_CLOCK;
}
static void test_sys_hold(void) {
    for(int order=0;order<2;order++) {
        memset(&pstate,0,sizeof(pstate));pstate.shift_state=1;
        panel_sys_overview_input(PANEL_SW_MIDI,1);
        for(int ms=0;ms<799;ms++) assert(overview_keys_tick(&pstate.sys_keys)<0);
        assert(overview_keys_tick(&pstate.sys_keys)==0);
        assert(overview_keys_tick(&pstate.sys_keys)<0);
        panel_sys_overview_input(order?PANEL_SW_SHIFT:PANEL_SW_MIDI,0);
        panel_sys_overview_input(order?PANEL_SW_MIDI:PANEL_SW_SHIFT,0);
        assert(!pstate.sys_keys.down[0]);
    }
    for(int key=0;key<=PANEL_ENC_TRANSPOSE;key++) {
        if(key==PANEL_SW_MIDI) continue;
        memset(&pstate,0,sizeof(pstate));pstate.shift_state=1;
        panel_sys_overview_input(PANEL_SW_MIDI,1);
        panel_sys_overview_input(key,key==PANEL_SW_SHIFT?0:1);
        for(int ms=0;ms<801;ms++) assert(overview_keys_tick(&pstate.sys_keys)<0);
    }
    memset(&pstate,0,sizeof(pstate));
    panel_sys_overview_input(PANEL_SW_MIDI,1);pstate.shift_state=1;
    panel_sys_overview_input(PANEL_SW_SHIFT,1);
    assert(!pstate.sys_keys.down[0]); // MIDI-first cannot become SYS hold
    panel_sys_overview_input(PANEL_SW_MIDI,0);
    panel_sys_overview_input(PANEL_SW_MIDI,1);
    panel_sys_overview_input(PANEL_SW_MIDI,0);
    assert(overview_keys_tick(&pstate.sys_keys)<0);
}
// Regression: LOAD release lost during the load lockout blocked track/scene overviews.
static void test_load_lockout_release(void) {
    memset(&pstate,0,sizeof(pstate));
    panel_track_overview_input(PANEL_SW_LOAD,1);
    snapshot_keys_event(&pstate.snapshot_keys,SNAP_LOAD,1,0);
    // (release never arrives: input is locked out while loading)
    panel_track_overview_input(PANEL_SW_1+2,1);
    for(int ms=0;ms<900;ms++) assert(track_overview_tick(&pstate.track_keys)<0);
    panel_track_overview_input(PANEL_SW_1+2,0);
    int song=39;panel_handle_state_change(SCE_SONG_LOADED,&song,1);
    assert(!pstate.snapshot_keys.down[SNAP_LOAD]);
    panel_track_overview_input(PANEL_SW_1+2,1);
    for(int ms=0;ms<799;ms++) assert(track_overview_tick(&pstate.track_keys)<0);
    assert(track_overview_tick(&pstate.track_keys)==2);
    panel_track_overview_input(PANEL_SW_1+2,0);
    // Scene + track chord as well.
    panel_track_overview_input(PANEL_SW_SCENE,1);pstate.scene_state=1;
    panel_track_overview_input(PANEL_SW_1+4,1);
    for(int ms=0;ms<799;ms++) assert(track_overview_tick(&pstate.track_keys)<0);
    assert(track_overview_tick(&pstate.track_keys)==4+6);
    memset(&pstate,0,sizeof(pstate));
}
int main(void) {
 test_load_lockout_release();
 test_sys_hold();
 test_scene_holds();
 test_track_holds();
 test_edit_hold();
 test_help_input();
 memset(&pstate,0,sizeof(pstate)); memset(pstate.led_physical,255,sizeof(pstate.led_physical));
 pstate.bl_power_state=PANEL_POWER_STATE_ON;
 for(int i=0;i<6;i++) panel_update_track_led(i,i==2);
 for(int m=0;m<64;m++) {
  mask=m;
  for(int i=0;i<6;i++) {
   panel_set_led(PANEL_LED_1+i,pstate.led_state[PANEL_LED_1+i]);
   assert(leds[PANEL_LED_1+i]==(m&(1<<i)?255:0));
   int n=writes;panel_set_led(PANEL_LED_1+i,pstate.led_state[PANEL_LED_1+i]);assert(n==writes);
  }
 }
 // Normal desired state continues updating underneath mask; restored on exit.
 panel_update_track_led(2,0);panel_update_track_led(4,1);mask=-1;
 for(int i=0;i<6;i++) {panel_set_led(PANEL_LED_1+i,pstate.led_state[PANEL_LED_1+i]);assert(leds[PANEL_LED_1+i]==(i==4?255:0));}
 for(int i=0;i<6;i++) {
  mask=0;pstate.shift_state=pstate.scene_state=1;int n=toggles;
  assert(panel_handle_scene_mask_input(PANEL_SW_1+i,1));assert(mask==(1<<i));
  assert(panel_handle_scene_mask_input(PANEL_SW_1+i,1));assert(toggles==n+1);
  mask=-1;assert(panel_handle_scene_mask_input(PANEL_SW_1+i,0));
  assert(!panel_handle_scene_mask_input(PANEL_SW_1+i,1));
  mask=0;assert(!panel_handle_scene_mask_input(PANEL_SW_1+i,0));
 }
 mask=63;pstate.bl_power_state=PANEL_POWER_STATE_STANDBY;
 for(int i=0;i<6;i++) {panel_set_led(PANEL_LED_1+i,0);assert(!leds[PANEL_LED_1+i]);}
 pstate.bl_power_state=PANEL_POWER_STATE_ON;
 menu=PANEL_MENU_CLOCK;assert(!panel_handle_scene_mask_input(PANEL_SW_1,1));
 assert(!panel_handle_scene_mask_input(PANEL_SW_1,0));menu=PANEL_MENU_NONE;
 for(int pair=0;pair<4;pair++) for(int row=0;row<13;row++) {
  unsigned expected=row>=2 && row<=8 ? ((pair&1?14:0)|(pair&2?112:0)):0;
  assert(scene_mask_glyph_row(pair+1,row)==expected);
 }
 puts("scene mask panel/LED/glyph tests passed");return 0;
}
