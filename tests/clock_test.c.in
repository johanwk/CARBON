/* SPDX-License-Identifier: GPL-3.0-or-later
 * Production clock plus engine fixtures. Callbacks match seq_ctrl routing.
 */
#define CARBON_TEST_CLOCK
#define main engine_fixture_tests
#include "engine_test.c.in"
#undef main
void midi_clock_ticked_swing(uint32_t tick) { engine_tick=tick; seq_engine_run(tick); }
void midi_clock_beat_crossed(void) { sestate.beat_cross = 1; }
void midi_clock_run_state_changed(int run) { running = run; }
static void pump(int milliseconds) {
    int i; for(i = 0; i < milliseconds; i ++) midi_clock_timer_task();
}
static void test_variable_delay_intervals(void) {
    // Production clock callback + engine: 7 divisions of 384 yield 54/55 ticks.
    setup(); midi_clock_init(); midi_clock_midi_rx_start(); pump(8);
    setup(); enabled[0]=1;
    put(0,0,SONG_EVENT_NOTE,60,100); fixture[0][0].delay=100;
    sestate.bar_divisions[0]=7; sestate.bar_div_remainder[0]=0;
    seq_engine_schedule_bar_div_step(0); sestate.clock_div_count[0]=0;
    int boundary=1;
    for(int step=0;step<7;step++) {
        int interval=sestate.step_size[0];
        int attack=boundary+(interval+1)/2; int before=output_count;
        for(int tick=boundary;tick<boundary+interval;tick++) {
            midi_clock_ticked_swing(tick);
        }
        assert(output_count==before+2);
        assert(output_ticks[before]==(uint32_t)attack && output[before].status==MIDI_NOTE_ON);
        assert(output_ticks[before+1]==(uint32_t)(attack+1) && output[before+1].status==MIDI_NOTE_OFF);
        boundary+=interval;
    }
    assert(boundary==385);
    // Full engine passes, not direct note management, for 0/32/64 triplets.
    setup(); enabled[0]=1; sestate.step_size[0]=96;
    sestate.clock_div_count[0]=0;
    for(int i=0;i<3;i++) {put(0,i,SONG_EVENT_NOTE,60+i,100);
        fixture[0][i].delay=i==0?0:i==1?99:101; fixture[0][i].length=32;}
    for(int tick=1;tick<=96;tick++) midi_clock_ticked_swing(tick);
    int attacks=0;
    for(int i=0;i<output_count;i++) if(output[i].status==MIDI_NOTE_ON)
        assert(output_ticks[i]==(uint32_t)(1+32*attacks++));
    assert(attacks==3);
    midi_clock_ticked_swing(97);
    assert(output[output_count-1].status==MIDI_NOTE_ON && output_ticks[output_count-1]==97);
}
static void test_snapshot_bar_clock(void) {
    setup();midi_clock_init();midi_clock_set_swing(70);
    midi_clock_midi_rx_start();pump(30);
    put(0,0,SONG_EVENT_NOTE,48,100);assert(!seq_engine_snapshot_capture());
    fixture[0][0].data0=72;assert(!seq_engine_snapshot_recall());
    int elapsed=0;while(seq_engine_snapshot_status()==2 && elapsed++<12000) pump(1);
    assert(fixture[0][0].data0==48 && engine_tick==384 && seq_engine_snapshot_status()==1);
}
static void test_straight_bar_clock(void) {
    test_snapshot_bar_clock();
    setup();midi_clock_init();midi_clock_set_swing(70);
    midi_clock_midi_rx_start();pump(30);
    put(0,0,SONG_EVENT_NOTE,48,100);assert(!seq_engine_undo_capture());
    fixture[0][0].data0=72;assert(!seq_engine_undo_recall());
    int wait=0;while(seq_engine_undo_status()==2 && wait++<12000) pump(1);
    assert(fixture[0][0].data0==48 && engine_tick==384 && seq_engine_undo_status()==1);
    setup(); midi_clock_init(); midi_clock_set_swing(70);
    midi_clock_midi_rx_start(); pump(30);
    assert(midi_clock_get_running());
    timing_step[0]=4; seq_engine_recalc_params(); seq_engine_set_straight(1);
    seq_engine_adjust_timing(0,0,7);
    int elapsed=0;
    while(timing_step[0]==4 && elapsed++<12000) pump(1);
    assert(timing_step[0]==7 && engine_tick==384);
    assert(!seq_engine_timing_pending(0,0));
}
int main(void) {
    test_straight_bar_clock();
    test_variable_delay_intervals();
    struct conditional_state expected;
    setup(); midi_clock_init();
    // Keep events masked so transport tests cannot overwrite gate history.
    sestate.conditions[0].history = 1;
    sestate.conditions[0].cycle = 15;
    midi_clock_midi_rx_start(); pump(8);
    assert(midi_clock_get_running());
    assert(!sestate.conditions[0].history && !sestate.conditions[0].cycle);
    sestate.conditions[0].history = 1;
    sestate.conditions[0].cycle = 17;
    expected = sestate.conditions[0];
    midi_clock_midi_rx_stop(); pump(20);
    assert(!midi_clock_get_running());
    assert(sestate.conditions[0].history == expected.history);
    assert(sestate.conditions[0].random == expected.random);
    assert(sestate.conditions[0].cycle == expected.cycle);
    midi_clock_midi_rx_continue(); pump(8);
    assert(midi_clock_get_running());
    assert(sestate.conditions[0].history == expected.history);
    assert(sestate.conditions[0].cycle == expected.cycle);
    midi_clock_request_reset_pos(); pump(8);
    assert(!sestate.conditions[0].history && !sestate.conditions[0].cycle);
    // Swing can issue several engine passes at the same straight tick.
    // The clock must still leave gate state untouched on masked visits.
    midi_clock_set_swing(80); pump(600);
    assert(!sestate.conditions[0].history);
    // Repeated swing passes still draw once per visited gate, not per pass.
    setup(); midi_clock_init();
    enabled[0] = 1;
    put(0, 0, SONG_EVENT_PROBABILITY, 50, 0);
    midi_clock_set_swing(80);
    midi_clock_midi_rx_start(); pump(1000);
    conditional_init(&expected, 0);
    assert(reads[0] > 0 && reads[0] % SEQ_TRACK_POLY == 0);
    {
        int i;
        for(i = 0; i < reads[0] / SEQ_TRACK_POLY; i ++)
            conditional_probability(&expected, 50);
    }
    assert(sestate.conditions[0].random == expected.random);
    puts("clock integration tests passed"); return 0;
}
