#include <assert.h>
#define GUI_STATE_SECTION
#include "../src/gui/gui.c"
static struct song_mode_state mode;
static int density = 44, length = 16, rotation = 3, songmode;
struct song_mode_state *seq_engine_get_song_mode_state(void) { return &mode; }
static int straight_ui, pending_ui, pitch_wait, pitch_target=0, step_target=4;
int seq_engine_pitch_value(int scene,int track) {return pitch_target;}
int seq_engine_timing_value(int scene,int track,int kind) {return step_target;}
int seq_engine_pitch_mode(void) {return 0;}
int seq_engine_pitch_pending(int track) {return pitch_wait;}
int seq_engine_straight_enabled(void) { return straight_ui; }
int seq_engine_timing_pending(int track, int kind) { return pending_ui; }
int seq_ctrl_get_song_mode(void) { return songmode; }
int seq_engine_get_effective_motion_length(int track) { return length; }
int seq_engine_get_effective_euclidean_density(int track) { return density; }
int seq_engine_get_effective_euclidean_rotation(int track) { return rotation; }
int seq_ctrl_get_scene(void) { return 0; }
int seq_engine_get_effective_root(int scene) { return -1; }
int seq_engine_get_effective_tonality(int scene, int track) { return 0; }
void log_error(char *fmt, ...) { assert(!"unexpected error"); }
static int rectangles, pitch_shift, preview_delay, preview_enabled=1;
static int step_edit_enabled;
int step_edit_get_enable(void) { return step_edit_enabled; }
int seq_ctrl_get_first_track(void) { return 0; }
void seq_engine_preview_step(int track, int step, struct seq_step_preview *p) {
    memset(p,0,sizeof(*p));
    if(step==0 && preview_enabled) {p->count=2;p->pitch[0]=40+pitch_shift;p->pitch[1]=52;p->delay[0]=preview_delay;}
}
void gfx_fill_rect(int x,int y,int w,int h,uint32_t color) {
    assert(x>=0 && y>=0); assert(w>0 && h>0); rectangles++;
    if(w==9 && h==2) assert(color==0xffbbbbbb || color==0xff202020);
}
static void test_pitch_grid(void) {
    for(int cell=27;cell<=31;cell+=4) {
        memset(&gstate,0,sizeof(gstate));
        gstate.GUI_GRID_SQUARE_W=gstate.GUI_GRID_SQUARE_H=cell;
        gstate.GUI_GRID_SQUARE_SPACE=2;
        for(int i=0;i<64;i++) gstate.preview_state[0][i]=0xff990000;
        pitch_shift=preview_delay=0; preview_enabled=1; rectangles=0;
        assert(gui_draw_main_grid() && rectangles==66);
        assert((gstate.pitch_marks[0][0]&255)==3);
        assert(!gui_draw_main_grid() && rectangles==66);
        int before=rectangles; pitch_shift=3; assert(gui_draw_main_grid());
        assert(rectangles==before+3); // only changed cell
        preview_delay=255; assert(gui_draw_main_grid());
        assert((gstate.pitch_marks[0][0]&255)==cell-12);
        assert(!gui_draw_main_grid());
        gstate.grid_overlay_enable=1; assert(gui_draw_main_grid());
        assert(!gstate.pitch_marks[0][0]);
        step_edit_enabled=1; gstate.grid_overlay[0]=0xffcccc00;
        assert(gui_draw_main_grid() && gstate.pitch_marks[0][0]);
        assert(!gui_draw_main_grid());
        step_edit_enabled=0; assert(gui_draw_main_grid());
        assert(!gstate.pitch_marks[0][0]);
        gstate.grid_overlay_enable=0; assert(gui_draw_main_grid());
        preview_enabled=0; assert(gui_draw_main_grid());
        assert(!gstate.pitch_marks[0][0] && !gui_draw_main_grid());
    }
}
int pattern_get_step_enable(int scene,int track,int pattern,int step) {return 1;}
int song_get_euclidean_density(int scene,int track) {return 100;}
int song_get_num_step_events(int scene,int track,int step) {return 1;}
static void test_details_layout(void) {
    for(int type=0;type<2;type++) {
        memset(&gstate,0,sizeof(gstate));gstate.screen_type=type;
        gstate.GUI_GRID_X=type?25:40;gstate.GUI_GRID_Y=type?80:90;gstate.GUI_GRID_H=238;
        gstate.GUI_PREVIEW_X=type?30:45;gstate.GUI_PREVIEW_GRID_SPACING=type?44:36;
        gstate.GUI_PREVIEW_SQUARE_W=type?5:4;
        gstate.grid_overlay_enable=1;gstate.grid_overlay[12]=0xffcccc00;
        gui_step_details_set(1);int before=rectangles;
        assert(gui_step_details_layout(0) && rectangles==before+1);
        assert(!gui_step_details_layout(0));
        for(int row=0;row<7;row++) {
            struct gfx_label *l=&gstate.glabels[gui_status_label(row)];
            assert(l->y>gstate.GUI_GRID_Y+gstate.GUI_GRID_H);
            assert(l->y+l->h<480 && l->x+l->w<=320);
            gui_set_status_text(row,"all seven rows");
            gui_set_status_highlight_part(row,23,4,GFX_HIGHLIGHT_INVERT);
            assert(l->highlight[23]==GFX_HIGHLIGHT_INVERT);
        }
        gui_clear_status_text_all();
        gui_set_status_text_part(5,0,5,"Dly  ");
        gui_set_status_text_part(5,25,4,"s7/8");
        gui_set_status_highlight_part(5,25,4,GFX_HIGHLIGHT_INVERT);
        struct gfx_label *last=&gstate.glabels[gui_status_label(5)];
        assert(strlen(last->text)==29 && !strcmp(last->text+25,"s7/8"));
        assert(last->w==232 && last->highlight[28]==GFX_HIGHLIGHT_INVERT);
        before=rectangles;
        assert(!gui_draw_preview_grids() && rectangles==before);
        gstate.active_step[0]=5;gstate.track_select[0]=1;gstate.arp_enable[0]=1;
        assert(!gui_draw_preview_grids() && rectangles==before);
        assert(gstate.preview_state[0][5]!=0);
        assert(gstate.grid_overlay_enable && gstate.grid_overlay[12]==0xffcccc00);
        gui_step_details_set(0);assert(gui_step_details_layout(0));
        for(int row=4;row<7;row++) assert(gstate.glabels[gui_status_label(row)].x==UINT16_MAX);
        assert(gstate.glabels[GUI_LABEL_STATUS_L1].y==(type?419:385));
        assert(!gui_step_details_layout(0));
        assert(gui_step_details_layout(1));
        assert(gstate.grid_overlay[12]==0xffcccc00);
    }
}
void log_info(char *fmt, ...) {}
static void test_cold_gui_init(void) {
    for(int lcd=0;lcd<2;lcd++) {
        // GUI lives in .ccm, not the startup-zeroed .bss.
        memset(&gstate,0xa5,sizeof(gstate));
        assert(gui_init()==0);
        assert(!gstate.step_details && !gstate.clock_help && !gstate.clock_help_drawn);
        assert(!gstate.force_refresh && !gstate.force_reinit && !gstate.status_override);
        gstate.screen_type=lcd;
        gstate.GUI_GRID_X=lcd?25:40;gstate.GUI_GRID_Y=lcd?80:90;gstate.GUI_GRID_H=238;
        gstate.GUI_PREVIEW_X=lcd?30:45;gstate.GUI_PREVIEW_Y=lcd?354:331;
        gstate.GUI_PREVIEW_GRID_SPACING=lcd?44:36;
        gstate.GUI_PREVIEW_SQUARE_W=gstate.GUI_PREVIEW_SQUARE_H=lcd?5:4;
        gstate.GUI_PREVIEW_SELECT_Y=lcd?397:366;gstate.GUI_PREVIEW_SELECT_H=4;
        gstate.GUI_PREVIEW_ARP_Y=lcd?404:372;
        gstate.step_details_drawn=255; // gui_startup requests layout restoration
        assert(gui_step_details_layout(0));
        int before=rectangles;
        assert(gui_draw_preview_grids());
        assert(rectangles-before==6*(64+2)); // all cells plus select/arp bars
        before=rectangles;assert(!gui_draw_preview_grids() && rectangles==before);
    }
}
int main(void) {
    test_cold_gui_init();
    test_details_layout();
    test_pitch_grid();
    char *label = gstate.glabels[GUI_LABEL_SONG_MODE].text;
    mode.current_entry = -1;
    gui_update_song_mode();
    assert(strlen(label) == 28 && !strcmp(label + 22, "16:7:3"));
    gstate.glabels[GUI_LABEL_SONG_MODE].dirty = 0;
    gui_update_song_mode();
    assert(!gstate.glabels[GUI_LABEL_SONG_MODE].dirty);
    rotation = 4; gui_update_song_mode();
    assert(gstate.glabels[GUI_LABEL_SONG_MODE].dirty);
    gstate.glabels[GUI_LABEL_SONG_MODE].dirty = 0;
    gui_update_song_mode();
    assert(!gstate.glabels[GUI_LABEL_SONG_MODE].dirty);
    songmode = 1; mode.current_entry = 63;
    mode.beat_count = mode.total_beats = 256;
    length = 64; density = 99; rotation = 63;
    gui_update_song_mode();
    assert(strlen(label) == 28 && !strcmp(label + 20, "64:63:63"));
    assert(!strncmp(label, "SONG - 64: 256/256", 17));
    density = 100; gui_update_song_mode();
    assert(strlen(label) == 28 && !strstr(label, "64:63:63"));
    density = 0; length = 1; rotation = 63; gui_update_song_mode();
    assert(!strcmp(label + 23, "1:0:0"));
    // Delay labels survive the production status buffers, including slot6.
    // Both LCD layouts consume these same 28-character labels.
    static const char *choices[]={"OFF","Step","s1/8","s1/4","s1/3","s1/2","s2/3","s3/4","s7/8"};
    for(unsigned c=0;c<sizeof(choices)/sizeof(choices[0]);c++) {
        gui_clear_status_text_all();
        for(int slot=0;slot<6;slot++) gui_set_status_text_part(3,3+4*slot,4,(char *)choices[c]);
        char *delay=gstate.glabels[GUI_LABEL_STATUS_L4].text;
        assert(strlen(delay)==GUI_STATUS_LINE_LEN);
        for(int slot=0;slot<6;slot++) assert(!memcmp(delay+3+4*slot,choices[c],strlen(choices[c])));
        gstate.glabels[GUI_LABEL_STATUS_L4].dirty=0;
        for(int slot=0;slot<6;slot++) gui_set_status_text_part(3,3+4*slot,4,(char *)choices[c]);
        assert(!gstate.glabels[GUI_LABEL_STATUS_L4].dirty);
    }
    straight_ui=1; pending_ui=0; gui_update_song_mode();
    assert(!strncmp(label,"STR ",4));
    pending_ui=1; gui_update_song_mode(); assert(!strncmp(label,"STR*",4));
    gstate.glabels[GUI_LABEL_SONG_MODE].dirty=0;gui_update_song_mode();
    assert(!gstate.glabels[GUI_LABEL_SONG_MODE].dirty);
    straight_ui=0; gui_update_song_mode();assert(!strncmp(label,"SONG",4));
    gui_notice("Snapshot captured");gui_update_song_mode();
    assert(!strncmp(label,"Snapshot captured",17));
    gstate.glabels[GUI_LABEL_SONG_MODE].dirty=0;gui_update_song_mode();
    assert(!gstate.glabels[GUI_LABEL_SONG_MODE].dirty);
    for(int i=0;i<2000;i++) gui_notice_tick();
    gui_update_song_mode();assert(!strncmp(label,"SONG",4));
    for(int lcd=0;lcd<GUI_DISP_NUM_TYPES;lcd++) {
        gstate.screen_type=lcd;gstate.status_override=0;
        pitch_wait=pending_ui=1;pitch_target=7;step_target=10;
        gui_update_song_mode();
        assert(!memcmp(gstate.status_lines[0]+19,"Tran:>+7",8));
        assert(!memcmp(gstate.status_lines[2],"Step:>1/4",9));
        gstate.glabels[GUI_LABEL_STATUS_L1].dirty=0;
        gstate.glabels[GUI_LABEL_STATUS_L3].dirty=0;gui_update_song_mode();
        assert(!gstate.glabels[GUI_LABEL_STATUS_L1].dirty && !gstate.glabels[GUI_LABEL_STATUS_L3].dirty);
        pitch_target=-24;step_target=1;gui_update_song_mode();
        assert(!memcmp(gstate.status_lines[0]+19,"Tran:>-24",9));
        assert(!memcmp(gstate.status_lines[2],"Step:>1/32",10));
        gstate.status_override=1;pitch_target=12;step_target=16;gui_update_song_mode();
        assert(!memcmp(gstate.status_lines[0]+19,"Tran:>-24",9));
        gstate.status_override=0;pitch_wait=pending_ui=0;gui_update_song_mode();
        assert(!memcmp(gstate.status_lines[0]+19,"Tran: +12",9));
        assert(!memcmp(gstate.status_lines[2],"Step: 1/1",9));
    }
    puts("GUI status tests passed"); return 0;
}
