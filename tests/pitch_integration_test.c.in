#define CARBON_TEST_PITCH
#define main conditional_engine_main
#include "engine_test.c.in"
#undef main
#include "../src/seq/outproc.c"
#include "../src/seq/arp.c"
#include "../src/seq/arp_progs.c"
int song_scene_copy_in_progress(void) { return 0; }
void metronome_beat_cross(void) {}
void metronome_stop_sound(void) {}
void metronome_mode_changed(int mode) {}
void metronome_sound_len_changed(int len) {}
int song_get_midi_autolive(void) { return 0; }
int song_get_midi_program(int track, int map) { return SONG_MIDI_PROG_NULL; }
static struct midi_msg wire[512];
float midi_clock_get_tempo(void) { return 120.0f; }
static int wires;
static int free_slots = 255, reject_sends;
int midi_stream_free_slots(int port) { return free_slots; }
int midi_stream_send_msg(struct midi_msg *msg) {
    if(reject_sends) return -1;
    assert(msg->data0 >= 0 && (msg->data0 <= 127 ||
        (msg->port == MIDI_PORT_CV_OUT && (msg->len & GLIDE_CV_FLAG))));
    assert(wires < 512); wire[wires++] = *msg; return 0;
}
static void init(void) {
    free_slots=255; reject_sends=0; test_cv_route=0;
    setup(); test_root = 0; test_scale = SCALE_MAJOR; test_transpose = 2;
    test_drum = 0; test_delay = 0; test_ratchet = 1; outproc_init();
    arp_init(); outproc_root_changed(); wires = 0;
}
static void live(int status, int note, int value) {
    struct midi_msg msg = {.port = 7, .len = 3, .status = status, .data0 = note, .data1 = value};
    seq_engine_live_send_msg(0, &msg);
}
// Hrm + delayed MIDI phrase investigation: production engine/output path.
static void test_harmony_delayed_phrase(void) {
    init(); test_root=SONG_ROOT_OFF; test_scale=SCALE_CHROMATIC;
    test_transpose=0; outproc_root_changed();
    enabled[0]=1; sestate.clock_div_count[0]=0; sestate.step_size[0]=96;
    put(0,0,SONG_EVENT_HARMONY,SCALE_MAJOR+1,SONG_HARMONY_ROOT_C);
    put(0,1,SONG_EVENT_NOTE,61,91); fixture[0][1].length=48;
    put(0,2,SONG_EVENT_NOTE,60,92); fixture[0][2].length=48;
    fixture[0][2].delay=99; // one third of the actual step = 32 ticks
    seq_engine_run(1);
    assert(wires==2 && wire[0].data0==60 && wire[0].data1==91);
    for(int tick=2;tick<=33;tick++) seq_engine_run(tick);
    assert(wires==4 && wire[2].data0==60 && wire[2].data1==92);
    // Distinct source pitches collapse onto the same destination pitch.
    // First release occurs while the second attack is meant to remain sounding.
    for(int tick=34;tick<=49;tick++) seq_engine_run(tick);
    assert(wires==6 && wire[4].status==MIDI_NOTE_OFF && wire[4].data0==60);
    for(int tick=50;tick<=81;tick++) seq_engine_run(tick);
    assert(wires==8 && wire[6].status==MIDI_NOTE_OFF && wire[6].data0==60);
    for(int i=0;i<OUTPROC_MAX_NOTES;i++) assert(!opstate.notes[0][i].input.status);

    // A later Hrm applies to an earlier step's pending attack at attack time.
    init(); test_root=SONG_ROOT_OFF; test_scale=SCALE_CHROMATIC;
    test_transpose=0; outproc_root_changed();
    struct seq_engine_step_visit visit={.slots=1};
    visit.events[0]=(struct track_event){.type=SONG_EVENT_NOTE,.data0=61,
        .data1=90,.length=8,.delay=48};
    seq_engine_track_play_step(0,0,&visit); assert(!wires);
    for(int tick=0;tick<24;tick++) seq_engine_track_manage_notes(0);
    struct seq_engine_step_visit visits[SEQ_NUM_TRACKS]={0};
    visits[0].slots=1;visits[0].events[0]=(struct track_event){
        .type=SONG_EVENT_HARMONY,.data0=SCALE_MAJOR+1,.data1=SONG_HARMONY_ROOT_C};
    seq_engine_resolve_harmony(visits);
    for(int tick=24;tick<48;tick++) seq_engine_track_manage_notes(0);
    assert(wires==2 && wire[0].data0==60);
    seq_engine_track_stop_all_notes(0);
}
static void test_arp_glide(void) {
    for(int cv=0;cv<2;cv++) {
        init(); test_cv_route=cv;
        sestate.arp_enable[0]=1; arp_set_arp_enable(0,1);
        sestate.bias_track_map[0]=1;
        seq_engine_apply_internal_cc(1,34,4); seq_engine_apply_internal_cc(1,35,12);
        // Local Gli on chord input must not override persistent arp settings.
        struct seq_engine_step_visit v={.slots=3};
        v.events[0]=(struct track_event){.type=SONG_EVENT_GLIDE,.data0=8,.data1=127};
        v.events[1]=(struct track_event){.type=SONG_EVENT_NOTE,.data0=64,.data1=100,.length=96};
        seq_engine_track_play_step(0,0,&v); assert(!wires);
        arp_run(1);
        if(cv) {
            assert(wires==1 && wire[0].len==(GLIDE_CV_FLAG|12));
            assert((wire[0].data0>>7)==4 && (wire[0].data0&127)==65);
        } else {
            assert(wires==6 && wire[0].data0==5 && wire[0].data1==64);
            assert(wire[1].data0==65 && wire[1].data1==127);
            assert(wire[2].status==MIDI_NOTE_ON && wire[2].data0==65);
        }
        int before=wires; seq_engine_apply_internal_cc(1,35,110); assert(wires==before);
        arp_stop_all_notes(0);
        assert(wires==before+(cv?1:2));
        assert(wire[before].status==MIDI_NOTE_OFF && wire[before].data0==65);
        wires=0; astate[0].seq_clock_count=astate[0].freerun_clock_count=0; arp_run(2);
        if(cv) assert(wires==1 && wire[0].len==(GLIDE_CV_FLAG|110));
        else assert(wires==6 && wire[0].data1==64); // MIDI curve ignored
        arp_stop_all_notes(0); seq_engine_apply_internal_cc(1,34,0);
        wires=0; astate[0].seq_clock_count=astate[0].freerun_clock_count=0; arp_run(3);
        if(cv) assert(wires==1 && (wire[0].data0>>7)==0);
        else assert(wires==4 && wire[0].data0==65 && wire[0].data1==0);
        arp_stop_all_notes(0);
    }
    init(); // restore ordinary fixture routing
}
static void test_perform_pitch(void) {
    init();running=1;test_root=0;test_scale=SCALE_MAJOR;test_transpose=0;outproc_root_changed();
    live(MIDI_NOTE_ON,60,100);assert(wires==2);
    seq_engine_set_pitch_mode(2);
    seq_engine_adjust_pitch(0,1);assert(seq_engine_pitch_pending(0));
    seq_engine_run(383);assert(test_transpose==0);
    seq_engine_run(384);assert(test_transpose==7);
    outproc_root_changed(); // fixture song setter does not dispatch state changes
    assert(wires==2); // named-root held note remains until release
    live(MIDI_NOTE_ON,62,100);assert(wire[2].data0==69);
    live(MIDI_NOTE_OFF,60,64);assert(wire[4].data0==60);
    seq_engine_adjust_pitch(0,1);assert(seq_engine_pitch_value(0,0)==12);
    seq_engine_adjust_pitch(0,-1);assert(!seq_engine_pitch_pending(0));
    seq_engine_adjust_pitch(0,-1);assert(seq_engine_pitch_value(0,0)==0);
    seq_engine_set_run_state(0);assert(!seq_engine_pitch_pending(0));
    assert(sestate.pitch_reference[0]==0); // stopping does not rebase the ladder
    seq_engine_adjust_pitch(0,1);
    int data[]={0,0,3};seq_engine_handle_state_change(SCE_SONG_TRANSPOSE,data,3);
    assert(!seq_engine_pitch_pending(0));
    seq_engine_adjust_pitch(0,1);seq_engine_run(0);
    assert(!seq_engine_pitch_pending(0) && sestate.pitch_reference[0]==0);
    seq_engine_adjust_pitch(0,1);sestate.scene_next=1;seq_engine_change_scene_synced();
    assert(!seq_engine_pitch_pending(0) && !sestate.pitch_reference_valid);
    init();running=1;seq_engine_set_pitch_mode(2);
    sestate.internal_cc[0][1]=5;seq_engine_adjust_pitch(0,1);seq_engine_apply_pitch(384);
    assert(sestate.internal_cc[0][1]==5); // programmed transpose remains authoritative
}
static void test_straight_arp(void) {
    test_perform_pitch();
    init();running=1;timing_arp[0]=4;arp_set_speed(0,4);
    sestate.arp_enable[0]=1;arp_set_arp_enable(0,1);
    live(MIDI_NOTE_ON,60,100);arp_run(1);assert(wires==2);
    seq_engine_set_straight(1);seq_engine_adjust_timing(0,1,7);
    astate[0].seq_clock_count=astate[0].freerun_clock_count=11;
    seq_engine_apply_timing(383);assert(astate[0].step_size==24);
    seq_engine_apply_timing(384);assert(astate[0].step_size==48);
    assert(!astate[0].seq_clock_count && !astate[0].freerun_clock_count);
    assert(astate[0].held_note_count==1 && wire[2].status==MIDI_NOTE_OFF);
    int before=wires;arp_run(384);assert(wires==before+2 && wire[before].status==MIDI_NOTE_ON);
    seq_engine_adjust_timing(0,1,10);seq_engine_set_run_state(0);
    assert(!seq_engine_timing_pending(0,1) && timing_arp[0]==7);
    // Scene/load/reset boundaries cancel rather than leaking to a new song.
    seq_engine_adjust_timing(0,1,10);seq_engine_song_loaded(0);
    assert(!seq_engine_timing_pending(0,1));
}
static void test_pitch_preview(void) {
    test_straight_arp();
    init(); test_root=SONG_ROOT_OFF; test_scale=SCALE_CHROMATIC; test_transpose=0; outproc_root_changed();
    put(0,0,SONG_EVENT_PROBABILITY,0,0);
    put(0,1,SONG_EVENT_NOTE,60,100); put(0,2,SONG_EVENT_NOTE,64,100);
    fixture[0][1].delay=100; fixture[0][2].delay=0; sestate.step_size[0]=96;
    struct seq_step_preview p;
    struct seq_engine_state before=sestate;
    seq_engine_preview_step(0,0,&p);
    assert(!memcmp(&before,&sestate,sizeof(sestate)) && !wires);
    assert(p.count==2 && p.pitch[0]==60 && p.pitch[1]==64 && p.delay[0]==128);
    sestate.bias_track_map[0]=1; sestate.bias_track_output[1]=2;
    seq_engine_preview_step(0,0,&p); assert(p.pitch[0]==62 && p.pitch[1]==66);
    seq_engine_remote_inversion(0,1);
    seq_engine_preview_step(0,0,&p); assert(p.pitch[0]==74 && p.pitch[1]==66);
    // Compare preview against actual ungated attacks, with shared pitch rules.
    struct seq_engine_step_visit v={.slots=6};v.events[1]=fixture[0][1];v.events[2]=fixture[0][2];
    seq_engine_track_play_step(0,0,&v); assert(wires==2 && wire[0].data0==p.pitch[1]);
    for(int i=0;i<48;i++) seq_engine_track_manage_notes(0);
    assert(wire[wires-2].status==MIDI_NOTE_ON && wire[wires-2].data0==p.pitch[0]);
    sestate.arp_enable[0]=1; seq_engine_preview_step(0,0,&p);assert(!p.count);
    init(); test_root=0; test_scale=SCALE_MAJOR; test_transpose=2; outproc_root_changed();
    put(0,0,SONG_EVENT_NOTE,64,100);seq_engine_preview_step(0,0,&p);assert(p.pitch[0]==65);
    test_root=2;seq_engine_preview_step(0,0,&p);assert(p.pitch[0]==66);
    assert(!wires);
}
static void test_glide_curve_control(void) {
    test_pitch_preview();
    test_arp_glide();
    init(); sestate.bias_track_map[0]=1; sestate.bias_track_map[2]=1;
    assert(sestate.glide_curve[0]==64);
    seq_engine_apply_internal_cc(1,35,24);
    assert(sestate.glide_curve[0]==24 && sestate.glide_curve[2]==24);
    assert(sestate.glide_curve[1]==64 && !sestate.glide_duration[0]);
    seq_engine_apply_internal_cc(1,35,128); assert(sestate.glide_curve[0]==24);
    seq_engine_apply_internal_cc(1,34,6); assert(sestate.glide_curve[0]==24);
    struct seq_engine_step_visit v={.slots=7};
    v.events[0]=(struct track_event){.type=SONG_EVENT_NOTE,.data0=60,.data1=100,.length=8,.delay=2};
    v.events[1]=(struct track_event){.type=SONG_EVENT_GLIDE,.data0=4,.data1=100};
    v.events[2]=v.events[0]; v.events[2].data0=62;
    seq_engine_track_play_step(0,0,&v); assert(!wires);
    assert(sestate.track_active_notes[0][SEQ_ENGINE_MAX_NOTES-1].glide_curve==24);
    assert(sestate.track_active_notes[0][SEQ_ENGINE_MAX_NOTES-2].glide_curve==100);
    seq_engine_apply_internal_cc(1,35,127);
    assert(sestate.track_active_notes[0][SEQ_ENGINE_MAX_NOTES-1].glide_curve==24);
    assert(sestate.glide_duration[0]==6 && sestate.glide_curve[0]==127);
    seq_engine_clear_internal_cc(); assert(sestate.glide_curve[0]==64);
    assert(sestate.track_active_notes[0][SEQ_ENGINE_MAX_NOTES-1].glide_curve==24);
    seq_engine_track_manage_notes(0); seq_engine_track_manage_notes(0); assert(wires==12);
    init(); enabled[0]=1; sestate.clock_div_count[0]=0; sestate.bias_track_map[1]=0;
    put(0,0,SONG_EVENT_PROBABILITY,0,0); put(0,1,SONG_EVENT_INTERNAL_CC,35,0);
    seq_engine_run(1); assert(sestate.glide_curve[1]==64);
    put(0,0,SONG_EVENT_PROBABILITY,100,0); sestate.clock_div_count[0]=0;
    seq_engine_run(2); assert(sestate.glide_curve[1]==0);
    sestate.scene_next=1; seq_engine_change_scene_synced(); assert(sestate.glide_curve[1]==64);
}
static void test_glide(void) {
    test_glide_curve_control();
    init(); test_scale=SCALE_CHROMATIC; test_transpose=0; outproc_root_changed();
    sestate.bias_track_map[0]=1;
    seq_engine_apply_internal_cc(1,34,6); assert(sestate.glide_duration[0]==6);
    seq_engine_apply_internal_cc(1,34,9); assert(sestate.glide_duration[0]==6);
    struct seq_engine_step_visit v={.slots=63};
    v.events[0]=(struct track_event){.type=SONG_EVENT_NOTE,.data0=60,.data1=100,.length=100,.delay=0};
    v.events[1]=(struct track_event){.type=SONG_EVENT_GLIDE,.data0=4,.data1=0};
    v.events[2]=v.events[0]; v.events[2].data0=62; v.events[2].delay=2;
    v.events[3]=(struct track_event){.type=SONG_EVENT_GLIDE,.data0=0,.data1=127};
    v.events[4]=v.events[0]; v.events[4].data0=64;
    v.events[5]=(struct track_event){.type=SONG_EVENT_GLIDE,.data0=8,.data1=64};
    seq_engine_track_play_step(0,0,&v);
    assert(wires==10); // CC5,CC65,Note on two routes; then Off,Note on both
    assert(wire[0].data0==5 && wire[0].data1==95);
    assert(wire[1].data0==65 && wire[1].data1==127 && wire[2].status==MIDI_NOTE_ON);
    assert(wire[6].data0==65 && wire[6].data1==0);
    assert(sestate.track_active_notes[0][SEQ_ENGINE_MAX_NOTES-2].glide_duration==4);
    assert(sestate.track_active_notes[0][SEQ_ENGINE_MAX_NOTES-2].glide_curve==0);
    seq_engine_clear_internal_cc();
    seq_engine_track_manage_notes(0); assert(wires==10);
    seq_engine_track_manage_notes(0); assert(wires==16);
    assert(wire[10].data0==5 && wire[10].data1==64); // snapshot survived reset of base
    v.slots=1; seq_engine_track_play_step(0,0,&v);
    assert(wire[16].data0==65 && wire[16].data1==0); // no local leak
    outproc_stop_all_notes(0); assert(opstate.glide_owner[0][0]==-1);
    // Priority per destination, including reversed arrival order. Notes remain.
    init(); struct midi_msg a={.port=0,.len=3,.status=MIDI_NOTE_ON,.data0=60,.data1=100};
    opstate.attack_duration=4; opstate.attack_curve=64;
    outproc_prepare_glide(4,0,0,&a); assert(opstate.glide_owner[0][0]==4);
    outproc_prepare_glide(1,0,0,&a); assert(opstate.glide_owner[0][0]==1);
    int before=wires; outproc_prepare_glide(5,0,0,&a); assert(wires==before);
    outproc_prepare_glide(5,1,0,&a); assert(opstate.glide_owner[1][0]==5);
    a.port=MIDI_PORT_CV_OUT; outproc_prepare_glide(0,MIDI_PORT_CV_OUT,0,&a);
    assert(a.len==(GLIDE_CV_FLAG|64) && a.data0==((4<<7)|60));
    assert(wires==before+2); // no separate CV settings message
    // Queue congestion drops a whole attack, without latching glide controls.
    for(int room=0;room<3;room++) {
        init(); free_slots=room;
        a=(struct midi_msg){.port=0,.len=3,.status=MIDI_NOTE_ON,.data0=60,.data1=100};
        outproc_deliver_glide(0,0,&a,4,64);
        assert(!wires && opstate.glide_owner[0][0]==-1);
        free_slots=255; outproc_deliver_glide(0,0,&a,4,64); assert(wires==6);
        a.status=MIDI_NOTE_OFF;
        outproc_deliver_msg(0,0,&a,OUTPROC_DELIVER_BOTH,OUTPROC_OUTPUT_PROCESSED);
        assert(wires==6); // dropped attack's release must not stop retrigger
        outproc_deliver_msg(0,0,&a,OUTPROC_DELIVER_BOTH,OUTPROC_OUTPUT_PROCESSED);
        assert(wires==8);
    }
    // Scene/reset releases priority but preserves cleanup responsibility.
    init(); a=(struct midi_msg){.port=0,.len=3,.status=MIDI_NOTE_ON,.data0=60,.data1=100};
    outproc_deliver_glide(0,0,&a,4,64);
    seq_engine_clear_internal_cc();
    assert(opstate.glide_owner[0][0]==-1 && opstate.glide_cleanup_owner[0][0]==0);
    reject_sends=1; outproc_stop_all_notes(0);
    assert(opstate.glide_used[0][0] && opstate.glide_cleanup_owner[0][0]==0);
    reject_sends=0; before=wires; outproc_stop_all_notes(0);
    assert(wires==before+2 && wire[before].data0==65 && wire[before].data1==0);
    assert(!opstate.glide_used[0][0] && opstate.glide_cleanup_owner[0][0]==-1);
    // Stopping a non-owner cannot switch off another track's glide.
    init(); opstate.attack_duration=4; opstate.attack_curve=64;
    outproc_prepare_glide(3,0,0,&a); outproc_prepare_glide(0,0,0,&a);
    before=wires; outproc_stop_all_notes(3); assert(wires==before);
    assert(opstate.glide_owner[0][0]==0);
    outproc_stop_all_notes(0); assert(wires==before+1);
    // Failed gate prevents CCi and local Gli from reaching playback.
    init(); enabled[0]=1; sestate.clock_div_count[0]=0; sestate.bias_track_map[1]=0;
    put(0,0,SONG_EVENT_PROBABILITY,0,0); put(0,1,SONG_EVENT_INTERNAL_CC,34,8);
    put(0,2,SONG_EVENT_GLIDE,8,64); put(0,3,SONG_EVENT_NOTE,60,100);
    seq_engine_run(1); assert(!wires && !sestate.glide_duration[1]);
}
#ifdef CARBON_TEST_REMOTE
int pitch_tests_main(void) {
#else
int main(void) {
#endif
    test_glide();
    test_harmony_delayed_phrase();
    init();
    live(MIDI_NOTE_ON, 64, 100); assert(wires == 2 && wire[0].data0 == 65);
    test_root = 2; test_scale = SCALE_NAT_MINOR; test_transpose = -3;
    seq_engine_handle_state_change(SCE_SONG_ROOT, 0, 0); assert(wires == 2);
    live(MIDI_POLY_KEY_PRESSURE, 64, 40); assert(wire[2].data0 == 65);
    live(MIDI_NOTE_OFF, 64, 64); assert(wire[4].data0 == 65);
    assert(seq_engine_live_get_num_notes(0) == 0);
    live(MIDI_NOTE_ON, 64, 100); assert(wire[6].data0 == 60);
    live(MIDI_CONTROL_CHANGE, 64, 127);
    live(MIDI_NOTE_OFF, 64, 64); int before = wires;
    test_root = SONG_ROOT_OFF; seq_engine_handle_state_change(SCE_SONG_ROOT, 0, 0);
    assert(wires == before && sestate.live_damper_pedal[0]);
    seq_engine_live_stop_all_notes(0); assert(wire[before].status == MIDI_CONTROL_CHANGE && wire[before].data1 == 0);
    init(); live(MIDI_NOTE_ON, 64, 100); live(MIDI_NOTE_ON, 64, 0);
    assert(wires == 4 && wire[2].status == MIDI_NOTE_OFF && !seq_engine_live_get_num_notes(0));
    // Real CCi17 accepts the full bipolar range, including -1.
    init(); sestate.bias_track_map[0] = 1;
    for(int value = 0; value < 128; value++) {
        seq_engine_apply_internal_cc(1, MIDI_CTRL_CC_TRACK_TRANSPOSE, value);
        int expected = midi_ctrl_internal_cc_to_value(MIDI_CTRL_CC_TRACK_TRANSPOSE, value, 8);
        assert(seq_engine_get_internal_cc(0, 17, 2) == expected);
    }
    seq_engine_apply_internal_cc(1, MIDI_CTRL_CC_TRACK_TRANSPOSE, 0);
    live(MIDI_NOTE_ON, 64, 100); assert(wire[0].data0 == 40);
    live(MIDI_NOTE_OFF, 64, 64);
    // Same-input retriggers spanning harmony changes release in FIFO order.
    init(); live(MIDI_NOTE_ON, 64, 100); test_root = 2; outproc_root_changed();
    live(MIDI_NOTE_ON, 64, 100); assert(wire[2].data0 == 66);
    live(MIDI_NOTE_OFF, 64, 64); assert(wire[4].data0 == 65);
    live(MIDI_NOTE_OFF, 64, 64); assert(wire[6].data0 == 66);
    assert(!seq_engine_live_get_num_notes(0));
    // Real sequencer start/timeout across an actual scene activation.
    init(); struct seq_engine_step_visit visit = {0};
    visit.slots = 1; visit.events[0] = (struct track_event){.type = SONG_EVENT_NOTE,
        .data0 = 64, .data1 = 100, .length = 1};
    sestate.kbtrans = 2; sestate.bias_track_map[0] = 1; sestate.bias_track_output[1] = 2;
    sestate.internal_cc[0][1] = 4;
    seq_engine_track_play_step(0, 0, &visit); assert(wires == 2 && wire[0].data0 == 72);
    test_root = 2; test_scale = SCALE_BLUES; test_transpose = -5;
    sestate.scene_next = 1; seq_engine_change_scene_synced(); assert(wires == 2);
    assert(sestate.internal_cc[0][1] == -32768);
    seq_engine_track_manage_notes(0); assert(wires == 4 && wire[2].data0 == 72);
    // Saturated sequencer voices steal with note-off, not duplicate note-on.
    init(); visit.events[0].length = 100;
    for(int i = 0; i < SEQ_ENGINE_MAX_NOTES + 1; i++) {
        visit.events[0].data0 = 60 + i; seq_engine_track_play_step(0, 0, &visit);
    }
    assert(wires == 36 && wire[32].status == MIDI_NOTE_OFF && wire[34].status == MIDI_NOTE_ON);
    seq_engine_track_stop_all_notes(0);
    for(int i = 0; i < OUTPROC_MAX_NOTES; i++) assert(!opstate.notes[0][i].input.status);
    visit.events[0].data0 = 64; visit.events[0].length = 1;
    // Delayed starts use new harmony at the attack, not at scheduling time.
    init(); test_delay = 2; visit.events[0].delay = SEQ_START_DELAY_INHERIT; seq_engine_track_play_step(0, 0, &visit); assert(wires == 0);
    test_root = 2; outproc_root_changed();
    seq_engine_track_manage_notes(0); assert(wires == 0);
    seq_engine_track_manage_notes(0); assert(wires == 2 && wire[0].data0 == 66);
    seq_engine_track_manage_notes(0); assert(wires == 4 && wire[2].data0 == 66);
    // Ratchet releases retain each attack's actual pitch after root changes.
    init(); test_ratchet = 2; visit.events[0].length = 8;
    seq_engine_track_play_step(0, 0, &visit); assert(wires == 2);
    test_root = 2; outproc_root_changed();
    for(int tick = 0; tick < 8; tick++) seq_engine_track_manage_notes(0);
    assert(wires == 8 && wire[2].data0 == 65 && wire[4].data0 == 66 && wire[6].data0 == 66);
    init();
    // An already released ratchet must not consume another same-pitch voice.
    init(); test_scale=SCALE_CHROMATIC; test_transpose=0; outproc_root_changed();
    visit.slots=3; visit.events[0]=(struct track_event){.type=SONG_EVENT_NOTE,
        .data0=60,.data1=100,.length=8,.delay=2};
    visit.events[1]=visit.events[0]; visit.events[1].length=20; visit.events[1].delay=3;
    test_ratchet=2; seq_engine_track_play_step(0,0,&visit); assert(!wires);
    for(int tick=1;tick<=6;tick++) seq_engine_track_manage_notes(0);
    // attacks at2,3; releases4; second first-note attack6.
    assert(wires==8 && wire[4].status==MIDI_NOTE_OFF && wire[6].status==MIDI_NOTE_ON);
    seq_engine_track_stop_all_notes(0);
    for(int i=0;i<OUTPROC_MAX_NOTES;i++) assert(!opstate.notes[0][i].input.status);
    // Pending attacks are cancelled on scene/reset, route stop and song load.
    for(int action=0;action<4;action++) {
        init(); visit.slots=1; visit.events[0].delay=96;
        seq_engine_track_play_step(0,0,&visit); assert(!wires);
        if(action==0) {sestate.scene_next=1; seq_engine_change_scene_synced();}
        else if(action==1) seq_engine_stop_notes(0);
        else if(action==2) seq_engine_song_loaded(0);
        else seq_engine_mute_select_changed(0,0,1);
        int before_cancel=wires;
        for(int tick=0;tick<100;tick++) seq_engine_track_manage_notes(0);
        assert(wires==before_cancel);
        for(int i=0;i<SEQ_ENGINE_MAX_NOTES;i++) assert(!sestate.track_active_notes[0][i].note.msg.status);
    }
    // Real arp input, execution and timeout. No double transpose at input.
    wires = 0; sestate.arp_enable[0] = 1; arp_set_arp_enable(0, 1);
    live(MIDI_NOTE_ON, 64, 100); assert(wires == 0);
    arp_run(1); assert(wires == 2 && wire[0].data0 == 65);
    test_root = 2; outproc_root_changed(); assert(wires == 2);
    arp_stop_all_notes(0); assert(wires == 4 && wire[2].data0 == 65);
    live(MIDI_NOTE_OFF, 64, 64); assert(!astate[0].held_note_count);
    // Hrm settles global root and per-track scales before all new attacks.
    init(); enabled[0] = enabled[1] = 1;
    sestate.clock_div_count[0] = sestate.clock_div_count[1] = 0;
    sestate.bias_track_map[1] = 0;
    put(0, 0, SONG_EVENT_HARMONY, SCALE_MAJOR + 1, SONG_HARMONY_ROOT_C + 2);
    put(1, 0, SONG_EVENT_HARMONY, SCALE_BLUES + 1, SONG_HARMONY_ROOT_C + 7);
    put(1, 1, SONG_EVENT_NOTE, 64, 100);
    live(MIDI_NOTE_ON, 64, 100); assert(wire[0].data0 == 65);
    seq_engine_run(1);
    assert(seq_engine_get_effective_root(0) == 2);
    assert(seq_engine_get_effective_tonality(0, 1) == SCALE_BLUES);
    assert(wires == 4 && wire[2].data0 == 65); // D blues accepts F
    live(MIDI_POLY_KEY_PRESSURE, 64, 20); assert(wire[4].data0 == 65);
    live(MIDI_NOTE_OFF, 64, 64); assert(wire[6].data0 == 65);
    // Reset removes overrides without changing saved values or held-note identity.
    seq_engine_clear_internal_cc(); assert(seq_engine_get_effective_root(0) == test_root);
    assert(seq_engine_get_effective_tonality(0, 1) == test_scale);
    init(); live(MIDI_NOTE_ON, 64, 100);
    memset(fixture, 0, sizeof(fixture)); enabled[0] = 1; sestate.clock_div_count[0] = 0;
    put(0, 0, SONG_EVENT_HARMONY, SCALE_MAJOR + 1, SONG_HARMONY_ROOT_C + 2);
    seq_engine_run(1); assert(wires == 2);
    live(MIDI_NOTE_ON, 64, 100); assert(wire[2].data0 == 66);
    live(MIDI_NOTE_OFF, 64, 64); assert(wire[4].data0 == 65);
    live(MIDI_NOTE_OFF, 64, 64); assert(wire[6].data0 == 66);
    // Scene activation clears harmony along with CCi overrides.
    sestate.scene_next = 1; seq_engine_change_scene_synced(); assert(!sestate.harmony_active);
    // Arp attacks read effective Hrm root/scale, without reprocessing inputs.
    init(); sestate.arp_enable[0] = 1; arp_set_arp_enable(0, 1);
    live(MIDI_NOTE_ON, 64, 100);
    enabled[0] = 1; sestate.clock_div_count[0] = 0;
    put(0, 0, SONG_EVENT_HARMONY, SCALE_MAJOR + 1, SONG_HARMONY_ROOT_C + 2);
    seq_engine_run(1); assert(wires == 2 && wire[0].data0 == 66);
    arp_stop_all_notes(0); assert(wires == 4 && wire[2].data0 == 66);
    // Hrm does not change drum pitch processing.
    init(); test_drum = 1; sestate.track_type[0] = 1;
    enabled[0] = 1; sestate.clock_div_count[0] = 0;
    put(0, 0, SONG_EVENT_HARMONY, SCALE_BLUES + 1, SONG_HARMONY_ROOT_C + 2);
    put(0, 1, SONG_EVENT_NOTE, 64, 100);
    seq_engine_run(1); assert(wires == 2 && wire[0].data0 == 66);
    running = 0; seq_engine_run(0); assert(!sestate.harmony_active);
    // Bias Inv affects only targets; eligible chord retains slot identities.
    init(); test_scale = SCALE_CHROMATIC; test_transpose = 0; outproc_root_changed();
    enabled[0] = enabled[1] = 1; sestate.clock_div_count[0] = sestate.clock_div_count[1] = 0;
    sestate.bias_track_map[1] = 0;
    put(0, 0, SONG_EVENT_INVERSION, 1, 0);
    put(1, 0, SONG_EVENT_NOTE, 60, 100); put(1, 1, SONG_EVENT_NOTE, 64, 90);
    put(1, 2, SONG_EVENT_NOTE, 67, 80);
    seq_engine_run(1); assert(sestate.inversion[0] == 0 && sestate.inversion[1] == 1);
    assert(wires == 6 && wire[0].data0 == 72 && wire[2].data0 == 64 && wire[4].data0 == 67);
    assert(fixture[1][0].data0 == 60 && wire[0].data1 == 100 && wire[2].data1 == 90);
    seq_engine_track_manage_notes(1); assert(wires == 12);
    for(int i = 0; i < OUTPROC_MAX_NOTES; i++) assert(!opstate.notes[1][i].input.status);
    // Source gate blocks Inv control; no target and self-only mappings are inert.
    init(); enabled[0] = 1; sestate.clock_div_count[0] = 0; sestate.bias_track_map[1] = 0;
    put(0, 0, SONG_EVENT_PROBABILITY, 0, 0); put(0, 1, SONG_EVENT_INVERSION, 5, 1);
    seq_engine_run(1); assert(sestate.inversion[1] == 0);
    seq_engine_remote_inversion(1, 2); seq_engine_remote_compact(1, 1);
    assert(sestate.inversion[1] == 2 && sestate.compact[1] == 1);
    seq_engine_clear_internal_cc(); assert(sestate.inversion[1] == 0 && sestate.compact[1] == 0);
    // Overflow omits only invalid voices, not later in-range slots.
    init(); test_scale = SCALE_CHROMATIC; test_transpose = 0; outproc_root_changed(); test_root = 0;
    seq_engine_remote_inversion(0, 1);
    struct seq_engine_step_visit inv = {0}; inv.slots = 7;
    inv.events[0] = (struct track_event){.type = SONG_EVENT_NOTE, .data0 = 120, .data1 = 100, .length = 1};
    inv.events[1] = (struct track_event){.type = SONG_EVENT_NOTE, .data0 = 124, .data1 = 100, .length = 1};
    inv.events[2] = (struct track_event){.type = SONG_EVENT_NOTE, .data0 = 127, .data1 = 100, .length = 1};
    seq_engine_track_play_step(0, 0, &inv); assert(wires == 4 && wire[0].data0 == 124);
    seq_engine_track_manage_notes(0); assert(wires == 8);
    puts("pitch integration tests passed"); return 0;
}
