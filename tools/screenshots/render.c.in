/* ---------- scenes ---------- */
static void boot(int screen) {
    fx_screen=screen; fx_scene=0; fx_first=0;
    gui_init(); step_edit_init(); panel_menu_init(); gui_startup();
    gui_update_song(seq_ctrl_get_current_song()); gui_update_tempo(120.0f); gui_update_scene(0);
    gui_update_clock_source(-1);
    for(int t=0;t<6;t++) {
        gui_update_track_select(t,fx_selected[t]);
        gui_update_arp_enable(0,t,song_get_arp_enable(0,t));
        gui_update_track_mute(0,t,fx_mute[0][t]);
        gui_update_motion_start(0,t,fx_start[0][t]);
        gui_update_motion_length(0,t,fx_len[0][t]);
        gui_update_active_step(t,(fx_start[0][t]+5)%64);
    }
    gui_update_first_track(0);
}
static void settle(void) { for(int i=0;i<4;i++) gui_refresh_task(); }
static int shot(const char *dir,const char *name,int screen) {
    char path[512]; snprintf(path,sizeof(path),"%s/%s-lcd%c.png",dir,name,'a'+screen);
    settle(); if(write_png(path)) {fprintf(stderr,"cannot write %s\n",path);return 1;}
    printf("%s\n",path); return 0;
}
int main(int argc,char **argv) {
    if(argc<2 || argc>3) {fprintf(stderr,"usage: %s OUTDIR [a|b|both]\n",argv[0]);return 2;}
    const char *which=argc==3?argv[2]:"a";
    int first=0,last=0;
    if(!strcmp(which,"b")) first=last=1;
    else if(!strcmp(which,"both")) last=GUI_DISP_NUM_TYPES-1;
    else if(strcmp(which,"a")) {fprintf(stderr,"layout must be a, b or both\n");return 2;}
    crc_init(); fixture_init();
    int bad=0;
    for(int screen=first;screen<=last;screen++) {
        boot(screen); bad|=shot(argv[1],"01-normal",screen);
        boot(screen); step_edit_set_enable(1); step_edit_adjust_cursor(4,0);
        bad|=shot(argv[1],"02-step-edit-compact",screen);
        step_edit_toggle_details(); bad|=shot(argv[1],"03-step-edit-expanded",screen);
#ifdef RENDER_DUMP_TEXT
        for(int l=0;l<GUI_NUM_STATUS_LINES;l++) printf("%d|%s|\n",l,gstate.status_lines[l]);
#endif
        step_edit_adjust_cursor(3,1); /* Shift+Motion Start: select slot 3 */
        bad|=shot(argv[1],"08-step-edit-expanded-slot",screen);
#ifdef RENDER_DUMP_TEXT
        for(int l=0;l<GUI_NUM_STATUS_LINES;l++) printf("%d|%s|\n",l,gstate.status_lines[l]);
#endif
        step_edit_toggle_details(); step_edit_set_enable(0);
        boot(screen); step_edit_set_enable(1); step_edit_adjust_cursor(11,0);
        step_edit_toggle_details(); bad|=shot(argv[1],"09-step-anatomy",screen);
#ifdef RENDER_DUMP_TEXT
        for(int l=0;l<GUI_NUM_STATUS_LINES;l++) printf("%d|%s|\n",l,gstate.status_lines[l]);
#endif
        step_edit_set_enable(0);
        /* Event cards: expanded, slot 1 (the condition) selected. */
        static const struct { int step; const char *name; } cards[]={{2,"10-card-prb"},{7,"11-card-euc"}};
        for(unsigned c=0;c<2;c++) {
            boot(screen); step_edit_set_enable(1); step_edit_adjust_cursor(cards[c].step,0);
            step_edit_toggle_details(); step_edit_adjust_cursor(1,1);
            bad|=shot(argv[1],cards[c].name,screen);
#ifdef RENDER_DUMP_TEXT
            for(int l=0;l<GUI_NUM_STATUS_LINES;l++) printf("%d|%s|\n",l,gstate.status_lines[l]);
#endif
            step_edit_set_enable(0);
        }
        /* Hrm/Inv cards: T1 is the Bias source, T2 a follower (Bias Track T1).
         * Source step 1 = bar 2 of the pitch example: N A3, Hrm Major/Keep, Inv 2. */
        static struct track_event src[SEQ_TRACK_POLY], fol[SEQ_TRACK_POLY];
        src[0]=(struct track_event){SONG_EVENT_NOTE,57,100,SEQ_START_DELAY_INHERIT,24};
        src[1]=(struct track_event){SONG_EVENT_HARMONY,1+SCALE_MAJOR,SONG_HARMONY_ROOT_KEEP,0,0};
        src[2]=(struct track_event){SONG_EVENT_INVERSION,2,0,0,0};
        fol[0]=(struct track_event){SONG_EVENT_NOTE,60,100,SEQ_START_DELAY_INHERIT,24};
        fol[1]=(struct track_event){SONG_EVENT_NOTE,64,100,SEQ_START_DELAY_INHERIT,24};
        fol[2]=(struct track_event){SONG_EVENT_NOTE,67,100,SEQ_START_DELAY_INHERIT,24};
        fx_ov=src; boot(screen); step_edit_set_enable(1);
        step_edit_toggle_details(); step_edit_adjust_cursor(2,1); /* select Hrm slot */
        bad|=shot(argv[1],"12-card-hrminv-setup",screen);
#ifdef RENDER_DUMP_TEXT
        for(int l=0;l<GUI_NUM_STATUS_LINES;l++) printf("%d|%s|\n",l,gstate.status_lines[l]);
#endif
        step_edit_set_enable(0);
        fx_ov=fol; boot(screen); fx_first=1; step_edit_set_enable(1);
        step_edit_toggle_details();
        bad|=shot(argv[1],"13-card-hrminv-pitches",screen);
#ifdef RENDER_DUMP_TEXT
        for(int l=0;l<GUI_NUM_STATUS_LINES;l++) printf("%d|%s|\n",l,gstate.status_lines[l]);
#endif
        step_edit_set_enable(0); fx_first=0; fx_ov=NULL;
        /* Euclidean card: track 1, motion 1-16, density 31% (5 of 16), rot 2.
         * Status text reproduces panel_show_euclidean_status() (Shift+Pattern). */
        {
            int s0=fx_start[0][0], l0=fx_len[0][0];
            fx_start[0][0]=0; fx_len[0][0]=16; fx_euc=1; fx_density=31; fx_rotation=2;
            boot(screen);
            char line[64];
            gui_set_status_override(1); gui_clear_status_text_all();
            snprintf(line,sizeof(line),"Track %d Euclidean",1); gui_set_status_text(0,line);
            snprintf(line,sizeof(line),"Density: %d%%",song_get_euclidean_density(0,0)); gui_set_status_text(1,line);
            snprintf(line,sizeof(line),"Rotation: %d",song_get_euclidean_rotation(0,0)%song_get_motion_length(0,0));
            gui_set_status_text(2,line);
            gui_set_status_text(3,"Shift: Pattern / Transpose");
            gui_update_active_step(0,6); /* playhead on a hit */
            bad|=shot(argv[1],"14-card-euclid",screen);
            fx_euc=0; fx_density=100; fx_rotation=0; fx_start[0][0]=s0; fx_len[0][0]=l0;
        }
        /* Region editing: track 1, playing steps 9-32 shown blue (overlay MED). */
        {
            int s0=fx_start[0][0], l0=fx_len[0][0];
            fx_start[0][0]=8; fx_len[0][0]=24;
            boot(screen); step_edit_set_enable(1); step_edit_adjust_cursor(12,0);
            step_edit_adjust_cursor(-1,1); /* Shift + Start left: All -> Region */
            bad|=shot(argv[1],"15-step-edit-region",screen);
#ifdef RENDER_DUMP_TEXT
            for(int l=0;l<GUI_NUM_STATUS_LINES;l++) printf("%d|%s|\n",l,gstate.status_lines[l]);
#endif
            step_edit_set_enable(0); fx_start[0][0]=s0; fx_len[0][0]=l0;
        }
        /* DRUM names: track 1 as DRUM with a GM pop beat (fixture only). */
        {
            static struct track_event saved[64][SEQ_TRACK_POLY];
            int s0=fx_start[0][0], l0=fx_len[0][0], t0=fx_type[0];
            memcpy(saved,fx_events,sizeof(saved)); memset(fx_events,0,sizeof(fx_events));
            for(int i=0;i<64;i++) {
                int n=0;
                #define HIT(p,v) fx_events[i][n++]=(struct track_event){SONG_EVENT_NOTE,p,v,SEQ_START_DELAY_INHERIT,12}
                if(i%8==0 || i%16==10) HIT(36,110);
                if(i%8==4) HIT(38,100);
                if(i%16==14) HIT(46,90); else if(i%2==0) HIT(42,i%4?60:85);
                if(i==0) HIT(49,100);
                #undef HIT
            }
            fx_type[0]=1; fx_start[0][0]=0; fx_len[0][0]=16; fx_drum_open=1;
            boot(screen); step_edit_set_enable(1); step_edit_adjust_cursor(0,0);
            bad|=shot(argv[1],"16-drum-step-compact",screen);
            step_edit_toggle_details(); bad|=shot(argv[1],"17-drum-step-expanded",screen);
            step_edit_toggle_details(); step_edit_toggle_details(); /* lanes, back to compact */
            step_edit_adjust_cursor(-1,1);
            bad|=shot(argv[1],"18-drum-region",screen);
            for(int k=0;k<3;k++) step_edit_adjust_note(1,1); /* All, BD, SD, CHH */
            bad|=shot(argv[1],"19-drum-region-filter",screen);
#ifdef RENDER_DUMP_TEXT
            for(int l=0;l<GUI_NUM_STATUS_LINES;l++) printf("%d|%s|\n",l,gstate.status_lines[l]);
#endif
            step_edit_set_enable(0);
            /* Lane overview: ghost hats, a Prb step and a delayed snare. */
            fx_events[5][3]=(struct track_event){SONG_EVENT_PROBABILITY,50,0,0,0};
            fx_events[6][0].data1=30;
            fx_events[12][0].delay=20;
            fx_start[0][0]=0; fx_len[0][0]=12;
            boot(screen); gui_track_overview_open(0); bad|=shot(argv[1],"20-drum-lanes-p1",screen);
            gui_overview_page(9); bad|=shot(argv[1],"21-drum-lanes-settings",screen);
            gui_clock_help_set(0);
            fx_recording=1; boot(screen); gui_track_overview_open(0);
            bad|=shot(argv[1],"22-drum-lanes-recording",screen);
            gui_clock_help_set(0); fx_recording=0;
            /* Step Edit lane view: cursor on step 5's lowest hit (kick). */
            boot(screen); step_edit_set_enable(1); step_edit_adjust_cursor(4,0);
            step_edit_toggle_details(); step_edit_toggle_details();
            bad|=shot(argv[1],"23-drum-lane-edit",screen);
            step_edit_toggle_details(); step_edit_set_enable(0);
            /* Euclidean 11 of 16: masked steps black, their hits dim. */
            fx_start[0][0]=0; fx_len[0][0]=16; fx_euc=1; fx_density=69; fx_rotation=0;
            boot(screen); gui_track_overview_open(0); bad|=shot(argv[1],"24-drum-lanes-masked",screen);
            gui_clock_help_set(0); fx_euc=0; fx_density=100;
            /* Lane Fill (changes the fixture; last drum image): kick +3, rotated once. */
            boot(screen); step_edit_set_enable(1); step_edit_adjust_cursor(4,0);
            step_edit_toggle_details(); step_edit_toggle_details();
            fx_writable=1;
            step_edit_adjust_ratchet_mode(3,1); step_edit_adjust_note(1,1);
            bad|=shot(argv[1],"25-drum-lane-fill",screen);
            fx_writable=0;
#ifdef RENDER_DUMP_TEXT
            for(int l=0;l<GUI_NUM_STATUS_LINES;l++) printf("%d|%s|\n",l,gstate.status_lines[l]);
#endif
            step_edit_toggle_details(); step_edit_set_enable(0);
            fx_drum_open=0;
            memcpy(fx_events,saved,sizeof(saved));
            fx_type[0]=t0; fx_start[0][0]=s0; fx_len[0][0]=l0;
        }
        boot(screen); gui_overview_open(PANEL_MENU_CLOCK); bad|=shot(argv[1],"04-clock-overview",screen);
        boot(screen); gui_track_overview_open(5); gui_overview_page(9); /* DRUM: Settings page */
        bad|=shot(argv[1],"05-track-overview",screen);
        boot(screen); gui_scene_overview_open(1); gui_overview_page(9); /* Settings page */
        bad|=shot(argv[1],"06-scene-overview",screen);
        boot(screen); gui_scene_overview_open(0); gui_overview_page(-9);
        bad|=shot(argv[1],"26-song-tracker",screen);
        boot(screen); gui_track_overview_open(0); gui_overview_page(-9);
        bad|=shot(argv[1],"27-track-tracker",screen);
        boot(screen); gui_overview_open(PANEL_MENU_SYS); bad|=shot(argv[1],"07-sys-overview",screen);
    }
    return bad;
}
