    for(int i=0;i<SEQ_TRACK_POLY;i++) if(fx_cell(step)[i].type==SONG_EVENT_NOTE) {
        p->pitch[p->count]=fx_cell(step)[i].data0; p->delay[p->count++]=0;
    }
}
