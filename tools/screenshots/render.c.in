/* Euclidean card: track 1 runs the PRODUCTION pattern.c mask with a real
 * density/rotation; other tracks keep their fixture patterns. */
static int fx_euc, fx_density=100, fx_rotation, fx_drum_open;
int seq_engine_get_effective_pattern_type(int t) { return 0; }
#define pattern_get_step_enable production_pattern_get_step_enable
#include "../../src/seq/pattern.c"
#undef pattern_get_step_enable
int pattern_get_step_enable(int scene,int track,int pattern,int step) {
    if(fx_euc && track==0) return production_pattern_get_step_enable(scene,track,pattern,step);
    if(fx_drum_open && track==0) return 1;  /* drum fixture: all steps play */
    return fx_hit(track,step);
}
