/* Pending take for the recording image: open hats played on the off-beats. */
int seq_engine_record_preview(int track,uint8_t *pitch,uint8_t *step,uint8_t *velocity,int max) {
    static const uint8_t st[4]={2,6,10,14};
    if(!fx_recording || track!=0) return 0;
    int n=0; for(int i=0;i<4 && n<max;i++) {pitch[n]=46;step[n]=st[i];velocity[n]=96;n++;}
    return n;
}
