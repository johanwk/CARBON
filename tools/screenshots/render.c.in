/*
 * Host screenshot renderer for documentation.
 *
 * Production gfx.c, ROM fonts, gui.c, panel_menu.c and step_edit.c draw into
 * a host RGB565 framebuffer instead of the ILI948x LCD. Sequencer/song state
 * comes from the PREPARED FIXTURE below, not from a device. Images are
 * therefore pixel renderings of example states, not captures of hardware.
 *
 * Usage: render OUTDIR [a|b|both]   (default a: original 3.95" panel)
 */
#define GUI_STATE_SECTION
#include <stdarg.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include "../../src/gfx.c"
#include "../../src/gui/gui.c"
#include "../../src/gui/panel_menu.c"
#include "../../src/gui/step_edit.c"

/* ---------- host LCD: RGB565 framebuffer ---------- */
static uint16_t fb[LCD_H][LCD_W];
static int win_x, win_y, win_w, win_h, win_pos;
void ILI948x_drv_init(void) {}
void ILI948x_drv_init_LCD(void) {}
void ILI948x_drv_deinit_LCD(void) {}
void ILI948x_drv_clear(uint16_t c) { for(int y=0;y<LCD_H;y++) for(int x=0;x<LCD_W;x++) fb[y][x]=c; }
void ILI948x_drv_set_xy(int x,int y,int w,int h) { win_x=x;win_y=y;win_w=w;win_h=h;win_pos=0; }
void ILI948x_drv_send_pixels(uint16_t *p,int len) {
    for(int i=0;i<len;i++,win_pos++) {
        int x=win_x+win_pos%win_w, y=win_y+win_pos/win_w;
        if(x>=0 && x<LCD_W && y>=0 && y<LCD_H) fb[y][x]=p[i];
    }
}

/* ---------- PNG writer (stored deflate, no dependencies) ---------- */
static uint32_t crc_table[256];
static void crc_init(void) {
    for(uint32_t n=0;n<256;n++) { uint32_t c=n; for(int k=0;k<8;k++) c=c&1?0xedb88320u^(c>>1):c>>1; crc_table[n]=c; }
}
static uint32_t crc_upd(uint32_t c,const uint8_t *b,size_t n) { while(n--) c=crc_table[(c^*b++)&255]^(c>>8); return c; }
static void be32(FILE *f,uint32_t v) { uint8_t b[4]={v>>24,v>>16,v>>8,v}; fwrite(b,1,4,f); }
static void chunk(FILE *f,const char *t,const uint8_t *d,uint32_t n) {
    be32(f,n); fwrite(t,1,4,f); if(n) fwrite(d,1,n,f);
    uint32_t c=crc_upd(0xffffffffu,(const uint8_t *)t,4); c=crc_upd(c,d,n); be32(f,c^0xffffffffu);
}
static int write_png(const char *path) {
    size_t raw_n=(size_t)LCD_H*(1+LCD_W*3);
    uint8_t *raw=malloc(raw_n), *z=malloc(raw_n+raw_n/65535*5+16);
    size_t r=0;
    for(int y=0;y<LCD_H;y++) {
        raw[r++]=0;
        for(int x=0;x<LCD_W;x++) {
            uint16_t c=fb[y][x];
            unsigned R=(c>>11)&31, G=(c>>5)&63, B=c&31;
            raw[r++]=(R<<3)|(R>>2); raw[r++]=(G<<2)|(G>>4); raw[r++]=(B<<3)|(B>>2);
        }
    }
    size_t zn=0; uint32_t a=1,b=0;
    z[zn++]=0x78; z[zn++]=0x01;
    for(size_t off=0;off<raw_n;) {
        size_t len=raw_n-off>65535?65535:raw_n-off;
        z[zn++]=off+len==raw_n; z[zn++]=len&255; z[zn++]=len>>8; z[zn++]=~len&255; z[zn++]=(~len>>8)&255;
        memcpy(z+zn,raw+off,len); zn+=len; off+=len;
    }
    for(size_t i=0;i<raw_n;i++) { a=(a+raw[i])%65521; b=(b+a)%65521; }
    z[zn++]=b>>8; z[zn++]=b; z[zn++]=a>>8; z[zn++]=a;
    FILE *f=fopen(path,"wb"); if(!f) {free(raw);free(z);return -1;}
    static const uint8_t sig[8]={137,80,78,71,13,10,26,10}; fwrite(sig,1,8,f);
    uint8_t ihdr[13]={0,0,LCD_W>>8,LCD_W&255,0,0,LCD_H>>8,LCD_H&255,8,2,0,0,0};
    chunk(f,"IHDR",ihdr,13); chunk(f,"IDAT",z,(uint32_t)zn); chunk(f,"IEND",NULL,0);
    fclose(f); free(raw); free(z); return 0;
}

/* ---------- prepared fixture state (example, not device data) ---------- */
static int fx_scene, fx_first, fx_screen, fx_selected[6]={1,0,0,0,0,0};
static int fx_start[6][6], fx_len[6][6], fx_rate[6][6], fx_mute[6][6], fx_bias[6][6], fx_scale[6][6];
static int fx_type[6]={0,0,0,0,1,1}, fx_scene_root[6]={-2,-2,7,-2,2,-2};
static struct track_event fx_events[64][SEQ_TRACK_POLY];
static int fx_ratchet[64], fx_delay[64];
/* Euclidean-style hits: k of n, with n not dividing the 8-step grid row, so
 * rows differ. Rotation is chosen so step 5 (index 4, the edited chord) hits. */
static const int fx_k[6]={5,3,7,4,2,5}, fx_n[6]={13,10,12,11,7,9};
static int fx_rot[6];
static int fx_hit(int track,int step) {
    return ((step+fx_rot[track])*fx_k[track])%fx_n[track] < fx_k[track];
}
static void fx_rotations(void) {
    for(int t=0;t<6;t++) for(fx_rot[t]=0;fx_rot[t]<fx_n[t] && !fx_hit(t,4);fx_rot[t]++);
}
/* Optional replacement contents for step 1 (index 0), for event cards. */
static struct track_event *fx_ov;
static struct track_event *fx_cell(int step) { return fx_ov && step == 0 ? fx_ov : fx_events[step]; }
static void fixture_init(void) {
    fx_rotations();
    for(int s=0;s<6;s++) for(int t=0;t<6;t++) {
        fx_start[s][t]=(s*8+t*4)%64; fx_len[s][t]=t==5&&s==1?16:16+8*(t%3);
        fx_rate[s][t]=t==3?SEQ_UTILS_STEP_8TH:SEQ_UTILS_STEP_16TH;
        fx_mute[s][t]=(s+t)%5==4; fx_bias[s][t]=t==2?0:-1; fx_scale[s][t]=(s+t)%4;
    }
    fx_start[1][5]=56; /* wrapped window 57~08 */
    /* Step-wide defaults: ratchet 1 (range 1-8), shared delay Off. */
    for(int i=0;i<64;i++) { fx_delay[i]=0; fx_ratchet[i]=1; }
    static const int melody[8]={48,55,51,60,53,58,56,63};
    for(int i=0;i<64;i++) if(fx_hit(0,i)) {
        fx_events[i][0]=(struct track_event){SONG_EVENT_NOTE,melody[(i/2)%8],100,0,48};
        fx_events[i][0].delay=SEQ_START_DELAY_INHERIT;
    }
    struct track_event *e=fx_events[4];
    e[0]=(struct track_event){SONG_EVENT_NOTE,60,96,SEQ_START_DELAY_INHERIT,24};
    e[1]=(struct track_event){SONG_EVENT_NOTE,64,88,SEQ_START_DELAY_INHERIT,24};
    e[2]=(struct track_event){SONG_EVENT_NOTE,67,92,0,48};
    e[3]=(struct track_event){SONG_EVENT_PROBABILITY,75,0,0,0};
    fx_ratchet[4]=2; fx_delay[4]=0;
    /* Step 12 (index 11, a track-1 hit): anatomy example N, Prb, N, N. */
    struct track_event *a=fx_events[11];
    memset(fx_events[11],0,sizeof(fx_events[11]));
    a[0]=(struct track_event){SONG_EVENT_NOTE,60,96,SEQ_START_DELAY_INHERIT,24};
    a[1]=(struct track_event){SONG_EVENT_PROBABILITY,50,0,0,0};
    a[2]=(struct track_event){SONG_EVENT_NOTE,64,90,SEQ_START_DELAY_INHERIT,24};
    a[3]=(struct track_event){SONG_EVENT_NOTE,67,84,SEQ_START_DELAY_INHERIT,24};
    fx_ratchet[11]=1; fx_delay[11]=0;
    /* Step 3 (index 2): card example Prb 50% then a note. */
    memset(fx_events[2],0,sizeof(fx_events[2]));
    fx_events[2][0]=(struct track_event){SONG_EVENT_PROBABILITY,50,0,0,0};
    fx_events[2][1]=(struct track_event){SONG_EVENT_NOTE,72,100,SEQ_START_DELAY_INHERIT,24};
    /* Step 8 (index 7): card example Euc 3:8 then a note. */
    memset(fx_events[7],0,sizeof(fx_events[7]));
    { unsigned a,b; int i; for(i=0;i<28;i++){conditional_pair(i,&a,&b); if(a==3&&b==8) break;}
      fx_events[7][0]=(struct track_event){SONG_EVENT_EUCLIDEAN,(uint8_t)i,0,0,0}; }
    fx_events[7][1]=(struct track_event){SONG_EVENT_NOTE,67,100,SEQ_START_DELAY_INHERIT,24};
}

